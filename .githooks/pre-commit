#!/bin/sh
set -e

# Blocked patterns for repo hygiene
BLOCKED_PATTERNS="\.apk$|\.aab$|\.jks$|\.keystore$|\.pem$|\.p12$|^builds/|^android/app/build/|^android/build/|^ios/build/"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    if echo "$file" | grep -Ei "$BLOCKED_PATTERNS" > /dev/null; then
        echo "ERROR: Build/binary artifact staged: $file"
        echo "Please remove it from staging before committing:"
        echo "  git restore --staged $file"
        exit 1
    fi
done

exit 0
