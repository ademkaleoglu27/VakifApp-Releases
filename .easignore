# --- EAS upload size reduction (HARD v2) ---

# Git history (NEVER needed for EAS build upload)
.git/**

# Dependencies (EAS installs on server)
node_modules/**

# Web admin (not needed for Android APK)
web-admin/**
tools/risale_source_data/**
temp_risale_source/**

# Legacy / experiments
_legacy_archive/**
test-export*/**
test-export-*/**

# Large local content packs / generated assets (downloaded at runtime)
assets/quran_pages/**
quran-pack/**

# Android build outputs / caches
android/.gradle/**
android/.cxx/**
android/app/.cxx/**
android/app/build/**
android/build/**
**/build/**

# Expo caches / logs
.expo/**
.expo-shared/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.hprof

# Large stray artifacts
kuran_v2_lite.pdf*
