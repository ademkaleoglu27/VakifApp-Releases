64f\u0641\u0652\u0631\u064e\u0627\u0646\u064f",latin:"Y\xe2 Gufran",meal:"Ey ba\u011f\u0131\u015flamas\u0131 bol olan \u011eufr\xe2n,"},{arabic:"\u064a\u064e\u0627 \u0628\u064f\u0631\u0652\u0647\u064e\u0627\u0646\u064f",latin:"Y\xe2 Burhan",meal:"Ey kullar\u0131na yol g\xf6steren Burh\xe2n,"},{arabic:"\u064a\u064e\u0627 \u0633\u064f\u0644\u0652\u0637\u064e\u0627\u0646\u064f",latin:"Y\xe2 Sult\xe2n",meal:"Ey ger\xe7ek saltanat sahibi Sult\xe2n,"},{arabic:"\u064a\u064e\u0627 \u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064f",latin:"Y\xe2 Subh\xe2n",meal:"Ey b\xfct\xfcn kusur ve noksanlardan uzak olan S\xfcbh\xe2n,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0633\u0652\u062a\u064e\u0639\u064e\u0627\u0646\u064f",latin:"Y\xe2 Muste'\xe2n",meal:"Ey kendinden yard\u0131m istenen M\xfcste\xe2n,"},{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0645\u064e\u0646\u0650\u0651 \u0648\u064e \u0627\u0644\u0652\u0628\u064e\u064a\u064e\u0627\u0646\u0650",latin:"Y\xe2 Ze'l-menni ve'l-bey\xe2n",meal:"Ey n\xeemet ve bey\xe2n sahibi,"},{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u0650",latin:"Y\xe2 Ze'l-em\xe2ne",meal:"Ey emniyet ve em\xe2n sahibi,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0650\u0651\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente'l-em\xe2-ne'l-em\xe2ne hallisn\xe2 mine'n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok. Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:6,title:"Azamet ve Kudret",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u0648\u064e\u0627\u0636\u064e\u0639\u064e \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0644\u0650\u0639\u064e\u0638\u064e\u0645\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men tev\xe2da'a k\xfcll\xfc \u015fey'in li'azametih",meal:"Ey azametine her \u015feyin boyun e\u011fdi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0633\u0652\u062a\u064e\u0633\u0652\u0644\u064e\u0645\u064e \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0644\u0650\u0642\u064f\u062f\u0652\u0631\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Meni'stesleme k\xfcll\xfc \u015fey'in likudratih",meal:"Ey kudretine her \u015feyin teslim oldu\u011fu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0630\u064e\u0644\u064e\u0651 \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0644\u0650\u0639\u0650\u0632\u064e\u0651\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men zelle k\xfcll\xfc \u015fey'in li'izzetih",meal:"Ey izzetine kar\u015f\u0131 her \u015feyin zel\xeel oldu\u011fu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062e\u064e\u0636\u064e\u0639\u064e \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0644\u0650\u0647\u064e\u064a\u0652\u0628\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men hada'a k\xfcll\xfc \u015fey'in liheybetih",meal:"Ey heybetine her \u015feyin itaat etti\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0646\u0652\u0642\u064e\u0627\u062f\u064e \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0644\u0650\u0645\u064f\u0644\u0652\u0643\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Meni'nk\xe2de k\xfcll\xfc \u015fey'in lim\xfclketih",meal:"Ey saltanat\u0131na kar\u015f\u0131 her \u015feyin ink\u0131yat etti\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062f\u064e\u0627\u0646\u064e \u0643\u064f\u0644\u064f\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0645\u0650\u0646\u0652 \u0645\u064e\u062e\u064e\u0627\u0641\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men d\xe2ne k\xfcll\xfc \u015fey'in min meh\xe2fetih",meal:"Ey korkusundan her \u015feyin kendisine boyun e\u011fdi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0646\u0652\u0634\u064e\u0642\u064e\u0651\u062a\u0650 \u0627\u0644\u0652\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0645\u0650\u0646\u0652 \u062e\u064e\u0634\u0652\u064a\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Meni'n\u015fakkati'l-cib\xe2l\xfc min ha\u015fyetin",meal:"Ey korkusundan da\u011flar\u0131n yar\u0131ld\u0131\u011f\u0131 ve par\xe7aland\u0131\u011f\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0642\u064e\u0627\u0645\u064e\u062a\u0650 \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u064f \u0628\u0650\u0627\u064e\u0645\u0652\u0631\u0650\u0647\u0650",latin:"Y\xe2 Men k\xe2meti's-sem\xe2v\xe2t\xfc bi emrih",meal:"Ey emriyle g\xf6klerin ayakta durdu\u011fu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0633\u0652\u062a\u064e\u0642\u064e\u0631\u064e\u0651\u062a\u0650 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064f \u0628\u0650\u0627\u0650\u0630\u0652\u0646\u0650\u0647\u0650",latin:"Y\xe2 Meni'stekarrati'l-ardu bi iznih",meal:"Ey izniyle yerin karar k\u0131ld\u0131\u011f\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u062a\u064e\u062f\u0650\u0649 \u0639\u064e\u0644\u0649\u0670\u0653 \u0627\u064e\u0647\u0652\u0644\u0650 \u0645\u064e\u0645\u0652\u0644\u064e\u0643\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men l\xe2 y\xe2'ted\xee 'al\xe2 ehli memleketih",meal:"Ey memleketinin ah\xe2lisine zulmetmeyen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u06