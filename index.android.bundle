64e\u0628\u0650\u064a\u0644\u064f\u0647\u064f \u0648\u064e\u0627\u0636\u0650\u062d\u064c \u0644\u0650\u0644\u0652\u0645\u064f\u0648\u0654\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve sebil\xfch\xfb v\xe2dihun li\u2019l-m\xfc\u2019min\xeen",meal:"Ey yolu m\xfcminlere z\xe2hir ve belli olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0627\u0670\u064a\u064e\u0627\u062a\u064f\u0647\u064f \u0628\u064f\u0631\u0652\u0647\u064e\u0627\u0646\u064c \u0644\u0650\u0644\u0646\u0651\u064e\u0627\u0638\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve \xe2y\xe2t\xfch\xfb b\xfcrh\xe2n\xfcn Ii\u2019n-n\xe2zir\xeen",meal:"Ey \xe2yetleri bakanlar i\xe7in kesin delil olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0643\u0650\u062a\u064e\u0627\u0628\u064f\u0647\u064f \u062a\u064e\u0630\u0652\u0643\u0650\u0631\u064e\u0629\u064c \u0644\u0650\u0644\u0652\u0645\u064f\u0648\u0642\u0650\u0646\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve kit\xe2b\xfch\xfb tezkirat\xfcn li\u2019l-m\xfbk\u0131n\xeen",meal:"Ey kitab\u0131 kuvvetli \xeeman sahipleri i\xe7in \xf6\u011f\xfct olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0639\u064e\u0641\u0652\u0648\u064f\u0647\u064f \u0645\u064e\u0644\u0652\u062c\u064e\u0627\u0654\u064c \u0644\u0650\u0644\u0652\u0645\u064f\u0630\u0652\u0646\u0650\u0628\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve \u2018afv\xfch\xfc melce\xfcn li\u2019l-m\xfcznib\xeen",meal:"Ey aff\u0131 g\xfcnahkarlar i\xe7in s\u0131\u011f\u0131nak olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0631\u064e\u062d\u0652\u0645\u064e\u062a\u064f\u0647\u064f \u0642\u064e\u0631\u0650\u064a\u0628\u064c \u0644\u0650\u0644\u0652\u0645\u064f\u062d\u0652\u0633\u0650\u0646\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve rahmet\xfch\xfb kar\xeeb\xfbn li\u2019l-muhsin\xeen",meal:"Ey rahmeti muhsinler i\xe7in yak\u0131n olan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:75,title:"Men teb\xe2reke\u2019sm\xfch",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u0643\u064e \u0627\u0633\u0652\u0645\u064f\u0647\u064f",latin:"Y\xe2 Men teb\xe2reke\u2019sm\xfch",meal:"Ey ismi y\xfcce ve m\xfcbarek olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u062c\u064e\u062f\u0651\u064f\u0647\u064f",latin:"Y\xe2 Men te\u2019\xe2l\xe2 cedd\xfch",meal:"Ey \u015fan ve makam\u0131 y\xfcksek olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0644\u0651\u064e \u062b\u064e\u0646\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Men celle sen\xe2\xfch",meal:"Ey sen\xe2 ve \xf6vg\xfcs\xfc b\xfcy\xfck olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u063a\u064e\u064a\u0652\u0631\u064f\u0647\u064f",latin:"Y\xe2 Men l\xe2 ilahe \u011fayruh",meal:"Ey kendisinden ba\u015fka il\xe2h olmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0633\u064e\u062a\u0652 \u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Men tekaddeset esm\xe2\xfch",meal:"Ey isimleri mukaddes olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u062f\u064f\u0648\u0645\u064f \u0628\u064e\u0642\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Men yed\xfbm\xfc bek\xe2\xfch",meal:"Ey bek\xe2s\u0131 devam eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0644\u0652\u0639\u064e\u0638\u064e\u0645\u064e\u0629\u064f \u0628\u064e\u0647\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Meni\u2019l-\u2018azamet\xfc beh\xe2\xfch",meal:"Ey azameti, bah\xe2 ve kadri olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0650 \u0627\u0644\u0652\u0643\u0650\u0628\u0652\u0631\u0650\u064a\u064e\u0653\u0627\u0621\u064f \u0631\u0650\u062f\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Meni\u2019l-kibriy\xe2\xfc rid\xe2\xfch",meal:"Ey b\xfcy\xfckl\xfck perdesi olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062d\u0652\u0635\u0670\u0649 \u0627\u0670\u0644\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Men l\xe2 yuhs\xe2 \xe2l\xe2\xfch",meal:"Ey gizli nimetleri grup grup bile say\u0131lamayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0639\u064e\u062f\u0651\u064f \u0646\u064e\u0639\u0652\u0645\u064e\u0653\u0627\u0648\u0654\u064f\u0647\u064f",latin:"Y\xe2 Men l\xe2 yu\u2019add\xfc na\u2019m\xe2\xfch",meal:"Ey ihsan ve nimeti hesap ve say\u0131ya gelmeyen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:76,title:"Mu\u2019\xeen ve Mub\xeen",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0639\u0650\u064a\u0646\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Mu\u2019\xeen",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey kullar\u0131na yard\u0131m eden Mu\xeen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0628\u0650\u064a\u0646\u064f",latin:"Y\xe2 Mub\xeen",meal:"Ey a\xe7\u0131klanmas\u0131 gereken her \u015feyi beyan eden M\xfcb\xeen,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u0650\u064a\u0646\u064f",latin:"Y\xe2 Em\xeen",meal:"Ey kullar\u0131na emniyet ve huzur veren Em\xeen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0643\u0650\u064a\u0646\u064f",latin:"Y\xe2 Mek\xeen",meal:"Ey saltanat\u0131 muhkem, n\xfcfuz ve iktidar sahibi Mek\xeen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u062a\u0650\u064a\u0646\u064f",latin:"Y\xe2 Met\xeen",meal:"Ey hi\xe7bir \u015fey h\xfckm\xfcn\xfc sarsmayan ve Kendisine g\xfcvenilen Met\xeen,"},{arabic:"\u064a\u064e\u0627 \u0634\u064e\u062f\u0650\u064a\u062f\u064f",latin:"Y\xe2 \u015eed\xeed",meal:"Ey azap ve ik\xe2b\u0131 \u015fiddetli olan \u015eed\xeed,"},{arabic:"\u064a\u064e\u0627 \u0634\u064e\u0647\u0650\u064a\u062f\u064f",latin:"Y\xe2 \u015eeh\xeed",meal:"Ey kullar\u0131n\u0131n her yapt\u0131\u011f\u0131n\u0131 g\xf6ren \u015eeh\xeed,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0634\u0650\u064a\u062f\u064f",latin:"Y\xe2 Ra\u015f\xeed",meal:"Ey b\xfct\xfcn i\u015flerini ezel\xee takdirine g\xf6re en g\xfczel bir \u015fekilde neticeye ula\u015ft\u0131ran Ra\u015f\xeed,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u062f\u064f",latin:"Y\xe2 Ham\xeed",meal:"Ey en \xe7ok \xf6v\xfclen ve en \xe7ok \xf6vg\xfcye lay\u0131k olan Ham\xeed,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u062c\u0650\u064a\u062f\u064f",latin:"Y\xe2 Mec\xeed",meal:"Ey sonsuz \u015feref sahibi Mec\xeed,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:77,title:"Ze\u2019l-ar\u015fi\u2019l-mec\xeed",lines:[{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0639\u064e\u0631\u0652\u0634\u0650 \u0627\u0644\u0652\u0645\u064e\u062c\u0650\u064a\u062f\u0650",latin:"Y\xe2 Ze\u2019l-ar\u015fi\u2019l-mec\xeed",meal:"Ey y\xfcce Ar\u015f\u0131n sahibi,"},{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0642\u064e\u0648\u0652\u0644\u0650 \u0627\u0644\u0633\u0651\u064e\u062f\u0650\u064a\u062f\u0650",latin:"Y\xe2 Ze\u2019l-kavli\u2019s-sed\xeed",meal:"Ey dosdo\u011fru s\xf6z\xfcn sahibi,"},{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0641\u064e\u0636\u0652\u0644\u0650 \u0627\u0644\u0631\u0651\u064e\u0634\u0650\u064a\u062f\u0650",latin:"Y\xe2 Ze\u2019l-fadli\u2019r-ra\u015f\xeed",meal:"Ey yerli yerince yap\u0131lan faz\u0131l ve kerem sahibi,"},{arabic:"\u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u0