e\u0646\u0652 \u0644\u064e\u0647\u064f \u062c\u064e\u0644\u064e\u0627\u0644\u064c \u0644\u064e\u0627 \u064a\u064f\u0643\u064e\u064a\u0651\u064e\u0641\u064f",latin:"Y\xe2 Men leh\xfb cel\xe2l\xfcn l\xe2 yukeyyef",meal:"Ey ger\xe7ek keyfiyeti anla\u015f\u0131lamayan cel\xe2l sahibi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0647\u064f \u0642\u064e\u0636\u064e\u0653\u0627\u0621\u064c \u0644\u064e\u0627 \u064a\u064f\u0631\u064e\u062f\u0651\u064f",latin:"Y\xe2 Men leh\xfb kad\xe2\xfcn l\xe2 yuradd",meal:"Ey reddedilemeyen h\xfck\xfcm sahibi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0647\u064f \u0635\u0650\u0641\u064e\u0627\u062a\u064c \u0644\u064e\u0627 \u062a\u064f\u0628\u064e\u062f\u0651\u064e\u0644\u064f",latin:"Y\xe2 Men leh\xfb s\u0131f\xe2t\xfcn l\xe2 t\xfcbeddel",meal:"Ey tebdil edilemeyen s\u0131fatlar sahibi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0647\u064f \u0643\u064e\u0645\u064e\u0627\u0644\u064c \u0644\u064e\u0627 \u064a\u064f\u062f\u0652\u0631\u064e\u0643\u064f",latin:"Y\xe2 Men leh\xfb kem\xe2l\xfcn l\xe2 yudrak",meal:"Ey tam idrak edilemeyen kem\xe2l sahibi,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:71,title:"Rabbe\u2019l-\u2018\xe2lem\xeen",lines:[{arabic:"\u064a\u064e\u0627 \u0631\u