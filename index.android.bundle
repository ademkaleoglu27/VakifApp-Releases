z-z\xfcn\xfbbe ill\xe2 h\xfb",meal:"Ey g\xfcnahlar\u0131 Kendisinden ba\u015fka kimse ma\u011ffiret edemeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0642\u064e\u0644\u0651\u0650\u0628\u064f \u0627\u0644\u0652\u0642\u064e\u0644\u0652\u0628\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yukallib\xfc\u2019l-kalbe ill\xe2 h\xfb",meal:"Ey kalpleri Kendisinden ba\u015fkas\u0131 de\u011fi\u015ftiremeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u062e\u0652\u0644\u064f\u0642\u064f \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yahl\xfcku\u2019l-halka ill\xe2 h\xfb",meal:"Ey mahl\xfbkat\u0131 Kendisinden ba\u015fkas\u0131 yaratamayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062a\u0650\u0645\u0651\u064f \u0627\u0644\u0646\u0651\u0650\u0639\u0652\u0645\u064e\u0629\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yutimm\xfc\u2019n-ni\u2019mete ill\xe2 h\xfb",meal:"Ey n\xeemetleri Kendisinden ba\u015fkas\u0131 tamamlayamayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0646\u064e\u0632\u0651\u0650\u0644\u064f \u0627\u0644\u0652\u063a\u064e\u064a\u0652\u062b\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yunezzil\xfc\u2019l-\u011fay\u015fe ill\xe2 h\xfb",meal:"Ey ya\u011fmuru Kendisinden ba\u015fkas\u0131 ya\u011fd\u0131ramayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062d\u0652\u064a\u0650\u0649 \u0627\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u0670\u0649 \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yuhyi\u2019l-mevt\xe2 ill\xe2 h\xfb",meal:"Ey \xf6l\xfcleri kendisinden ba\u015fkas\u0131 diriltemeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u063a\u0652\u0646\u0650\u0649 \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u062a\u0651\u064e\u062d\u0652\u0642\u0650\u064a\u0642\u0650 \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 yu\u011fni \u2018ale\u2019t-tahk\xeeki ill\xe2 h\xfb",meal:"Ey kullar\u0131n\u0131 kendisinden ba\u015fkas\u0131 ger\xe7ek zengin k\u0131lamayan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:91,title:"K\xe2\u015fif ve F\xe2ric",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0643\u064e\u0627\u0634\u0650\u0641\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 K\xe2\u015fif",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey bel\xe2lar\u0131 kald\u0131ran ve g\xfczellikleri a\xe7\u0131\u011fa \xe7\u0131karan K\xe2\u015fif,"},{arabic:"\u064a\u064e\u0627 \u0641\u064e\u0627\u0631\u0650\u062c\u064f",latin:"Y\xe2 F\xe2ric",meal:"Ey keder ve tasadan kurtar\u0131p ferahlatan F\xe2ric,"},{arabic:"\u064a\u064e\u0627 \u0641\u064e\u0627\u062a\u0650\u062d\u064f",latin:"Y\xe2 F\xe2tih",meal:"Ey her mevcuda m\xfcn\xe2sip bir s\xfbret a\xe7an ve fetihler m\xfcyesser k\u0131lan F\xe2tih,"},{arabic:"\u064a\u064e\u0627 \u0646\u064e\u0627\u0635\u0650\u0631\u064f",latin:"Y\xe2 N\xe2sir",meal:"Ey kullar\u0131na yard\u0131m eden N\xe2s\u0131r,"},{arabic:"\u064a\u064e\u0627 \u0636\u064e\u0627\u0645\u0650\u0646\u064f",latin:"Y\xe2 D\xe2min",meal:"Ey yarat\u0131klar\u0131n her t\xfcrl\xfc ihtiyac\u0131n\u0131 \xfczerine alan D\xe2min,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u0670\u0645\u0650\u0631\u064f",latin:"Y\xe2 \xc2mir",meal:"Ey her \u015feye f\u0131trat\u0131n\u0131n gayesini emreden \xc2mir,"},{arabic:"\u064a\u064e\u0627 \u0646\u064e\u0627\u0647\u0650\u0649",latin:"Y\xe2 N\xe2h\xee",meal:"Ey her t\xfcrl\xfc k\xf6t\xfcl\xfckten sak\u0131nd\u0131ran N\xe2h\xee,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u062c\u064e\u0627",latin:"Y\xe2 Rac\xe2",meal:"Ey kullar\u0131n\u0131n \xfcmidi olan Rec\xe2,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0631\u0652\u062a\u064e\u062c\u064e\u0627",latin:"Y\xe2 Murtec\xe2",meal:"Ey kullar\u0131n\u0131n \xfcmit besledi\u011fi M\xfcrtec\xe2,"},{arabic:"\u064a\u064e\u0627 \u0639\u064e\u0638\u0650\u064a\u0645\u064e \u0627\u0644\u0631\u0651\u064e\u062c\u064e\u0627",latin:"Y\xe2 \u2018Az\xeeme\u2019r-rac\xe2",meal:"Ey kendisine b\xfcy\xfck \xfcmitler beslenen Az\xeem\xfcr-Rec\xe2,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\