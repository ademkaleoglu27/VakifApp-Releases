__d(function(e,a,i,n,l,r,m){l.exports={title:"Cev\u015fen\xfc'l-Kebir",babs:[{id:1,title:"Esm\xe2-i \u0130l\xe2hiye",lines:[{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u0650\u0646\u0650\u0651\u0653\u0649 \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e",latin:"All\xe2h\xfcmme inn\xee es'el\xfcke biesm\xe2ike",meal:"Allah'\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:"},{arabic:"\u064a\u064e\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f",latin:"Ya Allah",meal:"Ey her \u015feyin ger\xe7ek M\xe2budu olan Allah,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f",latin:"Ya Rahman",meal:"Ey ay\u0131rt etmeden b\xfct\xfcn mahl\xfbkat\u0131 r\u0131z\u0131kland\u0131ran Rahman,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u062d\u0650\u064a\u0645\u064f",latin:"Ya Rah\xeem",meal:"Ey itaatkar kullar\u0131na hususi rahmet eden Rah\xeem,"},{arabic:"\u064a\u064e\u0627 \u0639\u064e\u0644\u0650\u064a\u0645\u064f",latin:"Ya Al\xeem",meal:"Ey her \u015feyi bilen Al\xeem,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0644\u0650\u064a\u0645\u064f",latin:"Ya Hal\xeem",meal:"Ey yumu\u015fak muamele eden Hal\xeem,"},{arabic:"\u064a\u064e\u0627 \u0639\u064e\u0638\u0650\u064a\u0645\u064f",latin:"Ya Az\xeem",meal:"Ey sonsuz b\xfcy\xfckl\xfck ve y\xfccelik sahibi olan Az\xeem,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0643\u0650\u064a\u0645\u064f",latin:"Ya Hak\xeem",meal:"Ey her \u015feyi hikmetle yaratan Hak\xeem,"},{arabic:"\u064a\u064e\u0627 \u0642\u064e\u062f\u0650\u064a\u0645\u064f",latin:"Ya Kad\xeem",meal:"Ey varl\u0131\u011f\u0131n\u0131n ba\u015flang\u0131c\u0131 olmayan Kad\xeem,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0642\u0650\u064a\u0645\u064f",latin:"Ya Muk\xeem",meal:"Ey her \u015feyi ayakta tutan Muk\xeem,"},{arabic:"\u064a\u064e\u0627 \u0643\u064e\u0631\u0650\u064a\u0645\u064f",latin:"Ya Ker\xeem",meal:"Ey iyilik ve ikram\u0131 bol olan Ker\xeem,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0650\u0651\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente'l-em\xe2-ne'l-em\xe2ne hallisn\xe2 mine'n-nar.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok. Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:2,title:"Seyyid\xfc's-S\xe2d\xe2t",lines:[{arabic:"\u064a\u064e\u0627 \u0633\u064e\u064a\u0650\u0651\u062f\u064e \u0627\u0644\u0633\u064e\u0651\u0627\u062f\u064e\u0627\u062a\u0650",latin:"Y\xe2 Seyyide's-s\xe2d\xe2t",meal:"Ey efendilerin efendisi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u062c\u0650\u064a\u0628\u064e \u0627\u0644\u062f\u064e\u0651\u0639\u064e\u0648\u064e\u0627\u062a\u0650",latin:"Y\xe2 Muc\xeebe'd-de'av\xe2t",meal:"Ey dualara cevap veren,"},{arabic:"\u064a\u064e\u0627 \u0648\u064e\u0644\u0650\u0649\u064e\u0651 \u0627\u0644\u0652\u062d\u064e\u0633\u064e\u0646\u064e\u0627\u062a\u0650",latin:"Y\xe2 Veliyye'l-hasen\xe2t",meal:"Ey iyiliklerin sahibi,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0641\u0650\u064a\u0639\u064e \u0627\u0644\u062f\u064e\u0651\u0631\u064e\u062c\u064e\u0627\u062a\u0650",latin:"Y\xe2 Ref\u0131a'd-derac\xe2t",meal:"Ey dereceleri y\xfckselten,"},{arabic:"\u064a\u064e\u0627 \u0639\u064e\u0638\u0650\u064a\u0645\u064e \u0627\u0644\u0652\u0628\u064e\u0631\u064e\u0643\u064e\u0627\u062a\u0650",latin:"Y\xe2 Az\xeeme'l-berak\xe2t",meal:"Ey bereketleri b\xfcy\xfck olan,"},{arabic:"\u064a\u064e\u0627 \u063a\u064e\u0627\u0641\u0650\u0631\u064e \u0627\u0644\u0652\u062e\u064e\u0637\u0650\u064a\u0626\u064e\u0627\u062a\u0650",latin:"Y\xe2 \u011eaf\u0131ra'l-hat\xee\xe2t",meal:"Ey hatalar\u0131 ba\u011f\u0131\u015flayan,"},{arabic:"\u064a\u064e\u0627 \u062f\u064e\u0627\u0641\u0650\u0639\u064e \u0627\u0644\u0652\u0628\u064e\u0644\u0650\u064a\u064e\u0651\u0627\u062a\u0650",latin:"Y\xe2 D\xe2f\xee'a'l-beliyy\xe2t",meal:"Ey belalar\u0131 def eden,"},{arabic:"\u064a\u064e\u0627 \u0633\u064e\u0627\u0645\u0650\u0639\u064e \u0627\u0644\u0652\u0627\u064e\u0635\u0652\u0648\u064e\u0627\u062a\u0650",latin:"Y\xe2 S\xe2mi'a'l-esv\xe2t",meal:"Ey sesleri i\u015fiten,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0639\u0652\u0637\u0650\u0649\u064e \u0627\u0644\u0652\u0645\u064e\u0633\u0652\u0626\u0648\u064f\u0644\u064e\u0627\u062a\u0650",latin:"Y\xe2 Mu't\u0131ye'l-mes\xfbl\xe2t",meal:"Ey dilekleri veren,"},{arabic:"\u064a\u064e\u0627 \u0639\u064e\u0627\u0644\u0650\u0645\u064e \u0627\u0644\u0633\u0650\u0651\u0631\u0650\u0651 \u0648\u064e \u0627\u0644\u0652\u062e\u064e\u0641\u0650\u064a\u064e\u0651\u0627\u062a\u0650",latin:"Y\xe2 'Alime's-sirri ve'l-hafiyy\xe2t",meal:"Ey s\u0131r ve gizlilikleri bilen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0650\u0651\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente'l-em\xe2-ne'l-em\xe2ne hallisn\xe2 mine'n-nar.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok. Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:3,title:"Hayru'l-G\xe2fir\xeen",lines:[{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0652\u063a\u064e\u0627\u0641\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Ya Hayra'l-\u011f\xe2fir\xeen",meal:"Ey ba\u011f\u0131\u015flayanlar\u0131n en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0635\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Ya Hayra'n-n\xe2s\u0131r\xeen",meal:"Ey yard\u0131m edenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0652\u062d\u064e\u0627\u0643\u0650\u0645\u0650\u064a\u0646\u064e",latin:"Ya Hayra'l-h\xe2kim\xeen",meal:"Ey h\xfckmedenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0652\u0641\u064e\u0627\u062a\u0650\u062d\u0650\u064a\u0646\u064e",latin:"Ya Hayra'l-fatih\xeen",meal:"Ey her \u015feyi a\xe7an ve fethedenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0630\u064e\u0651\u0627\u0643\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Hayra'z-z\xe2kir\xeen",meal:"Ey zikredenlerin ve zikredenleri m\xfckafatland\u0131ranlar\u0131n en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0652\u0648\u064e\u0627\u0631\u0650\u062b\u0650\u064a\u0646\u064e",latin:"Y\xe2 Hayra'l-v\xe2ri\u015f\xeen",meal:"Ey v\xe2rislerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0652\u062d\u064e\u0627\u0645\u0650\u062f\u0650\u064a\u0646\u064e",latin:"Y\xe2 Hayra'l-h\xe2mid\xeen",meal:"Ey \xf6venlerin ve \xf6venleri m\xfckafatland\u0131ranlar\u0131n en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0627\u0644\u0631\u064e\u0651\u0627\u0632\u0650\u0642\u0650\u064a\u0646\u064e",latin:"Y\xe2 Hayra'r-r\xe2zik\xeen",meal:"Ey r\u0131z\u0131k verenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\