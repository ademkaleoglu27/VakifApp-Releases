47\u064f \u062d\u064e\u0628\u0650\u064a\u0628\u064c",latin:"Y\xe2 Men h\xfcve limen et\xe2\u2019ah\xfb hab\xeeb",meal:"Ey kendisine itaat edenleri seven,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u0627\u064e\u062d\u064e\u0628\u0651\u064e\u0647\u064f \u0642\u064e\u0631\u0650\u064a\u0628\u064c",latin:"Y\xe2 Men h\xfcve limen ehabbeh\xfb kar\xeeb",meal:"Ey kendisini sevenlere yak\u0131n olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0628\u0650\u0645\u064e\u0646\u0652 \u0627\u064e\u0631\u064e\u0627\u062f\u064e\u0647\u064f \u0639\u064e\u0644\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve bimen er\xe2deh\xfb \u2018al\xeem",meal:"Ey kendisini arzulayanlar\u0131 \xe7ok iyi bilen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u0631\u064e\u062c\u064e\u0627\u0647\u064f \u0643\u064e\u0631\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve limen rec\xe2h\xfc ker\xeem",meal:"Ey kendisine \xfcmit besleyenlere iyilik eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0628\u0650\u0645\u064e\u0646\u0652 \u0639\u064e\u0635\u064e\u0627\u0647\u064f \u062d\u064e\u0644\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve bimen \u2018as\xe2h\xfc hal\xeem",meal:"Ey kendisine isyan edenlere yumu\u015fak davran\u0131p hemen cezaland\u0131rmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u062d\u0650\u0644\u0652\u0645\u0650\u0647\u0650 \u062d\u064e\u0643\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve f\xee hilmih\xee hak\xeem",meal:"Ey yumu\u015fakl\u0131\u011f\u0131nda hikmetli davranan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u062d\u064f\u0643\u0652\u0645\u0650\u0647\u0650 \u0639\u064e\u0638\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve f\xee h\xfckmih\xee \u2018az\xeem",meal:"Ey h\xfckm\xfcnde b\xfcy\xfck olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u0639\u064e\u0638\u064e\u0645\u064e\u062a\u0650\u0647\u0650 \u0631\u064e\u062d\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve f\xee \u2018azametih\xee rah\xeem",meal:"Ey azametinde merhametli olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0653\u0649 \u0627\u0650\u062d\u0652\u0633\u064e\u0627\u0646\u0650\u0647\u0650 \u0642\u064e\u062f\u0650\u064a\u0645\u064c",latin:"Y\xe2 Men h\xfcve f\xee ihs\xe2nih\xee kad\xeem",meal:"Ey ihs\xe2n\u0131nda kad\xeem olan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:96,title:"Musebbib ve Mukarrib",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0633\u064e\u0628\u0651\u0650\u0628\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Musebbib",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey sebepleri takdir eden M\xfcsebbib,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0642\u064e\u0631\u0651\u0650\u0628\u064f",la