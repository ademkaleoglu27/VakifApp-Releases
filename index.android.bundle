azainih\xee \u015fey",meal:"Ey haz\xeenelerinden hi\xe7bir \u015fey eksik olmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u062e\u0652\u0641\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0634\u064e\u0649\u0652\u0621\u064c",latin:"Y\xe2 Men l\xe2 yahf\xe2 \u2018aleyhi \u015fey",meal:"Ey hi\xe7bir \u015fey Kendisine gizli bulunmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u064a\u0652\u0633\u064e \u0643\u064e\u0645\u0650\u062b\u0652\u0644\u0650\u0647\u0650 \u0634\u064e\u0649\u0652\u0621\u064c",latin:"Y\xe2 Men leyse kemi\u015flih\xee \u015fey",meal:"Ey misli ve benzeri hi\xe7bir \u015fey bulunmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0645\u064e\u0642\u064e\u0627\u0644\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d",latin:"Y\xe2 Men biyedih\xee mek\xe2l\xeed\xfc k\xfclli \u015fey",meal:"Ey her \u015feyin anahtar\u0131 elinde olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0648\u064e\u0633\u0650\u0639\u064e\u062a\u0652 \u0631\u064e\u062d\u0652\u0645\u064e\u062a\u064f\u0647\u064f \u0643\u064f\u0644\u0651\u064e \u0634\u064e\u0649\u0652\u0621\u064d",latin:"Y\xe2 Men vesi\u2019at rahmet\xfch\xfb k\xfclle \u015fey",meal:"Ey rahmeti her \u015feyi ku\u015fatan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0628\u0652\u0642\u0670\u0649 \u0648\u064e \u064a\u064e\u0641\u0652\u0646\u0670\u0649 \u0643\u064f\u0644\u0651\u064f \u0634\u064e\u0649\u0652\u0621\u064d",latin:"Y\xe2 Men yebk\xe2 ve yefn\xe2 k\xfcll\xfc \u015fey",meal:"Ey her \u015fey f\xe2ni oldu\u011fu halde Kendisi b\xe2k\xee kalan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \