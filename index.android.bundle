__d(function(a,e,i,t,n,r,c){n.exports={title:"Sabah Namaz\u0131 Tesbihat\u0131",sections:[{id:"selam_sonrasi",title:"Sel\xe2m Sonras\u0131",content:[{text:"Sabah Namaz\u0131n\u0131n farz\u0131n\u0131 k\u0131l\u0131p, selam verdikten sonra"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u0648\u064e \u0645\u0650\u0646\u0652\u0643\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u0643\u0652\u062a\u064e \u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0644\u0627\u064e\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0643\u0652\u0631\u064e\u0627\u0645\u0650"},{text:"Denilir, eller yukar\u0131 kald\u0131r\u0131l\u0131p a\xe7\u0131larak Sal\xe2ten T\xfcnc\xeen\xe2 duas\u0131 okunur:"}]},{id:"salaten_tuncina",title:"Sal\xe2ten T\xfcnc\xeen\xe2",content:[{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0635\u064e\u0644\u0627\u064e\u0629\u064b \u062a\u064f\u0646\u0652\u062c\u06ea\u064a\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0647\u0652\u0648\u064e\u0627\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0670\u0641\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0642\u0652\u0636\u06ea\u0649 \u0644\u064e\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u062c\u064e\u0645\u06ea\u064a\u0639\u064e \u0627\u0644\u0652\u062d\u064e\u0627\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0637\u064e\u0647\u0650\u0651\u0631\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0633\u064e\u0651\u064a\u0650\u0651\u0626\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0631\u0652\u0641\u064e\u0639\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0639\u0650\u0646\u0652\u062f\u064e\u0643\u064e \u0627\u064e\u0639\u0652\u0644\u064e\u0649 \u0627\u0644\u062f\u064e\u0651\u0631\u064e\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0628\u064e\u0644\u0650\u0651\u063a\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0653\u0627 \u0627\u064e\u0642\u0652\u0635\u064e\u0649 \u0627\u0644\u0652\u063a\u064e\u0627\u064a\u064e\u0627\u062a\u0650 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064e\u0627\u062a\u0650 \u0641\u0650\u0649 \u0627\u0644\u0652\u062d\u064e\u064a\u064e\u0627\u0629\u0650 \u0648\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0627\u0644\u0652\u0645\u064e\u0645\u064e\u0627\u062a\u0650 \u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0628\u064e \u0627\u0644\u062f\u064e\u0651\u0639\u064e\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"sehadet",title:"\u015eehadet Ba\u015flang\u0131c\u0131",content:[{text:"Akabinde bir defa okunur:"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u0650\u0646\u064e\u0651\u0627 \u0646\u064f\u0642\u064e\u062f\u0650\u0651\u0645\u064f \u0627\u0650\u0644\u064e\u064a\u0652\u0643\u064e \u0628\u064e\u064a\u0652\u0646\u064e \u064a\u064e\u062f\u064e\u0649\u0652 \u0643\u064f\u0644\u0650\u0651 \u0646\u064e\u0641\u064e\u0633\u064d \u0648\u064e \u0644\u064e\u0645\u0652\u062d\u064e\u0629\u064d \u0648\u064e \u0644\u064e\u062d\u0652\u0638\u064e\u0629\u064d \u0648\u064e \u0637\u064e\u0631\u0652\u0641\u064e\u0629\u064d \u064a\u064e\u0637\u0652\u0631\u0650\u0641\u064f \u0628\u0650\u0647\u064e\u0653\u0627 \u0627\u064e\u0647\u0652\u0644\u064f \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e \u0627\u064e\u0647\u0652\u0644\u064f \u0627\u0652\u0644\u0627\u064e\u0631\u064e\u0636\u06ea\u064a\u0646\u064e \u0634\u064e\u0647\u064e\u0627\u062f\u064e\u0629\u064b \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u0652"}]},{id:"tevhid_9",title:"Kelime-i Tevhid",content:[{text:"Dokuz defa tekrar edilir:"},{arabic:"\u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u0622\u064e \u0634\u064e\u0631\u06ea\u064a\u0643\u064e \u0644\u064e\u0647\u064f \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u064a\u064f\u062d\u0652\u064a\u06ea\u0649 \u0648\u064e \u064a\u064f\u0645\u06ea\u064a\u062a\u064f \u0648\u064e \u0647\u064f\u0648\u064e \u062d\u064e\u0649\u064c\u0651 \u0644\u0627\u064e \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064f \u0648\u064e \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u06ea\u064a\u0631\u064c",instruction:"9 defa",count:9}]},{id:"tevhid_10",title:"",content:[{text:"Onuncuda \u015f\xf6ylece tamamlan\u0131r:"},{arabic:"\u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u0622\u064e \u0634\u064e\u0631\u06ea\u064a\u0643\u064e \u0644\u064e\u0647\u064f \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u064a\u064f\u062d\u0652\u064a\u06ea\u0649 \u0648\u064e \u064a\u064f\u0645\u06ea\u064a\u062a\u064f \u0648\u064e \u0647\u064f\u0648\u064e \u062d\u064e\u0649\u064c\u0651 \u0644\u0627\u064e \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064f \u0648\u064e \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u06ea\u064a\u0631\u064c \u0648\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0627\u0644\u0652\u0645\u064e\u0635\u06ea\u064a\u0631\u064f"}]},{id:"ecirna_duasi",title:"Ecirn\xe2 mine'n-N\xe2r Duas\u0131",content:[{text:"Sonra avu\xe7 i\xe7leri a\u015fa\u011f\u0131ya do\u011fru \xe7evrilip \xfc\xe7, be\u015f veya yedi defa \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 denilir. M\xfcteakiben \u015f\xf6yle devam edilir:"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0643\u064f\u0644\u0650\u0651 \u0646\u064e\u0627\u0631\u064d \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u0650 \u0627\u0644\u062f\u0651\u06ea\u064a\u0646\u0650\u064a\u064e\u0651\u0629\u0650 \u0648\u064e \u0627\u0644\u062f\u064f\u0651\u0646\u0652\u064a\u064e\u0648\u0650\u064a\u064e\u0651\u0629\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u0650 \u0627\u0670\u062e\u0650\u0631\u0650 \u0627\u0644\u0632\u064e\u0651\u0645\u064e\u0627\u0646\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u0650 \u0627\u0644\u0652\u0645\u064e\u0633\u06ea\u064a\u062d\u0650 \u0627\u0644\u062f\u064e\u0651\u062c\u064e\u0651\u0627\u0644\u0650 \u0648\u064e \u0627\u0644\u0633\u064f\u0651\u0641\u0652\u064a\u064e\u0627\u0646\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0636\u064e\u0651\u0644\u0627\u064e\u0644\u0627\u064e\u062a\u0650 \u0648\u064e \u0627\u0644\u0652\u0628\u0650\u062f\u0652\u0639\u0650\u064a\u064e\u0651\u0627\u062a\u0650 \u0648\u064e \u0627\u0644\u0652\u0628\u064e\u0644\u0650\u064a\u064e\u0651\u0627\u062a\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0646\u064e\u0651\u0641\u0652\u0633\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u064e\u0651\u0627\u0631\u064e\u0629\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0634\u064f\u0631\u064f\u0648\u0631\u0650 \u0627\u0644\u0646\u064f\u0651\u0641\u064f\u0648\u0633\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u064e\u0651\u0627\u0631\u064e\u0627\u062a\u0650 \u0627\u0644\u0652\u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u0650\u064a\u064e\u0651\u0629\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0646\u0650\u0651\u0633\u064e\u0653\u0627\u0621\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0628\u064e\u0644\u0622\u064e\u0621\u0650 \u0627\u0644\u0646\u0650\u0651\u0633\u064e\u0653\u0627\u0621\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u0650 \u0627\u0644\u0646\u0650\u0651\u0633\u064e\u0653\u0627\u0621\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0627\u0644\u0652\u0642\u064e\u0628\u0652\u0631\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u0652\u0642\u0650\u064a\u0670\u0645\u064e\u0629\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u062c\u064e\u0647\u064e\u0646\u064e\u0651\u0645\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0642\u064e\u0647\u0652\u0631\u0650\u0643\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0646\u064e\u0627\u0631\u0650 \u0642\u064e\u0647\u0652\u0631\u0650\u0643\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0627\u0644\u0652\u0642\u064e\u0628\u0652\u0631\u0650 \u0648\u064e \u0627\u0644\u0646\u0650\u0651\u0631\u064e\u0627\u0646\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0631\u0650\u0651\u064a\u064e\u0627\u0621\u0650 \u0648\u064e \u0627\u0644\u0633\u064f\u0651\u0645\u0652\u0639\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0652\u0639\u064f\u062c\u064f\u0628\u0650 \u0648\u064e \u0627\u0644\u0652\u0641\u064e\u062e\u0652\u0631\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u062a\u064e\u062c\u064e\u0627\u0648\u064f\u0632\u0650 \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u062d\u0650\u062f\u06ea\u064a\u0646\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0652\u0645\u064f\u0646\u064e\u0627\u0641\u0650\u0642\u06ea\u064a\u0646\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0641\u0650\u062a\u0652\u0646\u064e\u0629\u0650 \u0627\u0644\u0652\u0641\u064e\u0627\u0633\u0650\u0642\u06ea\u064a\u0646\u064e \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062c\u0650\u0631\u0652 \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0637\u064e\u0644\u064e\u0628\u064e\u0629\u064e \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0627\u0644\u0635\u064e\u0651\u062f\u0650\u0642\u06ea\u064a\u0646\u064e \u0641\u06ea\u0649 \u062e\u0650\u062f\u0652\u0645\u064e\u0629\u0650 \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u06ea\u064a\u0645\u064e\u0627\u0646\u0650 \u0648\u064e \u0627\u064e\u062d\u0652\u0628\u064e\u0627\u0628\u064e\u0646\u064e\u0627 \u0627\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u06ea\u064a\u0646\u064e \u0627\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u0650\u0635\u06ea\u064a\u0646\u064e \u0648\u064e \u0627\u064e\u0642\u0652\u0631\u0650\u0628\u064e\u0653\u0627\u0626\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062c\u0652\u062f\u064e\u0627\u062f\u064e\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650"}]},{id:"cennet_duasi",title:"",content:[{text:"Avu\xe7 i\xe7leri yukar\u0131 \xe7evrilerek devam edilir:"},{arabic:"\u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0631\u064f \u0628\u0650\u0641\u064e\u0636\u0652\u0644\u0650\u0643\u064e \u064a\u064e\u0627 \u063a\u064e\u0641\u064e\u0651\u0627\u0631\u064f \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u064e \u0645\u064e\u0639\u064e \u0627\u0652\u0644\u0627\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u064e \u0645\u064e\u0639\u064e \u0627\u0652\u0644\u0627\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u0650 \u066d \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652 \u0627\u064f\u0633\u0652\u062a\u064e\u0627\u062f\u064e\u0646\u064e\u0627 \u0633\u064e\u0639\u06ea\u064a\u062f\u064e \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0652\u0633\u06ea\u0649 \u0631\u064e\u0636\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0637\u064e\u0644\u064e\u0628\u064e\u0629\u064e \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0627\u0644\u0635\u064e\u0651\u062f\u0650\u0642\u06ea\u064a\u0646\u064e \u0648\u064e \u0627\u0650\u062e\u0652\u0648\u064e\u0627\u0646\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062e\u064e\u0648\u064e\u0627\u062a\u0650\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u0642\u0652\u0631\u0650\u0628\u064e\u0653\u0627\u0626\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062c\u0652\u062f\u064e\u0627\u062f\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062d\u0652\u0628\u064e\u0627\u0628\u064e\u0646\u064e\u0627 \u0627\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u06ea\u064a\u0646\u064e \u0627\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u0650\u0635\u06ea\u064a\u0646\u064e \u0641\u06ea\u0649 \u062e\u0650\u062f\u0652\u0645\u064e\u0629\u0650 \u0627\u0652\u0644\u0627\u06ea\u064a\u0645\u064e\u0627\u0646\u0650 \u0648\u064e \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u0650 \u0627\u064e\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u064e \u0645\u064e\u0639\u064e \u0627\u0652\u0644\u0627\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u0650 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0646\u064e\u0628\u0650\u064a\u0650\u0651\u0643\u064e \u0627\u0644\u0652\u0645\u064f\u062e\u0652\u062a\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u0670\u0644\u0650\u0647\u06ea \u0627\u0652\u0644\u0627\u064e\u0637\u0652\u0647\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u0650\u0647\u0650 \u0627\u0652\u0644\u0627\u064e\u062e\u0652\u064a\u064e\u0627\u0631\u0650 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0645\u064e\u0627\u062f\u064e\u0627\u0645\u064e \u0627\u0644\u064e\u0651\u064a\u0652\u0644\u064f \u0648\u064e \u0627\u0644\u0646\u064e\u0651\u0647\u064e\u0627\u0631\u064f \u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"salavat_dua",title:"Sal\xe2vat Sonras\u0131 Dua",content:[{text:"Akabinde Sal\xe2vat-\u0131 \u015eerife getirilip, bu dua okunur:"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0648\u064e\u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0623\u064e\u0643\u0652\u0628\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0627 \u062d\u064e\u0648\u0652\u0644\u064e \u0648\u064e\u0644\u064e\u0627 \u0642\u064f\u0648\u064e\u0651\u0629\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u0650"}]},{id:"ayetel_kursi",title:"\xc2yet\xfc'l K\xfcrs\xee",content:[{text:"\xc2yet\xfc'l K\xfcrs\xee (Bakara S\xfbresi 255) okunur:"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0647\u064f\u0648\u064e\u06da \u0627\u064e\u0644\u0652\u062d\u064e\u064a\u064f\u0651 \u0627\u0644\u0652\u0642\u064e\u064a\u064f\u0651\u0648\u0645\u064f\u06da \u0644\u064e\u0627 \u062a\u064e\u0623\u0652\u062e\u064f\u0630\u064f\u0647\u064f \u0633\u0650\u0646\u064e\u0629\u064c \u0648\u064e\u0644\u064e\u0627 \u0646\u064e\u0648\u0652\u0645\u064c\u06dc \u0644\u064e\u0647\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650\u06dc \u0645\u064e\u0646\u0652 \u0630\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a \u064a\u064e\u0634\u0652\u0641\u064e\u0639\u064f \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0650\u0630\u0652\u0646\u0650\u0647\u06ea\u06dc \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e \u0627\u064e\u064a\u0652\u062f\u06ea\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u0652\u0641\u064e\u0647\u064f\u0645\u0652\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u062d\u06ea\u064a\u0637\u064f\u0648\u0646\u064e \u0628\u0650\u0634\u064e\u064a\u0652\u0621\u064d \u0645\u0650\u0646\u0652 \u0639\u0650\u0644\u0652\u0645\u0650\u0647\u06ea\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0645\u064e\u0627 \u0634\u064e\u0653\u0627\u0621\u064e\u06da \u0648\u064e\u0633\u0650\u0639\u064e \u0643\u064f\u0631\u0652\u0633\u0650\u064a\u064f\u0651\u0647\u064f \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0624\u064f\u06eb\u062f\u064f\u0647\u064f \u062d\u0650\u0641\u0652\u0638\u064f\u0647\u064f\u0645\u064e\u0627\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u064f\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u06ea\u064a\u0645\u064f"}]},{id:"tesbihat_33",title:"Tesbihat",content:[{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u064e\u0643\u0652\u0628\u064e\u0631\u064f",instruction:"33 defa tesbihleri \xe7ekilir.",count:33}]},{id:"tevhid",title:"Kelime-i Tevhid",content:[{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u0627\u064e \u0634\u064e\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0647\u064f \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u064a\u064f\u062d\u0652\u064a\u0650\u0649 \u0648\u064e\u064a\u064f\u0645\u0650\u064a\u062a\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0649\u064c\u0651 \u0644\u0627\u064e \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c \u0648\u064e\u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0627\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f"},{text:"Denildikten sonra dua edilir. Duadan sonra bir defa"},{arabic:"\u0641\u064e\u0627\u0639\u0652\u0644\u064e\u0645\u0652 \u0627\u064e\u0646\u064e\u0651\u0647\u064f",instruction:"diyerek kelime-i tevhide ge\xe7ilir."},{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f",instruction:"33 defa okunur.",count:33},{arabic:"\u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064c \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u064e",instruction:"diyerek tamamlan\u0131r."}]},{id:"sabaha_mahsus",title:"Sabah Namaz\u0131na Mahsus",content:[{text:"Sabah Namaz\u0131 Tesbihat\u0131na mahsus 10 defa okunur:"},{arabic:"\u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u064e\u0644\u0652\u0645\u064e\u0644\u0650\u0643\u064f \u0627\u0644\u0652\u062d\u064e\u0642\u064f\u0651 \u0627\u0644\u0652\u0645\u064f\u0628\u06ea\u064a\u0646\u064f \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064c \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0627\u062f\u0650\u0642\u064f \u0627\u0644\u0652\u0648\u064e\u0639\u0652\u062f\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u06ea\u064a\u0646\u064f",instruction:"10 defa",count:10}]},{id:"salavat",title:"Sal\xe2vat-\u0131 \u015eerife",content:[{text:"Ve tesbihata \u015f\xf6ylece devam edilir:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0627\u0650\u0646\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0648\u064e \u0645\u064e\u0644\u064e\u0653\u0626\u0650\u0643\u064e\u062a\u064e\u0647\u064f \u064a\u064f\u0635\u064e\u0644\u064f\u0651\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0646\u064e\u0651\u0628\u0650\u0649\u0650\u0651 \u064a\u064e\u0653\u0627 \u0627\u064e\u064a\u064f\u0651\u0647\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0627 \u0635\u064e\u0644\u064f\u0651\u0648\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u064f\u0648\u0627 \u062a\u064e\u0633\u0652\u0644\u06ea\u064a\u0645\u064b\u0627 \u066d \u0644\u064e\u0628\u064e\u0651\u064a\u0652\u0643\u064e"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u064a\u064e\u0627 \u0631\u064e\u0628\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u062d\u064e\u0628\u06ea\u064a\u0628\u0650\u0643\u064e \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0646\u0652\u0628\u0650\u064a\u064e\u0653\u0627\u0621\u0650 \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0631\u0652\u0633\u064e\u0644\u06ea\u064a\u0646\u064e \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0643\u064f\u0644\u064d\u0651 \u0648\u064e \u0635\u064e\u062d\u0652\u0628\u0650 \u0643\u064f\u0644\u064d\u0651 \u0627\u064e\u062c\u0652\u0645\u064e\u0639\u06ea\u064a\u0646\u064e\n\n\u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"},{arabic:"\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0628\u06ea\u064a\u0628\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u062d\u0652\u0649\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0648\u064e \u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650\u0647\u06ea \u0648\u064e \u0623\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u0650\u0647\u0650 \u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0627\u064e\u0648\u0652\u0631\u064e\u0627\u0642\u0650 \u0627\u0652\u0644\u0627\u064e\u0634\u0652\u062c\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u064e\u0645\u0652\u0648\u064e\u0627\u062c\u0650 \u0627\u0644\u0652\u0628\u0650\u062d\u064e\u0627\u0631\u0650 \u0648\u064e \u0642\u064e\u0637\u064e\u0631\u064e\u0627\u062a\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u0652\u0637\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u063a\u0652\u0641\u0650\u0631\u0652\u0644\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u0631\u0652\u062d\u064e\u0645\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u0644\u0652\u0637\u064f\u0641\u0652 \u0628\u0650\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0627\u064f\u0633\u0652\u062a\u064e\u0627\u062f\u0650\u0646\u064e\u0627 \u0633\u064e\u0639\u06ea\u064a\u062f\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0652\u0633\u06ea\u0649 \u0631\u064e\u0636\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0637\u064e\u0644\u064e\u0628\u064e\u0629\u0650 \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0627\u0644\u0635\u064e\u0651\u062f\u0650\u0642\u06ea\u064a\u0646\u064e \u064a\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e\u0646\u064e\u0627 \u0628\u0650\u0643\u064f\u0644\u0650\u0651 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0645\u0650\u0646\u0652\u0647\u064e\u0653\u0627 \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u0652 \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u064e\u0651 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064b\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u0652"}]},{id:"tercuman_ism_azam",title:"Terc\xfcman-\u0131 \u0130sm-i A'z\xe2m Duas\u0131",content:[{text:"Terc\xfcman-\u0131 \u0130sm-i A'z\xe2m duas\u0131 okunur:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0643\u064e\u0631\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0645\u06ea\u064a\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062d\u064e\u0643\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064e\u062c\u06ea\u064a\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064e\u0644\u0650\u0643\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064f\u062f\u064f\u0651\u0648\u0633\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0633\u064e\u0644\u0627\u064e\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0647\u064e\u064a\u0652\u0645\u0650\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0639\u064e\u0632\u06ea\u064a\u0632\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062c\u064e\u0628\u064e\u0651\u0627\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062a\u064e\u0643\u064e\u0628\u0650\u0651\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062e\u064e\u0627\u0644\u0650\u0642\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0648\u064e\u0651\u0644\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0653\u0627 \u0627\u0670\u062e\u0650\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0638\u064e\u0627\u0647\u0650\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0637\u0650\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0631\u0650\u0649\u0621\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0635\u064e\u0648\u0650\u0651\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062a\u064e\u0648\u064e\u0651\u0627\u0628\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u064e\u0647\u064e\u0651\u0627\u0628\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0639\u0650\u062b\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u064e\u0627\u0631\u0650\u062b\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064e\u062f\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0642\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0641\u064e\u0631\u0652\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u0650\u062a\u0652\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0646\u064f\u0648\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0633\u064e\u062a\u064e\u0651\u0627\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062c\u064e\u0644\u06ea\u064a\u0644\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062c\u064e\u0645\u06ea\u064a\u0644\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064e\u0627\u0647\u0650\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0642\u064e\u0627\u062f\u0650\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064e\u0644\u06ea\u064a\u0643\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0642\u0652\u062a\u064e\u062f\u0650\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0639\u064e\u0644\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0639\u064e\u0644\u0627\u064e\u0651\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0639\u064e\u0638\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u063a\u064e\u0641\u064f\u0648\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0644\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u064e\u062f\u064f\u0648\u062f\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0634\u064e\u0647\u06ea\u064a\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0634\u064e\u0627\u0647\u0650\u062f\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0643\u064e\u0628\u06ea\u064a\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u062a\u064e\u0639\u064e\u0627\u0644\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0646\u064f\u0648\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0644\u064e\u0637\u06ea\u064a\u0641\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0633\u064e\u0645\u06ea\u064a\u0639\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0643\u064e\u0641\u06ea\u064a\u0644\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064e\u0631\u06ea\u064a\u0628\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0628\u064e\u0635\u06ea\u064a\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0642\u064f\u0651 \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0628\u06ea\u064a\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u0624\u064f\u0641\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0637\u064e\u0627\u0647\u0650\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0637\u064e\u0647\u0650\u0651\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u064e\u0645\u0650\u0651\u0644\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0641\u064e\u0636\u0650\u0651\u0644\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0638\u0652\u0647\u0650\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0646\u0652\u0639\u0650\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062f\u064e\u064a\u064e\u0651\u0627\u0646\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0633\u064f\u0644\u0652\u0637\u064e\u0627\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0646\u064e\u0651\u0627\u0646\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064e\u0646\u064e\u0651\u0627\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u062d\u064e\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0635\u064e\u0645\u064e\u062f\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0649\u064f\u0651 \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0642\u064e\u064a\u064f\u0651\u0648\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0639\u064e\u062f\u0652\u0644\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062d\u064e\u0643\u064e\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f\n\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0641\u064e\u0631\u0652\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0642\u064f\u062f\u064f\u0651\u0648\u0633\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"}]},{id:"kapanis_duasi",title:"Kapan\u0131\u015f Duas\u0131",content:[{text:"Avu\xe7lar yukar\u0131 gelecek \u015fekilde eller a\xe7\u0131l\u0131r:"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u0627\u0670\u0647\u0650\u064a\u064b\u0651\u0627 \u0634\u064e\u0631\u064e\u0627\u0647\u0650\u064a\u064b\u0651\u0627 \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0622\u064e\u0651 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062c\u0650\u0631\u0652 \u0627\u064f\u0633\u0652\u062a\u064e\u0627\u062f\u064e\u0646\u064e\u0627 \u0633\u064e\u0639\u06ea\u064a\u062f\u064e \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0652\u0633\u06ea\u0649 \u0631\u064e\u0636\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u0650\u062e\u0652\u0648\u064e\u0627\u0646\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062e\u064e\u0648\u064e\u0627\u062a\u064e\u0646\u064e\u0627 \u0648\u064e \u0637\u064e\u0644\u064e\u0628\u064e\u0629\u064e \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0648\u064e \u0631\u064f\u0641\u064e\u0642\u064e\u0653\u0627\u0626\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u062d\u0652\u0628\u064e\u0627\u0628\u064e\u0646\u064e\u0627 \u0627\u0644\u0652\u0645\u064f\u062e\u0652\u0644\u0650\u0635\u06ea\u064a\u0646\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650"},{text:"Avu\xe7 i\xe7leri a\u015fa\u011f\u0131ya \xe7evrilerek devam edilir:"},{arabic:"\u0648\u064e \u0645\u0650\u0646\u0652 \u0643\u064f\u0644\u0650\u0651 \u0646\u064e\u0627\u0631\u064d \u0648\u064e \u0627\u062d\u0652\u0641\u064e\u0638\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0646\u064e\u0651\u0641\u0652\u0633\u0650 \u0648\u064e \u0627\u0644\u0634\u064e\u0651\u064a\u0652\u0637\u064e\u0627\u0646\u0650 \u0648\u064e \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0652\u062c\u0650\u0646\u0650\u0651 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u0650 \u0648\u064e \u0645\u0650\u0646\u0652 \u0634\u064e\u0631\u0650\u0651 \u0627\u0644\u0652\u0628\u0650\u062f\u0652\u0639\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0636\u064e\u0651\u0644\u0627\u064e\u0644\u0627\u064e\u062a\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0644\u0652\u062d\u064e\u0627\u062f\u0650 \u0648\u064e \u0627\u0644\u0637\u064f\u0651\u063a\u0652\u064a\u064e\u0627\u0646\u0650"},{text:"Avu\xe7lar tekrar yukar\u0131 gelecek \u015fekilde dua \u015f\xf6ylece tamamlan\u0131r:"},{arabic:"\u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0631\u064f \u0628\u0650\u0641\u064e\u0636\u0652\u0644\u0650\u0643\u064e \u064a\u064e\u0627 \u063a\u064e\u0641\u064e\u0651\u0627\u0631\u064f \u0628\u0650\u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0631\u0652\u062d\u064e\u0645\u064e \u0627\u0644\u0631\u064e\u0651\u0627\u062d\u0650\u0645\u06ea\u064a\u0646\u064e \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u064e \u0645\u064e\u0639\u064e \u0627\u0652\u0644\u0627\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u0650 \u0628\u0650\u0634\u064e\u0641\u064e\u0627\u0639\u064e\u0629\u0650 \u0646\u064e\u0628\u0650\u064a\u0650\u0651\u0643\u064e \u0627\u0644\u0652\u0645\u064f\u062e\u0652\u062a\u064e\u0627\u0631\u0650 \u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"hasr_suresi",title:"Ha\u015fr S\xfbresi (20-24)",content:[{text:"Ha\u015fr S\xfbresi'nin 20-24. \xc2yetleri okunur:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0644\u0627\u064e \u064a\u064e\u0633\u0652\u062a\u064e\u0648\u06ea\u0653\u0649 \u0627\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u064f \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0648\u064e\u0627\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u064f \u0627\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u0650\u06dc \u0627\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u064f \u0627\u0644\u0652\u062c\u064e\u0646\u064e\u0651\u0629\u0650 \u0647\u064f\u0645\u064f \u0627\u0644\u0652\u0641\u064e\u0653\u0627\u0626\u0650\u0632\u064f\u0648\u0646\u064e"},{arabic:"\u0644\u064e\u0648\u0652 \u0627\u064e\u0646\u0652\u0632\u064e\u0644\u0652\u0646\u064e\u0627 \u0647\u0670\u0630\u064e\u0627 \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u064e \u0639\u064e\u0644\u0670\u0649 \u062c\u064e\u0628\u064e\u0644\u064d \u0644\u064e\u0631\u064e\u0627\u064e\u064a\u0652\u062a\u064e\u0647\u064f \u062e\u064e\u0627\u0634\u0650\u0639\u064b\u0627 \u0645\u064f\u062a\u064e\u0635\u064e\u062f\u0650\u0651\u0639\u064b\u0627 \u0645\u0650\u0646\u0652 \u062e\u064e\u0634\u0652\u064a\u064e\u0629\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650\u06dc \u0648\u064e\u062a\u0650\u0644\u0652\u0643\u064e \u0627\u0652\u0644\u0627\u064e\u0645\u0652\u062b\u064e\u0627\u0644\u064f \u0646\u064e\u0636\u0652\u0631\u0650\u0628\u064f\u0647\u064e\u0627 \u0644\u0650\u0644\u0646\u064e\u0651\u0627\u0633\u0650 \u0644\u064e\u0639\u064e\u0644\u064e\u0651\u0647\u064f\u0645\u0652 \u064a\u064e\u062a\u064e\u0641\u064e\u0643\u064e\u0651\u0631\u064f\u0648\u0646\u064e"},{arabic:"\u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u064e\u0651\u0630\u06ea\u0649 \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0647\u064f\u0648\u064e\u06da \u0639\u064e\u0627\u0644\u0650\u0645\u064f \u0627\u0644\u0652\u063a\u064e\u064a\u0652\u0628\u0650 \u0648\u064e\u0627\u0644\u0634\u064e\u0651\u0647\u064e\u0627\u062f\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u064f \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u064f"},{arabic:"\u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u064e\u0651\u0630\u06ea\u0649 \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0647\u064f\u0648\u064e\u06da \u0627\u064e\u0644\u0652\u0645\u064e\u0644\u0650\u0643\u064f \u0627\u0644\u0652\u0642\u064f\u062f\u064f\u0651\u0648\u0633\u064f \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u0627\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0627\u0644\u0652\u0645\u064f\u0647\u064e\u064a\u0652\u0645\u0650\u0646\u064f \u0627\u0644\u0652\u0639\u064e\u0632\u06ea\u064a\u0632\u064f \u0627\u0644\u0652\u062c\u064e\u0628\u064e\u0651\u0627\u0631\u064f \u0627\u0644\u0652\u0645\u064f\u062a\u064e\u0643\u064e\u0628\u0650\u0651\u0631\u064f\u06dc \u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0639\u064e\u0645\u064e\u0651\u0627 \u064a\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0646\u064e"},{arabic:"\u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u0652\u062e\u064e\u0627\u0644\u0650\u0642\u064f \u0627\u0644\u0652\u0628\u064e\u0627\u0631\u0650\u0649\u064f\u0654 \u0627\u0644\u0652\u0645\u064f\u0635\u064e\u0648\u0650\u0651\u0631\u064f \u0644\u064e\u0647\u064f \u0627\u0652\u0644\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0621\u064f \u0627\u0644\u0652\u062d\u064f\u0633\u0652\u0646\u0670\u0649\u06dc \u064a\u064f\u0633\u064e\u0628\u0650\u0651\u062d\u064f \u0644\u064e\u0647\u064f \u0645\u064e\u0627 \u0641\u0650\u0649 \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0652\u0644\u0627\u064e\u0631\u0652\u0636\u0650\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0632\u06ea\u064a\u0632\u064f \u0627\u0644\u0652\u062d\u064e\u0643\u06ea\u064a\u0645\u064f"}]},{id:"fatiha",title:"F\xe2tiha-i \u015eer\xeefe",content:[{text:"Fatiha-i \u015eerife ile tesbihat tamamlan\u0131r:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650\n\u0627\u064e\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e\u06d9\n\u0627\u064e\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650\u06d9\n\u0645\u064e\u0627\u0644\u0650\u0643\u0650 \u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u062f\u0651\u06ea\u064a\u0646\u0650\u06dc\n\u0627\u0650\u064a\u064e\u0651\u0627\u0643\u064e \u0646\u064e\u0639\u0652\u0628\u064f\u062f\u064f \u0648\u064e\u0627\u0650\u064a\u064e\u0651\u0627\u0643\u064e \u0646\u064e\u0633\u0652\u062a\u064e\u0639\u06ea\u064a\u0646\u064f\u06dc\n\u0627\u0650\u0647\u0652\u062f\u0650\u0646\u064e\u0627 \u0627\u0644\u0635\u0650\u0651\u0631\u064e\u0627\u0637\u064e \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u062a\u064e\u0642\u06ea\u064a\u0645\u064e\u06d9\n\u0635\u0650\u0631\u064e\u0627\u0637\u064e \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u064e\u0646\u0652\u0639\u064e\u0645\u0652\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652\u06d9 \u063a\u064e\u064a\u0652\u0631\u0650 \u0627\u0644\u0652\u0645\u064e\u063a\u0652\u0636\u064f\u0648\u0628\u0650 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0648\u064e\u0644\u064e\u0627 \u0627\u0644\u0636\u064e\u0651\u0653\u0627\u0644\u0651\u06ea\u064a\u0646\u064e"}]}]}},2448,[]);
__d(function(e,i,l,n,a,m,t){a.exports={title:"Sabah Namaz\u0131 Tesbihat\u0131 \u2013 T\xfcrk\xe7e Okunu\u015f",sections:[{id:"selam_sonrasi",title:"",content:[{text:"Sabah Namaz\u0131n\u0131n farz\u0131n\u0131 k\u0131l\u0131p, selam verdikten sonra"},{latin:"All\xe2h\xfcmme ente's-sel\xe2m\xfc ve minke's-sel\xe2m, teb\xe2rekte y\xe2 \u1e95e'l-cel\xe2li ve'l-ikr\xe2m"},{text:"Denilir, eller yukar\u0131 kald\u0131r\u0131l\u0131p a\xe7\u0131larak Sal\xe2ten T\xfcnc\xeen\xe2 duas\u0131 okunur:"}]},{id:"salaten_tuncina",title:"",content:[{latin:"Allah\xfcmme \u0161alli al\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. \u0160al\xe2ten t\xfcnc\xeen\xe2 bih\xe2 min-cem\xee\u02bf\u0131'l-ehv\xe2li ve'l-\xe2f\xe2t. Ve tak\u1e0d\xeelen\xe2 bi-h\xe2 cem\xee\u02bfa'l-\u1e25\xe2c\xe2t. Ve t\xfc\u1e6dahhirun\xe2 bi-h\xe2 min-cem\xee\u02bf\u0131's-seyyi\xe2t. Ve terfe\u02bfun\xe2 bi-h\xe2 \u02bfindeke a\u02bfle'd-derec\xe2t. Ve t\xfcbelli\u011fun\xe2 bi-h\xe2 a\u1e33\u0161a'l-\u011f\xe2y\xe2t. Min-cem\xee\u02bfi'l-\u1e2bayr\xe2ti fi'l-\u1e25ay\xe2ti ve ba\u02bfde'l-mem\xe2t. \xc2min y\xe2 Muc\xeebe'd-de\u02bfav\xe2ti ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\u02bf\xe2lem\xeen."}]},{id:"sehadet_baslangic",title:"",content:[{text:"Bir defa okunur:"},{latin:"All\xe2h\xfcmme inn\xe2 nu\u1e33addimu ileyke beyne yedey k\xfclli nefesin ve lem\u1e25atin ve l\xe2\u1e25\u1e93atin ve \u1e6darfetin ya\u1e6drifu bi-h\xe2 ehl\xfc's-sem\xe2v\xe2ti ve ehl\xfc'l-ara\u1e0d\xeene \u015feh\xe2deten: E\u015fhed\xfc en"}]},{id:"tevhid_9",title:"",content:[{text:"Dokuz defa okunur:"},{latin:"L\xe2 il\xe2he ill\xe2llah\xfc, va\u1e25deh\xfb, l\xe2 \u015fer\xeeke leh, leh\xfc'l-m\xfclk\xfc ve leh\xfc'l-\u1e25amd\xfc, yu\u1e25y\xee ve y\xfcm\xeet, bi-yedihi'l-\u1e2bayr ve h\xfcve \u02bfal\xe2 k\xfclli \u015fey'in \u1e33ad\xeer.",count:9}]},{id:"tevhid_10",title:"",content:[{text:"Onuncuda \u015f\xf6ylece tamamlan\u0131r:"},{latin:"L\xe2 il\xe2he ill\xe2llah\xfc, va\u1e25deh\xfb, l\xe2 \u015fer\xeeke leh, leh\xfc'l-m\xfclk\xfc ve leh\xfc'l-\u1e25amd\xfc, yu\u1e25y\xee ve y\xfcm\xeet ve h\xfcve \u1e25ayy\xfcn l\xe2 yem\xfbt, bi-yedihi'l-\u1e2bayr ve h\xfcve \u02bfal\xe2 k\xfclli \u015fey'in \u1e33ad\xeer ve ileyhi'l-ma\u0161\xeer."}]},{id:"ecirn\xe2",title:"",content:[{text:"Sonra avu\xe7 i\xe7leri a\u015fa\u011f\u0131ya do\u011fru \xe7evrilip \xfc\xe7, be\u015f veya yedi defa Allah\xfcmme ecirn\xe2 mine'n-n\xe2r denilir. M\xfcteakiben;"},{latin:"Allah\xfcmme ecirn\xe2 min-k\xfclli n\xe2r.\nAllah\xfcmme ecirn\xe2 min-fitneti'd-d\xeeniyyeti ve'd-d\xfcnyeviyyeh.\nAllah\xfcmme ecirn\xe2 min-fitneti \xe2\u1e2biri'z-zem\xe2n.\nAllah\xfcmme ecirn\xe2 min-fitneti Mes\xee\u1e25\u0131'd-Decc\xe2li ve's-S\xfcfy\xe2n.\nAllah\xfcmme ecirn\xe2 mine'\u1e0d-\u1e0dal\xe2l\xe2ti ve'l-bid\u02bf\u0131yy\xe2ti ve'l-beliyy\xe2t.\nAllah\xfcmme ecirn\xe2 min-\u015ferri'n-nefsi'l-emm\xe2reh.\nAllah\xfcmme ecirn\xe2 min-\u015f\xfcr\xfbri'n-n\xfcf\xfbsi'l-emm\xe2r\xe2ti'l-fir\u02bfavniyyeh.\nAllah\xfcmme ecirn\xe2 min-\u015ferri'n-nis\xe2.\nAllah\xfcmme ecirn\xe2 min-bel\xe2i'n-nis\xe2.\nAllah\xfcmme ecirn\xe2 min-fitneti'n-nis\xe2.\nAllah\xfcmme ecirn\xe2 min-\u02bfa\u1e95\xe2bi'l-\u1e33abr.\nAllah\xfcmme ecirn\xe2 min-\u02bfa\u1e95\xe2bi yevmi'l-\u1e33\u0131y\xe2meh.\nAllah\xfcmme ecirn\xe2 min-\u02bfa\u1e95\xe2bi Cehennem.\nAllah\xfcmme ecirn\xe2 min-\u02bfa\u1e95\xe2bi \u1e33ahrik.\nAllah\xfcmme ecirn\xe2 min-\u02bfn\xe2ri \u1e33ahrik.\nAllah\xfcmme ecirn\xe2 min-\u02bfa\u1e95\xe2bi'l-\u1e33abri ve'n-n\xeer\xe2n.\nAllah\xfcmme ecirn\xe2 mine'r-riy\xe2i ve's-s\xfcm\u02bfati ve'l-\u02bfucubi ve'l-fa\u1e2br.\nAllah\xfcmme ecirn\xe2 min-tec\xe2v\xfczi'l-m\xfcl\u1e25\u0131d\xeen.\nAllah\xfcmme ecirn\xe2 min-\u015ferri'l-m\xfcn\xe2fi\u1e33\xeen.\nAllah\xfcmme ecirn\xe2 min-fitneti'l-f\xe2s\u0131\u1e33\xeen.\nAllah\xfcmme ecirn\xe2 ve ecir v\xe2lideyn\xe2 ve \u1e6dalebete Res\xe2ili'n-N\xfbri'\u0161-\u0161\xe2di\u1e33\xeene f\xee-\u1e2b\u0131dmeti'l-\u1e32ur'\xe2ni ve'l-\xeem\xe2n. Ve a\u1e25b\xe2bene'l-m\xfc'min\xeene'l-mu\u1e2bli\u0161\xeene ve a\u1e33rab\xe2en\xe2 ve ecd\xe2den\xe2 mine'n-n\xe2r."}]},{id:"cennete_dua",title:"",content:[{text:"Avu\xe7 i\xe7leri yukar\u0131 \xe7evrilerek devam edilir:"},{latin:"Bi-\u02bfafvike y\xe2 M\xfcc\xeer, bi-fa\u1e0dlike y\xe2 \u011eaff\xe2r. All\xe2h\xfcmme'd-\u1e2b\u0131lne'l-Cennete me\u02bf\xe2'l-ebr\xe2r. All\xe2h\xfcmme'd-\u1e2b\u0131lne'l-Cennete me\u02bf\xe2'l-ebr\xe2r. All\xe2h\xfcmme'd-\u1e2b\u0131ln\xe2 ve ed\u1e2b\u0131'l-\xdcst\xe2\u1e95en\xe2 Sa\u02bf\xeede'n-Nurs\xee (radiyall\xe2hu \u02bfanh) ve v\xe2lideyn\xe2 ve \u1e6dalebete Res\xe2ili'n-N\xfbri'\u0161-\u0161\xe2d\u0131\u1e33\xeene ve i\u1e2bv\xe2nen\xe2 ve e\u1e2bav\xe2tin\xe2 ve a\u1e33rab\xe2en\xe2 ve ecd\xe2den\xe2 ve a\u1e25b\xe2bene'l-m\xfc'min\xeene'l-mu\u1e2bli\u0161\xeene f\xee-\u1e2b\u0131dmeti'l-\xeem\xe2ni ve'l-\u1e32ur'\xe2n. El-Cennete me\u02bfa'l-ebr\xe2r bi-\u015fef\xe2ati nebiyyike'l-mu\u1e2btar ve \xe2lihi'l-e\u1e6dh\xe2r ve e\u0161\u1e25\xe2bihi'l-a\u1e2by\xe2r ve sellim m\xe2 d\xe2me'l-leyl\xfc ve'n-neh\xe2r. \xc2m\xeen, ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\u02bf\xc2lem\xeen."}]},{id:"salavat_ve_tesbihat",title:"",content:[{text:"Akabinde Sal\xe2vat-\u0131 \u015eerife getirilip, bu dua okunur:"},{latin:"S\xfcb\u1e25\xe2nallahi vel\u1e25amd\xfc lill\xe2hi ve l\xe2 il\xe2he ill\xe2llah\xfc vallah\xfc ekber ve l\xe2 \u1e25avle ve l\xe2 \u1e33uvvete ill\xe2 bill\xe2hi'l-\u02bfaliyyi'l-\u02bfa\u1e93\xeem"}]},{id:"ayetel_kursi",title:"",content:[{text:"\xc2yet\xfc'l K\xfcrs\xee (Bakara S\xfbresi 255) okunur:"},{latin:"All\xe2h\xfc l\xe2 il\xe2he ill\xe2 h\xfcvel hayy\xfcl kayy\xfbm, l\xe2 te'huz\xfchu sinet\xfcn vel\xe2 nevm, lehu m\xe2 fissem\xe2v\xe2ti ve ma fil'ard, men zellezi ye\u015ffeu indehu ill\xe2 bi'iznih, ya'lem\xfc m\xe2 beyne eydihim vem\xe2 halfeh\xfcm, vel\xe2 y\xfc-h\xeet\xfbne bi'\u015fey'in min ilmih\xee ill\xe2 bima \u015f\xe2e vesia k\xfcrsiyy\xfch\xfcssem\xe2v\xe2ti vel'ard, vel\xe2 ye\xfbd\xfch\xfb h\u0131fzuh\xfcm\xe2 ve h\xfcvel aliyy\xfcl azim."}]},{id:"tesbihat_33",title:"",content:[{text:"Daha sonra 33 defa S\xfcb\u1e25\xe2nall\xe2h, 33 defa El\u1e25amd\xfclill\xe2h, 33 defa All\xe2h\xfc Ekber tesbihleri \xe7ekilir."},{latin:"L\xe2 il\xe2he ill\xe2llah\xfc, va\u1e25deh\xfb, l\xe2 \u015fer\xeeke leh, leh\xfc'l-m\xfclk\xfc ve leh\xfc'l-\u1e25amd\xfc, yu\u1e25y\xee ve y\xfcm\xeet ve h\xfcve \u1e25ayy\xfcn l\xe2 yem\xfbt, bi-yedihi'l-\u1e2bayru ve h\xfcve \u02bfal\xe2 k\xfclli \u015fey'in \u1e33ad\xeer ve ileyhi'l-ma\u0161\xeer"},{text:"Denildikten sonra dua edilir. Duadan sonra bir defa Fa\u02bflem ennehu diyerek kelime-i tevhide ge\xe7ilir."},{text:"33 defa L\xe2 il\xe2he ill\xe2llah okunduktan sonra Mu\u1e25ammed\xfc'r-res\xfbl\xfcll\xe2hi \u0161all\xe2llah\xfc te\u02bf\xe2l\xe2 \u02bfaleyhi vesellem diyerek tamamlan\u0131r."}]},{id:"sabaha_mahsus",title:"",content:[{text:"Sabah Namaz\u0131 tesbihat\u0131na mahsus 10 defa okunur:"},{latin:"L\xe2 il\xe2he ill\xe2llah\xfc el-melik\xfc'l-\u1e25a\u1e33\u1e33u'l-m\xfcb\xeen, Mu\u1e25ammed\xfc'r-res\xfblullahi \u0161\xe2di\u1e33u'l-va\u02bfdi'l-em\xeen.",count:10}]},{id:"salavat_devam",title:"",content:[{text:"Ve tesbihata \u015f\xf6ylece devam edilir:"},{latin:"Bismill\xe2hirra\u1e25m\xe2nirra\u1e25\xeem.\n\n\u0130nnall\xe2he ve mel\xe2iketeh\xfb y\xfc\u0161all\xfbne \u02bfale'n-nebiy. Y\xe2 eyy\xfchelle\u1e95\xeene \xe2men\xfb \u0161all\xfb \u02bfaleyhi ve sellim\xfb tesl\xeem\xe2. Lebbeyk."},{latin:"Allah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeer\xe2.\nAllah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeer\xe2.\nAllah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeeran kes\xeer\xe2."},{latin:"\u0160alli ve sellim y\xe2 Rabbi 'al\xe2 \u1e25ab\xeebike Mu\u1e25ammedin ve \u02bfal\xe2 cem\xee\u02bf\u0131'l-enbiy\xe2i ve'l-m\xfcrsel\xeen ve \u02bfal\xe2 \xe2li k\xfcllin ve \u0161ahbi k\xfcllin ecma\u02bf\xeen. \xc2min ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\xe2lem\xeen."},{latin:"Elf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 Res\xfblallah.\nElf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 \u1e24ab\xeeballah.\nElf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 em\xeene va\u1e25yill\xe2h."},{latin:"Allah\xfcmme \u0161alli ve sellim ve b\xe2rik \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2lih\xee ve a\u0161\u1e25\xe2bih\xee bi-\u02bfadedi evra\u1e33\u0131'l-e\u015fc\xe2r ve emv\xe2ci'l-bi\u1e25\xe2r ve \u1e33a\u1e6dar\xe2ti'l-em\u1e6d\xe2r va\u011ffir len\xe2 ver\u1e25amn\xe2 vel\u1e6duf bin\xe2 ve bi-\xdcst\xe2\u1e95in\xe2 Sa\u02bf\xeedi'n-Nurs\xee (ra\u1e0diyallahu \u02bfanh) ve v\xe2lideyn\xe2 ve bi-\u1e6dalebeti Res\xe2ili'n-Nuri'\u0161-\u0161ad\u0131\u1e33\xeene y\xe2 il\xe2hen\xe2 bi-k\xfclli \u0161al\xe2tin minh\xe2 e\u015fhed\xfc en-l\xe2 il\xe2he ill\xe2llah ve e\u015fhed\xfc enne Mu\u1e25ammeden Res\xfbl\xfcll\xe2hi \u0160allall\xe2h\xfc \u02bfAleyhi Vesellem."}]},{id:"tercuman_ism_azam",title:"Terc\xfcman-\u0131 \u0130sm-i A'z\xe2m Duas\u0131",content:[{latin:"Bismill\xe2hirra\u1e25m\xe2nirra\u1e25\xeem"},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Allah te\u02bf\xe2leyte y\xe2 Ra\u1e25m\xe2n ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Ra\u1e25\xeem te\u02bf\xe2leyte y\xe2 Ker\xeem ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e24am\xeed te\u02bf\xe2leyte y\xe2 \u1e24ak\xeem ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Mec\xeed te\u02bf\xe2leyte y\xe2 Mel\xeek ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e32udd\xfbs te\u02bf\xe2leyte y\xe2 Sel\xe2m ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 M\xfc'min te\u02bf\xe2leyte y\xe2 M\xfcheymin ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u02bfAz\xeez te\u02bf\xe2leyte y\xe2 Cebb\xe2r ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 M\xfctekebb\xeer te\u02bf\xe2leyte y\xe2 \u1e2a\xe0l\u0131k ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Evvel te\u02bf\xe2leyte y\xe2 \xc2\u1e2bir ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e92\xe2hir te\u02bf\xe2leyte y\xe2 B\xe2\u1e6d\u0131n ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 B\xe2ri' te\u02bf\xe2leyte y\xe2 Mu\u0161avvir ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Tevv\xe2b te\u02bf\xe2leyte y\xe2 Vehh\xe2b ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 B\xe2is te\u02bf\xe2leyte y\xe2 V\xe2ris ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e32ad\xeem te\u02bf\xe2leyte y\xe2 Mu\u1e33\xeem ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Ferd te\u02bf\xe2leyte y\xe2 Vitr ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 N\xfbr te\u02bf\xe2leyte y\xe2 Sett\xe2r ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Cel\xeel te\u02bf\xe2leyte y\xe2 Cem\xeel ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e32\xe0hir te\u02bf\xe2leyte y\xe2 \u1e32\xe0dir ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Mel\xeek te\u02bf\xe2leyte y\xe2 Mu\u1e33tedir ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u02bfAl\xeem te\u02bf\xe2leyte y\xe2 \u02bfAll\xe2m ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u02bfA\u1e93\xeem te\u02bf\xe2leyte y\xe2 \u011eaf\xfbr ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e24al\xeem te\u02bf\xe2leyte y\xe2 Ved\xfbd ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u015eeh\xeed te\u02bf\xe2leyte y\xe2 \u015e\xe2hid ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Keb\xeer te\u02bf\xe2leyte y\xe2 M\xfcte\u02bf\xe2l ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 N\xfbr te\u02bf\xe2leyte y\xe2 L\xe2\u1e6d\xeef ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Semi\u02bf te\u02bf\xe2leyte y\xe2 Kef\xeel ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e32ar\xeeb te\u02bf\xe2leyte y\xe2 Ba\u0161\xeer ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e24a\u1e33 te\u02bf\xe2leyte y\xe2 M\xfcb\xeen ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Ra\xfbf te\u02bf\xe2leyte y\xe2 Ra\u1e25\xeem ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e6c\xe2hir te\u02bf\xe2leyte y\xe2 Mu\u1e6dahhir ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 M\xfccemmil te\u02bf\xe2leyte y\xe2 Mufa\u1e0d\u1e0d\u0131l ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Mu\u1e93hir te\u02bf\xe2leyte y\xe2 M\xfcn\u02bfim ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Deyy\xe2n te\u02bf\xe2leyte y\xe2 Sul\u1e6d\xe2n ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e24ann\xe2n te\u02bf\xe2leyte y\xe2 Menn\xe2n ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 E\u1e25ad te\u02bf\xe2leyte y\xe2 \u0160amed ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u1e24ayy te\u02bf\xe2leyte y\xe2 \u1e32ayy\xfbm ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 \u02bfAdl te\u02bf\xe2leyte y\xe2 \u1e24akem ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."},{latin:"S\xfcb\u1e25\xe2neke y\xe2 Ferd te\u02bf\xe2leyte y\xe2 \u1e32udd\xfbs ecirn\xe2 mine'n-n\xe2r bi-\u02bfafvike y\xe2 Ra\u1e25m\xe2n."}]},{id:"kapan\u0131\u015f_duas\u0131",title:"",content:[{text:"Avu\xe7lar yukar\u0131 gelecek \u015fekilde eller a\xe7\u0131l\u0131r:"},{latin:"S\xfcb\u1e25\xe2neke \xe2hiyyen \u015fer\xe2hiyyen te\u02bf\xe2leyte l\xe2 il\xe2he ill\xe2 ente ecirn\xe2 ve ecir \xdcst\xe2\u1e95en\xe2 Sa\u02bf\xeede'n-Nurs\xee (ra\u1e0d\u0131yall\xe2hu \u02bfanh) ve v\xe2lideyn\xe2 ve i\u1e2bv\xe2nen\xe2 ve e\u1e2bav\xe2tin\xe2 ve \u1e6dalebete Res\xe2ili'n-N\xfbri ve rufe\u1e33\xe0en\xe2 ve a\u1e25b\xe2bene'l-m\xfc'min\xeene'l-mu\u1e2bli\u0161\xeene mine'n-n\xe2r."},{text:"Avu\xe7 i\xe7leri a\u015fa\u011f\u0131ya \xe7evrilerek devam edilir:"},{latin:"Ve min-k\xfclli n\xe2r va\u1e25fe\u1e93n\xe2 min-\u015ferri'n-nefsi ve'\u015f-\u015fey\u1e6d\xe2n ve min-\u015ferri'l-cinni ve'l-ins\xe2n ve min-\u015ferri'l-bid\u02bfati ve'\u1e0d-\u1e0dal\xe2l\xe2ti ve'l-il\u1e25\xe2di ve'\u1e6d-\u1e6du\u011fy\xe2n."},{text:"Avu\xe7lar tekrar yukar\u0131 gelecek \u015fekilde dua \u015f\xf6ylece tamamlan\u0131r:"},{latin:"Bi-\u02bfafvike y\xe2 M\xfcc\xeer, bi-fa\u1e0dlike y\xe2 \u011eaff\xe2r bi-ra\u1e25metike y\xe2 Er\u1e25ame'r-r\xe2\u1e25im\xeen. Allah\xfcmme'd-\u1e2b\u0131lne'l-Cennete me\u02bf\xe2'l-ebr\xe2r, bi-\u015fef\xe2\u02bfati nebiyyike'l-mu\u1e2bt\xe2r. \xc2min, ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\xc2lem\xeen."}]},{id:"hasr_suresi",title:"",content:[{text:"Ha\u015fr S\xfbresi'nin 20-24. \xc2yetleri okunur:"},{latin:"L\xe2 yestev\xee a\u0161\u1e25\xe2b\xfc'n-n\xe2ri ve a\u0161\u1e25\xe2b\xfc'l-Cenneh. A\u0161\u1e25\xe2b\xfc'l-Cenneti h\xfcm\xfc'l-f\xe2iz\xfbn. Lev enzeln\xe2 h\xe2\u1e95e'l-\u1e32ur'\xe2ne \u02bfal\xe2 cebelin leraeyteh\xfb \u1e2b\xe2\u015fi\u02bfan m\xfcte\u0161addian min-\u1e2ba\u015fyetill\xe2h. Ve tilke'l-ems\xe2l\xfc na\u1e0drib\xfch\xe2 linn\xe2si le\u02bfalleh\xfcm yetefekker\xfbn. H\xfcvallah\xfc'l-le\u1e95\xee l\xe2 il\xe2he ill\xe2 h\xfb. \u02bf\xc2lim\xfc'l-\u011faybi ve'\u015f-\u015feh\xe2deti. H\xfcve'r-Ra\u1e25m\xe2n\xfc'r-Ra\u1e25\xeem. H\xfcvall\xe2h\xfc'l-le\u1e95\xee l\xe2 il\xe2he ill\xe2 h\xfb. El-Melik\xfc'l-\u1e32udd\xfbs\xfc's-Sel\xe2m\xfc'l-M\xfc'min\xfc'l-M\xfcheymin\xfc'l-\u02bfAz\xeez\xfc'l-Cebb\xe2r\xfc'l-M\xfctekebbir. S\xfcb\u1e25\xe2nell\xe2hi \u02bfamm\xe2 y\xfc\u015frik\xfbn. H\xfcvall\xe2h\xfc'l-\u1e2a\xe0li\u1e33u'l-B\xe2ri\xfc'l-M\xfc\u0161avviru leh\xfc'l-Esm\xe2\xfc'l-\u1e24\xfcsn\xe2. Y\xfcsebbi\u1e25u leh\xfb m\xe2 fi's-sem\xe2v\xe2ti ve'l-ar\u1e0di. Ve h\xfcve'l-\u02bfAz\xeez\xfc'l-\u1e24ak\xeem."}]},{id:"fatiha",title:"",content:[{text:"Fatiha-i \u015eerife ile tesbihat tamamlan\u0131r:"},{latin:"Bismillahirrahm\xe2nirrah\xeem. Elhamd\xfclill\xe2hi rabbil'alemin. Errahm\xe2nir'rahim. M\xe2liki yevmiddin. \u0130yy\xe2ke na'bud\xfc ve iyy\xe2ke neste'\xeen. \u0130hdiness\u0131r\xe2tel m\xfcstak\xeem. S\u0131r\xe2tellezine en'amte aleyhim \u011fayrilma\u011fd\xfbbi aleyhim ve ledd\xe2ll\xeen. \xc2min."}]}]}},2449,[]);
__d(function(n,a,i,t,e,r,c){e.exports={title:"\xd6\u011fle Namaz\u0131 Tesbihat\u0131",sections:[{id:"selam_sonrasi",title:"Sel\xe2m Sonras\u0131",content:[{text:"\xd6\u011fle Namaz\u0131n\u0131n farz\u0131n\u0131 k\u0131l\u0131p, selam verdikten sonra"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u0648\u064e \u0645\u0650\u0646\u0652\u0643\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u0643\u0652\u062a\u064e \u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0644\u0627\u064e\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0643\u0652\u0631\u064e\u0627\u0645\u0650"},{text:"Denilir, eller yukar\u0131 kald\u0131r\u0131l\u0131p a\xe7\u0131larak Sal\xe2ten T\xfcnc\xeen\xe2 duas\u0131 okunur:"}]},{id:"salaten_tuncina",title:"Sal\xe2ten T\xfcnc\xeen\xe2",content:[{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0635\u064e\u0644\u0627\u064e\u0629\u064b \u062a\u064f\u0646\u0652\u062c\u06ea\u064a\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0647\u0652\u0648\u064e\u0627\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0670\u0641\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0642\u0652\u0636\u06ea\u0649 \u0644\u064e\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u062c\u064e\u0645\u06ea\u064a\u0639\u064e \u0627\u0644\u0652\u062d\u064e\u0627\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0637\u064e\u0647\u0650\u0651\u0631\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0633\u064e\u0651\u064a\u0650\u0651\u0626\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0631\u0652\u0641\u064e\u0639\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0639\u0650\u0646\u0652\u062f\u064e\u0643\u064e \u0627\u064e\u0639\u0652\u0644\u064e\u0649 \u0627\u0644\u062f\u064e\u0651\u0631\u064e\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0628\u064e\u0644\u0650\u0651\u063a\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0653\u0627 \u0627\u064e\u0642\u0652\u0635\u064e\u0649 \u0627\u0644\u0652\u063a\u064e\u0627\u064a\u064e\u0627\u062a\u0650 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064e\u0627\u062a\u0650 \u0641\u0650\u0649 \u0627\u0644\u0652\u062d\u064e\u064a\u064e\u0627\u0629\u0650 \u0648\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0627\u0644\u0652\u0645\u064e\u0645\u064e\u0627\u062a\u0650 \u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0628\u064e \u0627\u0644\u062f\u064e\u0651\u0639\u064e\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"son_sunnet_sonrasi",title:"Son S\xfcnnet Sonras\u0131",content:[{text:"Akabinde \xd6\u011fle Namaz\u0131n\u0131n son s\xfcnneti k\u0131l\u0131n\u0131p; Sal\xe2vat-\u0131 \u015eerife getirilip, bu dua okunur:"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0648\u064e\u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0623\u064e\u0643\u0652\u0628\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0627 \u062d\u064e\u0648\u0652\u0644\u064e \u0648\u064e\u0644\u064e\u0627 \u0642\u064f\u0648\u064e\u0651\u0629\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u0650"}]},{id:"ayetel_kursi",title:"\xc2yet\xfc'l K\xfcrs\xee",content:[{text:"\xc2yet\xfc'l K\xfcrs\xee (Bakara S\xfbresi 255) okunur:"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0647\u064f\u0648\u064e\u06da \u0627\u064e\u0644\u0652\u062d\u064e\u064a\u064f\u0651 \u0627\u0644\u0652\u0642\u064e\u064a\u064f\u0651\u0648\u0645\u064f\u06da \u0644\u064e\u0627 \u062a\u064e\u0623\u0652\u062e\u064f\u0630\u064f\u0647\u064f \u0633\u0650\u0646\u064e\u0629\u064c \u0648\u064e\u0644\u064e\u0627 \u0646\u064e\u0648\u0652\u0645\u064c\u06dc \u0644\u064e\u0647\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650\u06dc \u0645\u064e\u0646\u0652 \u0630\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a \u064a\u064e\u0634\u0652\u0641\u064e\u0639\u064f \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0650\u0630\u0652\u0646\u0650\u0647\u06ea\u06dc \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e \u0627\u064e\u064a\u0652\u062f\u06ea\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u0652\u0641\u064e\u0647\u064f\u0645\u0652\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u062d\u06ea\u064a\u0637\u064f\u0648\u0646\u064e \u0628\u0650\u0634\u064e\u064a\u0652\u0621\u064d \u0645\u0650\u0646\u0652 \u0639\u0650\u0644\u0652\u0645\u0650\u0647\u06ea\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0645\u064e\u0627 \u0634\u064e\u0653\u0627\u0621\u064e\u06da \u0648\u064e\u0633\u0650\u0639\u064e \u0643\u064f\u0631\u0652\u0633\u0650\u064a\u064f\u0651\u0647\u064f \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0624\u064f\u06eb\u062f\u064f\u0647\u064f \u062d\u0650\u0641\u0652\u0638\u064f\u0647\u064f\u0645\u064e\u0627\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u064f\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u06ea\u064a\u0645\u064f"}]},{id:"tesbihat_33",title:"Tesbihat",content:[{text:"Daha sonra"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u064e\u0643\u0652\u0628\u064e\u0631\u064f",instruction:"33 defa tesbihleri \xe7ekilir.",count:33}]},{id:"tevhid",title:"Kelime-i Tevhid",content:[{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u0627\u064e \u0634\u064e\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0647\u064f \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u064a\u064f\u062d\u0652\u064a\u0650\u0649 \u0648\u064e\u064a\u064f\u0645\u0650\u064a\u062a\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0649\u064c\u0651 \u0644\u0627\u064e \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c \u0648\u064e\u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0627\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f"},{text:"Denildikten sonra dua edilir. Duadan sonra bir defa"},{arabic:"\u0641\u064e\u0627\u0639\u0652\u0644\u064e\u0645\u0652 \u0627\u064e\u0646\u064e\u0651\u0647\u064f",instruction:"diyerek kelime-i tevhide ge\xe7ilir."},{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f",instruction:"33 defa okunur.",count:33},{arabic:"\u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064c \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u064e",instruction:"diyerek tamamlan\u0131r."}]},{id:"salavat",title:"Sal\xe2vat-\u0131 \u015eerife",content:[{text:"Ve tesbihata \u015f\xf6ylece devam edilir:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0627\u0650\u0646\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0648\u064e \u0645\u064e\u0644\u064e\u0653\u0626\u0650\u0643\u064e\u062a\u064e\u0647\u064f \u064a\u064f\u0635\u064e\u0644\u064f\u0651\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0646\u064e\u0651\u0628\u0650\u0649\u0650\u0651 \u064a\u064e\u0653\u0627 \u0627\u064e\u064a\u064f\u0651\u0647\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0627 \u0635\u064e\u0644\u064f\u0651\u0648\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u064f\u0648\u0627 \u062a\u064e\u0633\u0652\u0644\u06ea\u064a\u0645\u064b\u0627 \u066d \u0644\u064e\u0628\u064e\u0651\u064a\u0652\u0643\u064e"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u064a\u064e\u0627 \u0631\u064e\u0628\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u062d\u064e\u0628\u06ea\u064a\u0628\u0650\u0643\u064e \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0646\u0652\u0628\u0650\u064a\u064e\u0653\u0627\u0621\u0650 \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0631\u0652\u0633\u064e\u0644\u06ea\u064a\u0646\u064e \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0643\u064f\u0644\u064d\u0651 \u0648\u064e \u0635\u064e\u062d\u0652\u0628\u0650 \u0643\u064f\u0644\u064d\u0651 \u0627\u064e\u062c\u0652\u0645\u064e\u0639\u06ea\u064a\u0646\u064e\n\n\u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"},{arabic:"\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0628\u06ea\u064a\u0628\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u062d\u0652\u0649\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0648\u064e \u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650\u0647\u06ea \u0648\u064e \u0623\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u0650\u0647\u0650 \u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0627\u064e\u0648\u0652\u0631\u064e\u0627\u0642\u0650 \u0627\u0652\u0644\u0627\u064e\u0634\u0652\u062c\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u064e\u0645\u0652\u0648\u064e\u0627\u062c\u0650 \u0627\u0644\u0652\u0628\u0650\u062d\u064e\u0627\u0631\u0650 \u0648\u064e \u0642\u064e\u0637\u064e\u0631\u064e\u0627\u062a\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u0652\u0637\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u063a\u0652\u0641\u0650\u0631\u0652\u0644\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u0631\u0652\u062d\u064e\u0645\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u0644\u0652\u0637\u064f\u0641\u0652 \u0628\u0650\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0627\u064f\u0633\u0652\u062a\u064e\u0627\u062f\u0650\u0646\u064e\u0627 \u0633\u064e\u0639\u06ea\u064a\u062f\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0652\u0633\u06ea\u0649 \u0631\u064e\u0636\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0637\u064e\u0644\u064e\u0628\u064e\u0629\u0650 \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0627\u0644\u0635\u064e\u0651\u062f\u0650\u0642\u06ea\u064a\u0646\u064e \u064a\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e\u0646\u064e\u0627 \u0628\u0650\u0643\u064f\u0644\u0650\u0651 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0645\u0650\u0646\u0652\u0647\u064e\u0653\u0627 \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u0652 \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u064e\u0651 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064b\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u0652"}]},{id:"ism_azam",title:"\u0130sm-i A'z\xe2m Duas\u0131",content:[{text:"\u0130sm-i A'z\xe2m duas\u0131 okunur:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u064a\u064e\u0627 \u062c\u064e\u0645\u06ea\u064a\u0644\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0642\u064e\u0631\u06ea\u064a\u0628\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0628\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u062d\u064e\u0628\u06ea\u064a\u0628\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0631\u064e\u0624\u064f\u0641\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0639\u064e\u0637\u064f\u0648\u0641\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064e\u0639\u0652\u0631\u064f\u0648\u0641\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0644\u064e\u0637\u06ea\u064a\u0641\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0639\u064e\u0638\u06ea\u064a\u0645\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u062d\u064e\u0646\u064e\u0651\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064e\u0646\u064e\u0651\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u062f\u064e\u064a\u064e\u0651\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u064e\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0628\u064f\u0631\u0652\u0647\u064e\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0633\u064f\u0644\u0652\u0637\u064e\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064f\u0633\u0652\u062a\u064e\u0639\u064e\u0627\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0645\u064f\u062d\u0652\u0633\u0650\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064f\u062a\u064e\u0639\u064e\u0627\u0644\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0631\u064e\u062d\u06ea\u064a\u0645\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0643\u064e\u0631\u06ea\u064a\u0645\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0645\u064e\u062c\u06ea\u064a\u062f\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0641\u064e\u0631\u0652\u062f\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0648\u0650\u062a\u0652\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0653\u0627 \u0627\u064e\u062d\u064e\u062f\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0635\u064e\u0645\u064e\u062f\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0645\u064e\u062d\u0652\u0645\u064f\u0648\u062f\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0635\u064e\u0627\u062f\u0650\u0642\u064e \u0627\u0644\u0652\u0648\u064e\u0639\u0652\u062f\u0650 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0639\u064e\u0644\u0650\u0649\u064f\u0651 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u063a\u064e\u0646\u0650\u0649\u064f\u0651 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0634\u064e\u0627\u0641\u06ea\u0649 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0643\u064e\u0627\u0641\u06ea\u0649 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0645\u064f\u0639\u064e\u0627\u0641\u06ea\u0649 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0628\u064e\u0627\u0642\u06ea\u0649 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0647\u064e\u0627\u062f\u06ea\u0649 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0642\u064e\u0627\u062f\u0650\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0633\u064e\u0627\u062a\u0650\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u0642\u064e\u0647\u064e\u0651\u0627\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u062c\u064e\u0628\u064e\u0651\u0627\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\n\n\u064a\u064e\u0627 \u063a\u064e\u0641\u064e\u0651\u0627\u0631\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0641\u064e\u062a\u064e\u0651\u0627\u062d\u064f \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f"}]},{id:"ism_azam_dua",title:"",content:[{text:"Avu\xe7lar yukar\u0131 gelecek \u015fekilde eller a\xe7\u0131l\u0131r:"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0628\u064e\u0651 \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u064e\u0631\u0652\u0636\u0650 \u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0644\u0627\u064e\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0643\u0652\u0631\u064e\u0627\u0645\u0650\n\n\u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u062d\u064e\u0642\u0650\u0651 \u0647\u0670\u0630\u0650\u0647\u0650 \u0627\u0652\u0644\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0621\u0650 \u0643\u064f\u0644\u0650\u0651\u0647\u064e\u0653\u0627 \u0627\u064e\u0646\u0652 \u062a\u064f\u0635\u064e\u0644\u0650\u0651\u0649\u064e \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e \u0639\u064e\u0644\u0670\u0653\u0649 \u0627\u0670\u0644\u0650 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e \u0627\u0631\u0652\u062d\u064e\u0645\u0652 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064b\u0627 \u0643\u064e\u0645\u064e\u0627 \u0635\u064e\u0644\u064e\u0651\u064a\u0652\u062a\u064e \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u0652\u062a\u064e \u0648\u064e \u0628\u064e\u0627\u0631\u064e\u0643\u0652\u062a\u064e \u0648\u064e \u0631\u064e\u062d\u0650\u0645\u0652\u062a\u064e \u0648\u064e \u062a\u064e\u0631\u064e\u062d\u064e\u0651\u0645\u0652\u062a\u064e \u0639\u064e\u0644\u0670\u0653\u0649 \u0627\u0650\u0628\u0631\u064e\u0627\u0647\u06ea\u064a\u0645\u064e \u0648\u064e \u0639\u064e\u0644\u0670\u0653\u0649 \u0627\u0670\u0644\u0650 \u0627\u0650\u0628\u0652\u0631\u064e\u0627\u0647\u06ea\u064a\u0645\u064e \u0641\u0650\u0649 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e \u0631\u064e\u0628\u064e\u0651\u0646\u064e\u0653\u0627 \u0627\u0650\u0646\u064e\u0651\u0643\u064e \u062d\u064e\u0645\u06ea\u064a\u062f\u064c \u0645\u064e\u062c\u06ea\u064a\u062f\u064c \u0628\u0650\u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0631\u0652\u062d\u064e\u0645\u064e \u0627\u0644\u0631\u064e\u0651\u0627\u062d\u0650\u0645\u06ea\u064a\u0646\u064e \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"fetih_suresi",title:"Fetih S\xfbresi (27-29)",content:[{text:"Fetih S\xfbresi'nin 27-29. \xc2yetleri okunur:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0644\u064e\u0642\u064e\u062f\u0652 \u0635\u064e\u062f\u064e\u0642\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f \u0627\u0644\u0631\u064f\u0651\u0621\u0652\u064a\u064e\u0627 \u0628\u0650\u0627\u0644\u0652\u062d\u064e\u0642\u0650\u0651\u06da \u0644\u064e\u062a\u064e\u062f\u0652\u062e\u064f\u0644\u064f\u0646\u064e\u0651 \u0627\u0644\u0652\u0645\u064e\u0633\u0652\u062c\u0650\u062f\u064e \u0627\u0644\u0652\u062d\u064e\u0631\u064e\u0627\u0645\u064e \u0627\u0650\u0646\u0652 \u0634\u064e\u0653\u0627\u0621\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0670\u0645\u0650\u0646\u06ea\u064a\u0646\u064e\u06d9 \u0645\u064f\u062d\u064e\u0644\u0650\u0651\u0642\u06ea\u064a\u0646\u064e \u0631\u064f\u0648\u064f\u06eb\u0654\u0633\u064e\u0643\u064f\u0645\u0652 \u0648\u064e\u0645\u064f\u0642\u064e\u0635\u0650\u0651\u0631\u06ea\u064a\u0646\u064e\u06d9 \u0644\u0627\u064e \u062a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e\u06dc \u0641\u064e\u0639\u064e\u0644\u0650\u0645\u064e \u0645\u064e\u0627 \u0644\u064e\u0645\u0652 \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0627 \u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u0652 \u062f\u064f\u0648\u0646\u0650 \u0630\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u062a\u0652\u062d\u064b\u0627 \u0642\u064e\u0631\u06ea\u064a\u0628\u064b\u0627"},{arabic:"\u0647\u064f\u0648\u064e \u0627\u0644\u064e\u0651\u0630\u06ea\u0653\u0649 \u0627\u064e\u0631\u0652\u0633\u064e\u0644\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f \u0628\u0650\u0627\u0644\u0652\u0647\u064f\u062f\u0670\u0649 \u0648\u064e\u062f\u06ea\u064a\u0646\u0650 \u0627\u0644\u0652\u062d\u064e\u0642\u0650\u0651 \u0644\u0650\u064a\u064f\u0638\u0652\u0647\u0650\u0631\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u062f\u0651\u06ea\u064a\u0646\u0650 \u0643\u064f\u0644\u0650\u0651\u0647\u06ea\u06dc \u0648\u064e\u0643\u064e\u0641\u0670\u0649 \u0628\u0650\u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0634\u064e\u0647\u06ea\u064a\u062f\u064b\u06dc\u0627"},{arabic:"\u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064c \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650\u06dc \u0648\u064e\u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0645\u064e\u0639\u064e\u0647\u064f\u0653 \u0627\u064e\u0634\u0650\u062f\u064e\u0651\u0653\u0627\u0621\u064f \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0652\u0643\u064f\u0641\u064e\u0651\u0627\u0631\u0650 \u0631\u064f\u062d\u064e\u0645\u064e\u0653\u0627\u0621\u064f \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u062a\u064e\u0631\u0670\u064a\u0647\u064f\u0645\u0652 \u0631\u064f\u0643\u064e\u0651\u0639\u064b\u0627 \u0633\u064f\u062c\u064e\u0651\u062f\u064b\u0627 \u064a\u064e\u0628\u0652\u062a\u064e\u063a\u064f\u0648\u0646\u064e \u0641\u064e\u0636\u0652\u0644\u0627\u064b \u0645\u0650\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0648\u064e\u0631\u0650\u0636\u0652\u0648\u064e\u0627\u0646\u064b\u06d8\u0627 \u0633\u06ea\u064a\u0645\u064e\u0627\u0647\u064f\u0645\u0652 \u0641\u06ea\u0649 \u0648\u064f\u062c\u064f\u0648\u0647\u0650\u0647\u0650\u0645\u0652 \u0645\u0650\u0646\u0652 \u0627\u064e\u062b\u064e\u0631\u0650 \u0627\u0644\u0633\u064f\u0651\u062c\u064f\u0648\u062f\u0650\u06dc \u0630\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u062b\u064e\u0644\u064f\u0647\u064f\u0645\u0652 \u0641\u0650\u0649 \u0627\u0644\u062a\u064e\u0651\u0648\u0652\u0631\u0670\u064a\u0629\u0650\u06da\u06db \u0648\u064e\u0645\u064e\u062b\u064e\u0644\u064f\u0647\u064f\u0645\u0652 \u0641\u0650\u0649 \u0627\u0652\u0644\u0627\u0650\u0646\u0652\u062c\u06ea\u064a\u0644\u0650\u06e0\u06db \u0643\u064e\u0632\u064e\u0631\u0652\u0639\u064d \u0627\u064e\u062e\u0652\u0631\u064e\u062c\u064e \u0634\u064e\u0637\u0652\u0626\u064e\u0647\u064f \u0641\u064e\u0627\u0670\u0632\u064e\u0631\u064e\u0647\u064f \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u063a\u0652\u0644\u064e\u0638\u064e \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0648\u0670\u0649 \u0639\u064e\u0644\u0670\u0649 \u0633\u064f\u0648\u0642\u0650\u0647\u06ea \u064a\u064f\u0639\u0652\u062c\u0650\u0628\u064f \u0627\u0644\u0632\u064f\u0651\u0631\u064e\u0651\u0627\u0639\u064e \u0644\u0650\u064a\u064e\u063a\u06ea\u064a\u0638\u064e \u0628\u0650\u0647\u0650\u0645\u064f \u0627\u0644\u0652\u0643\u064f\u0641\u064e\u0651\u0627\u0631\u064e\u06dc \u0648\u064e\u0639\u064e\u062f\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0627 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627 \u0627\u0644\u0635\u064e\u0651\u0627\u0644\u0650\u062d\u064e\u0627\u062a\u0650 \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0645\u064e\u063a\u0652\u0641\u0650\u0631\u064e\u0629\u064b \u0648\u064e\u0627\u064e\u062c\u0652\u0631\u064b\u0627 \u0639\u064e\u0638\u06ea\u064a\u0645\u064b\u0627"}]},{id:"fatiha",title:"F\xe2tiha-i \u015eer\xeefe",content:[{text:"Fatiha-i \u015eerife ile tesbihat tamamlan\u0131r:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650\n\u0627\u064e\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e\u06d9\n\u0627\u064e\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650\u06d9\n\u0645\u064e\u0627\u0644\u0650\u0643\u0650 \u064a\u064e\u0648\u0652\u0645\u0650 \u0627\u0644\u062f\u0651\u06ea\u064a\u0646\u0650\u06dc\n\u0627\u0650\u064a\u064e\u0651\u0627\u0643\u064e \u0646\u064e\u0639\u0652\u0628\u064f\u062f\u064f \u0648\u064e\u0627\u0650\u064a\u064e\u0651\u0627\u0643\u064e \u0646\u064e\u0633\u0652\u062a\u064e\u0639\u06ea\u064a\u0646\u064f\u06dc\n\u0627\u0650\u0647\u0652\u062f\u0650\u0646\u064e\u0627 \u0627\u0644\u0635\u0650\u0651\u0631\u064e\u0627\u0637\u064e \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u062a\u064e\u0642\u06ea\u064a\u0645\u064e\u06d9\n\u0635\u0650\u0631\u064e\u0627\u0637\u064e \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u064e\u0646\u0652\u0639\u064e\u0645\u0652\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652\u06d9 \u063a\u064e\u064a\u0652\u0631\u0650 \u0627\u0644\u0652\u0645\u064e\u063a\u0652\u0636\u064f\u0648\u0628\u0650 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0648\u064e\u0644\u064e\u0627 \u0627\u0644\u0636\u064e\u0651\u0653\u0627\u0644\u0651\u06ea\u064a\u0646\u064e"}]}]}},2450,[]);
__d(function(l,e,i,a,n,m,h){n.exports={title:"\xd6\u011fle Namaz\u0131 Tesbihat\u0131 \u2013 T\xfcrk\xe7e Okunu\u015f",sections:[{id:"selam_sonrasi",title:"",content:[{text:"\xd6\u011fle Namaz\u0131n\u0131n farz\u0131n\u0131 k\u0131l\u0131p, selam verdikten sonra"},{latin:"All\xe2h\xfcmme ente's-sel\xe2m\xfc ve minke's-sel\xe2m, teb\xe2rekte y\xe2 \u1e95e'l-cel\xe2li ve'l-ikr\xe2m"},{text:"Denilir, eller yukar\u0131 kald\u0131r\u0131l\u0131p a\xe7\u0131larak Sal\xe2ten T\xfcnc\xeen\xe2 duas\u0131 okunur:"}]},{id:"salaten_tuncina",title:"",content:[{latin:"Allah\xfcmme \u0161alli al\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. \u0160al\xe2ten t\xfcnc\xeen\xe2 bih\xe2 min-cem\xee\u02bf\u0131'l-ehv\xe2li ve'l-\xe2f\xe2t. Ve tak\u1e0d\xeelen\xe2 bi-h\xe2 cem\xee\u02bfa'l-\u1e25\xe2c\xe2t. Ve t\xfc\u1e6dahhirun\xe2 bi-h\xe2 min-cem\xee\u02bf\u0131's-seyyi\xe2t. Ve terfe\u02bfun\xe2 bi-h\xe2 \u02bfindeke a\u02bfle'd-derec\xe2t. Ve t\xfcbelli\u011fun\xe2 bi-h\xe2 a\u1e33\u0161a'l-\u011f\xe2y\xe2t. Min-cem\xee\u02bfi'l-\u1e2bayr\xe2ti fi'l-\u1e25ay\xe2ti ve ba\u02bfde'l-mem\xe2t. \xc2min y\xe2 Muc\xeebe'd-de\u02bfav\xe2ti ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\u02bf\xe2lem\xeen."}]},{id:"son_sunnet_sonrasi",title:"",content:[{text:"Akabinde \xd6\u011fle Namaz\u0131n\u0131n son s\xfcnneti k\u0131l\u0131n\u0131p; Sal\xe2vat-\u0131 \u015eerife getirilip, bu dua okunur:"},{latin:"S\xfcb\u1e25\xe2nallahi vel\u1e25amd\xfc lill\xe2hi ve l\xe2 il\xe2he ill\xe2llah\xfc vallah\xfc ekber ve l\xe2 \u1e25avle ve l\xe2 \u1e33uvvete ill\xe2 bill\xe2hi'l-\u02bfaliyyi'l-\u02bfa\u1e93\xeem"}]},{id:"ayetel_kursi",title:"",content:[{text:"\xc2yet\xfc'l K\xfcrs\xee (Bakara S\xfbresi 255) okunur:"},{latin:"All\xe2h\xfc l\xe2 il\xe2he ill\xe2 h\xfcvel hayy\xfcl kayy\xfbm, l\xe2 te'huz\xfchu sinet\xfcn vel\xe2 nevm, lehu m\xe2 fissem\xe2v\xe2ti ve ma fil'ard, men zellezi ye\u015ffeu indehu ill\xe2 bi'iznih, ya'lem\xfc m\xe2 beyne eydihim vem\xe2 halfeh\xfcm, vel\xe2 y\xfc-h\xeet\xfbne bi'\u015fey'in min ilmih\xee ill\xe2 bima \u015f\xe2e vesia k\xfcrsiyy\xfch\xfcssem\xe2v\xe2ti vel'ard, vel\xe2 ye\xfbd\xfch\xfb h\u0131fzuh\xfcm\xe2 ve h\xfcvel aliyy\xfcl azim."}]},{id:"tesbihat_33",title:"",content:[{text:"Daha sonra 33 defa S\xfcb\u1e25\xe2nall\xe2h, 33 defa El\u1e25amd\xfclill\xe2h, 33 defa All\xe2h\xfc Ekber tesbihleri \xe7ekilir."},{latin:"L\xe2 il\xe2he ill\xe2llah\xfc, va\u1e25deh\xfb, l\xe2 \u015fer\xeeke leh, leh\xfc'l-m\xfclk\xfc ve leh\xfc'l-\u1e25amd\xfc, yu\u1e25y\xee ve y\xfcm\xeet ve h\xfcve \u1e25ayy\xfcn l\xe2 yem\xfbt, bi-yedihi'l-\u1e2bayru ve h\xfcve \u02bfal\xe2 k\xfclli \u015fey'in \u1e33ad\xeer ve ileyhi'l-ma\u0161\xeer"},{text:"Denildikten sonra dua edilir. Duadan sonra bir defa Fa\u02bflem ennehu diyerek kelime-i tevhide ge\xe7ilir."},{text:"33 defa L\xe2 il\xe2he ill\xe2llah okunduktan sonra Mu\u1e25ammed\xfc'r-res\xfbl\xfcll\xe2hi \u0161all\xe2llah\xfc te\u02bf\xe2l\xe2 \u02bfaleyhi vesellem diyerek tamamlan\u0131r."}]},{id:"salavat",title:"",content:[{text:"Ve tesbihata \u015f\xf6ylece devam edilir:"},{latin:"Bismill\xe2hirra\u1e25m\xe2nirra\u1e25\xeem.\n\n\u0130nnall\xe2he ve mel\xe2iketeh\xfb y\xfc\u0161all\xfbne \u02bfale'n-nebiy. Y\xe2 eyy\xfchelle\u1e95\xeene \xe2men\xfb \u0161all\xfb \u02bfaleyhi ve sellim\xfb tesl\xeem\xe2. Lebbeyk."},{latin:"Allah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeer\xe2.\nAllah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeer\xe2.\nAllah\xfcmme \u0161alli \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li seyyidin\xe2 Mu\u1e25ammed. Bi\u02bfadedi k\xfclli d\xe2in ve dev\xe2in ve b\xe2rik ve sellim \u02bfaleyhi ve \u02bfaleyhim kes\xeeran kes\xeer\xe2."},{latin:"\u0160alli ve sellim y\xe2 Rabbi 'al\xe2 \u1e25ab\xeebike Mu\u1e25ammedin ve \u02bfal\xe2 cem\xee\u02bf\u0131'l-enbiy\xe2i ve'l-m\xfcrsel\xeen ve \u02bfal\xe2 \xe2li k\xfcllin ve \u0161ahbi k\xfcllin ecma\u02bf\xeen. \xc2min ve'l-\u1e25amd\xfc lill\xe2hi Rabbi'l-\xe2lem\xeen."},{latin:"Elf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 Res\xfblallah.\nElf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 \u1e24ab\xeeballah.\nElf\xfc elfi \u0161al\xe2tin ve elf\xfc elfi sel\xe2min \u02bfaleyke y\xe2 em\xeene va\u1e25yill\xe2h."},{latin:"Allah\xfcmme \u0161alli ve sellim ve b\xe2rik \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2lih\xee ve a\u0161\u1e25\xe2bih\xee bi-\u02bfadedi evra\u1e33\u0131'l-e\u015fc\xe2r ve emv\xe2ci'l-bi\u1e25\xe2r ve \u1e33a\u1e6dar\xe2ti'l-em\u1e6d\xe2r va\u011ffir len\xe2 ver\u1e25amn\xe2 vel\u1e6duf bin\xe2 ve bi-\xdcst\xe2\u1e95in\xe2 Sa\u02bf\xeedi'n-Nurs\xee (ra\u1e0diyallahu \u02bfanh) ve v\xe2lideyn\xe2 ve bi-\u1e6dalebeti Res\xe2ili'n-Nuri'\u0161-\u0161ad\u0131\u1e33\xeene y\xe2 il\xe2hen\xe2 bi-k\xfclli \u0161al\xe2tin minh\xe2 e\u015fhed\xfc en-l\xe2 il\xe2he ill\xe2llah ve e\u015fhed\xfc enne Mu\u1e25ammeden Res\xfbl\xfcll\xe2hi \u0160allall\xe2h\xfc \u02bfAleyhi Vesellem."}]},{id:"ism_azam",title:"\u0130sm-i A'z\xe2m Duas\u0131",content:[{text:"\u0130sm-i A'z\xe2m duas\u0131 okunur:"},{latin:"Bismill\xe2hirra\u1e25m\xe2nirra\u1e25\xeem"},{latin:"Y\xe2 Cem\xeelu y\xe2 Allah, Y\xe2 \u1e32ar\xeebu y\xe2 Allah\nY\xe2 Muc\xeebu y\xe2 Allah, Y\xe2 \u1e24ab\xeebu y\xe2 Allah\nY\xe2 Ra\xfbfu y\xe2 Allah, Y\xe2 \u02bfA\u1e6d\xfbfu y\xe2 Allah\nY\xe2 Ma\u02bfr\xfbfu y\xe2 Allah, Y\xe2 L\xe2\u1e6d\xeefu y\xe2 Allah\nY\xe2 \u02bfA\u1e93\xeemu y\xe2 Allah, Y\xe2 \u1e24ann\xe2nu y\xe2 Allah\nY\xe2 Menn\xe2nu y\xe2 Allah, Y\xe2 Deyy\xe2nu y\xe2 Allah\nY\xe2 S\xfcb\u1e25\xe2nu y\xe2 Allah, Y\xe2 Em\xe2nu y\xe2 Allah\nY\xe2 B\xfcrh\xe2nu y\xe2 Allah, Y\xe2 Sul\u1e6d\xe2nu y\xe2 Allah\nY\xe2 M\xfcste\u02bf\xe2nu y\xe2 Allah, Y\xe2 Mu\u1e25sinu y\xe2 Allah\nY\xe2 M\xfcte\u02bf\xe2lu y\xe2 Allah, Y\xe2 Ra\u1e25m\xe2nu y\xe2 Allah\nY\xe2 Ra\u1e25\xeemu y\xe2 Allah, Y\xe2 Ker\xeemu y\xe2 Allah\nY\xe2 Mec\xeedu y\xe2 Allah, Y\xe2 Ferdu y\xe2 Allah\nY\xe2 Vitru y\xe2 Allah, Y\xe2 E\u1e25adu y\xe2 Allah\nY\xe2 \u0160amedu y\xe2 Allah, Y\xe2 Ma\u1e25m\xfbdu y\xe2 Allah\nY\xe2 \u0160\xe2d\u0131\u1e33a'l-Va\u02bfdi y\xe2 Allah, Y\xe2 \u02bfAliyyu y\xe2 Allah\nY\xe2 \u011eaniyyu y\xe2 Allah, Y\xe2 \u015e\xe2f\xee y\xe2 Allah\nY\xe2 K\xe2f\xee y\xe2 Allah, Y\xe2 Mu\u02bf\xe2f\xee y\xe2 Allah\nY\xe2 B\xe2\u1e33\xee y\xe2 Allah, Y\xe2 H\xe2d\xee y\xe2 Allah\nY\xe2 \u1e32\xe0diru y\xe2 Allah, Y\xe2 S\xe2tiru y\xe2 Allah\nY\xe2 \u1e32ahh\xe2ru y\xe2 Allah, Y\xe2 Cebb\xe2ru y\xe2 Allah\nY\xe2 \u011eaff\xe2ru y\xe2 Allah, Y\xe2 Fett\xe2\u1e25u y\xe2 Allah"}]},{id:"ism_azam_dua",title:"",content:[{text:"Avu\xe7lar yukar\u0131 gelecek \u015fekilde eller a\xe7\u0131l\u0131r:"},{latin:"Y\xe2 Rabbe's-sem\xe2v\xe2ti ve'l-ar\u1e0d\u0131, y\xe2 \u1e95e'l-cel\xe2li ve'l-ikr\xe2m. Es'el\xfcke bi-\u1e25a\u1e33\u1e33\u0131 h\xe2\u1e95ihi'l-esm\xe2i k\xfcllih\xe2 ent\xfc\u0161alliye \u02bfal\xe2 seyyidin\xe2 Mu\u1e25ammedin ve \u02bfal\xe2 \xe2li Mu\u1e25ammedin ver\u1e25am Mu\u1e25ammeden kem\xe2 \u0161alleyte ve sellemte ve b\xe2rekte ve ra\u1e25imte ve tera\u1e25\u1e25amte \u02bfal\xe2 \u0130br\xe2h\xeeme ve \u02bfal\xe2 \xe2li \u0130br\xe2h\xeeme fi'l-\u02bf\xe2lem\xeen, Rabben\xe2 inneke \u1e25am\xeed\xfc'm-mec\xeed, bi-ra\u1e25metike y\xe2 er\u1e25amerr\xe2\u1e25im\xeen, ve'l-\u1e25amd\xfclill\xe2hi Rabbi'l-\u02bf\xe2lem\xeen."}]},{id:"fetih_suresi",title:"",content:[{text:"Fetih S\xfbresi'nin 27-29. \xc2yetleri okunur:"},{latin:"Bismillahirrahm\xe2nirrah\xeem. Le\u1e33ad \u0161ada\u1e33all\xe2h\xfc res\xfbleh\xfc'r-r\xfc'y\xe2 bi'l-ha\u1e33\u1e33i leted\u1e2bul\xfcnne'l-mescide'l-\u1e25ar\xe2me in\u015f\xe2all\xe2h\xfc \xe2min\xeene mu\u1e25alli\u1e33\xeene ru\xfbsek\xfcm ve mu\u1e33a\u0161\u0161\u0131r\xeene l\xe2 te\u1e2baf\xfbne, fe\u02bfalime m\xe2 lem ta'lem\xfb feca\u02bfale min-d\xfbni \u1e95\xe2like fet\u1e25an \u1e33ar\xeeb\xe2. H\xfcvelle\u1e95\xee ersele ras\xfbleh\xfb bi'l-h\xfcd\xe2 ve d\xeeni'l-ha\u1e33\u1e33\u0131 li-yu\u1e93hirah\xfb \u02bfale'd-d\xeeni k\xfcllih\xee ve kef\xe2 bill\xe2hi \u015feh\xeed\xe2. Mu\u1e25ammed\xfc'r-res\xfbl\xfcll\xe2hi ve'lle\u1e95\xeene me\u02bfah\xfb e\u015fidd\xe2\xfc \u02bfale'l-k\xfcff\xe2ri ru\u1e25am\xe2\xfc beyneh\xfcm ter\xe2h\xfcm rukke\u02bfan s\xfccceden yebte\u011f\xfbne fa\u1e0dlem-minall\xe2hi ve r\u0131\u1e0dv\xe2n\xe2, s\xeem\xe2h\xfcm f\xee-v\xfcc\xfbhihim min-eseri's-s\xfcc\xfbd. \u1e94\xe2like mesel\xfch\xfcm fi't-tevr\xe2ti ve mesel\xfch\xfcm fi'l-inc\xeeli kezer\u02bfin a\u1e2brace \u015fa\u1e6d'eh\xfb fe\xe2zereh\xfb festa\u011fle\u1e93a festev\xe2 \u02bfal\xe2 s\xfb\u1e33\u0131h\xee yu\u02bfcib\xfc'z-z\xfcrr\xe2\u02bfa li-ya\u011f\xee\u1e93a bi-him\xfc'l-k\xfcff\xe2r. Ve\u02bfadall\xe2h\xfc'l-le\u1e95\xeene \xe2men\xfc ve \u02bfamil\xfc'\u0161-\u0161\xe2li\u1e25\xe2ti minhum ma\u011ffiraten ve ecran \u02bfa\u1e93\xeem\xe2."}]},{id:"fatiha",title:"",content:[{text:"Fatiha-i \u015eerife ile tesbihat tamamlan\u0131r:"},{latin:"Bismillahirrahm\xe2nirrah\xeem. Elhamd\xfclill\xe2hi rabbil'alemin. Errahm\xe2nir'rahim. M\xe2liki yevmiddin. \u0130yy\xe2ke na'bud\xfc ve iyy\xe2ke neste'\xeen. \u0130hdiness\u0131r\xe2tel m\xfcstak\xeem. S\u0131r\xe2tellezine en'amte aleyhim \u011fayrilma\u011fd\xfbbi aleyhim ve ledd\xe2ll\xeen. \xc2min."}]}]}},2451,[]);
__d(function(a,i,n,e,r,t,c){r.exports={title:"\u0130kindi Namaz\u0131 Tesbihat\u0131",sections:[{id:"selam_sonrasi",title:"Sel\xe2m Sonras\u0131",content:[{text:"\u0130kindi Namaz\u0131n\u0131n farz\u0131n\u0131 k\u0131l\u0131p, selam verdikten sonra"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u0648\u064e \u0645\u0650\u0646\u0652\u0643\u064e \u0627\u0644\u0633\u064e\u0651\u0644\u0627\u064e\u0645\u064f \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u0643\u0652\u062a\u064e \u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0644\u0627\u064e\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0643\u0652\u0631\u064e\u0627\u0645\u0650"},{text:"Denilir, eller yukar\u0131 kald\u0131r\u0131l\u0131p a\xe7\u0131larak Sal\xe2ten T\xfcnc\xeen\xe2 duas\u0131 okunur:"}]},{id:"salaten_tuncina",title:"Sal\xe2ten T\xfcnc\xeen\xe2",content:[{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0635\u064e\u0644\u0627\u064e\u0629\u064b \u062a\u064f\u0646\u0652\u062c\u06ea\u064a\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0647\u0652\u0648\u064e\u0627\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0670\u0641\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0642\u0652\u0636\u06ea\u0649 \u0644\u064e\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u062c\u064e\u0645\u06ea\u064a\u0639\u064e \u0627\u0644\u0652\u062d\u064e\u0627\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0637\u064e\u0647\u0650\u0651\u0631\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0633\u064e\u0651\u064a\u0650\u0651\u0626\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0631\u0652\u0641\u064e\u0639\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0627 \u0639\u0650\u0646\u0652\u062f\u064e\u0643\u064e \u0627\u064e\u0639\u0652\u0644\u064e\u0649 \u0627\u0644\u062f\u064e\u0651\u0631\u064e\u062c\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064f\u0628\u064e\u0644\u0650\u0651\u063a\u064f\u0646\u064e\u0627 \u0628\u0650\u0647\u064e\u0653\u0627 \u0627\u064e\u0642\u0652\u0635\u064e\u0649 \u0627\u0644\u0652\u063a\u064e\u0627\u064a\u064e\u0627\u062a\u0650 \u0645\u0650\u0646\u0652 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064e\u0627\u062a\u0650 \u0641\u0650\u0649 \u0627\u0644\u0652\u062d\u064e\u064a\u064e\u0627\u0629\u0650 \u0648\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0627\u0644\u0652\u0645\u064e\u0645\u064e\u0627\u062a\u0650 \u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u06ea\u064a\u0628\u064e \u0627\u0644\u062f\u064e\u0651\u0639\u064e\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"}]},{id:"salavat_dua",title:"Sal\xe2vat Sonras\u0131 Dua",content:[{text:"Sal\xe2vat-\u0131 \u015eerife getirilip, bu dua okunur:"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u064e\u0651\u0647\u0650 \u0648\u064e \u0644\u064e\u0627 \u0625\u0650\u0644\u064e\u0647\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0648\u064e\u0627\u0644\u0644\u064e\u0651\u0647\u064f \u0623\u064e\u0643\u0652\u0628\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0627 \u062d\u064e\u0648\u0652\u0644\u064e \u0648\u064e\u0644\u064e\u0627 \u0642\u064f\u0648\u064e\u0651\u0629\u064e \u0625\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0644\u0644\u064e\u0651\u0647\u0650 \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u0650\u064a\u0645\u0650"}]},{id:"ayetel_kursi",title:"\xc2yet\xfc'l K\xfcrs\xee",content:[{text:"\xc2yet\xfc'l K\xfcrs\xee (Bakara S\xfbresi 255) okunur:"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u064e\u0651\u0627 \u0647\u064f\u0648\u064e\u06da \u0627\u064e\u0644\u0652\u062d\u064e\u064a\u064f\u0651 \u0627\u0644\u0652\u0642\u064e\u064a\u064f\u0651\u0648\u0645\u064f\u06da \u0644\u064e\u0627 \u062a\u064e\u0623\u0652\u062e\u064f\u0630\u064f\u0647\u064f \u0633\u0650\u0646\u064e\u0629\u064c \u0648\u064e\u0644\u064e\u0627 \u0646\u064e\u0648\u0652\u0645\u064c\u06dc \u0644\u064e\u0647\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650\u06dc \u0645\u064e\u0646\u0652 \u0630\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a \u064a\u064e\u0634\u0652\u0641\u064e\u0639\u064f \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0627\u0650\u0630\u0652\u0646\u0650\u0647\u06ea\u06dc \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e \u0627\u064e\u064a\u0652\u062f\u06ea\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u0652\u0641\u064e\u0647\u064f\u0645\u0652\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u062d\u06ea\u064a\u0637\u064f\u0648\u0646\u064e \u0628\u0650\u0634\u064e\u064a\u0652\u0621\u064d \u0645\u0650\u0646\u0652 \u0639\u0650\u0644\u0652\u0645\u0650\u0647\u06ea\u0653 \u0627\u0650\u0644\u064e\u0651\u0627 \u0628\u0650\u0645\u064e\u0627 \u0634\u064e\u0653\u0627\u0621\u064e\u06da \u0648\u064e\u0633\u0650\u0639\u064e \u0643\u064f\u0631\u0652\u0633\u0650\u064a\u064f\u0651\u0647\u064f \u0627\u0644\u0633\u064e\u0651\u0645\u0670\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e\u06da \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0624\u064f\u06eb\u062f\u064f\u0647\u064f \u062d\u0650\u0641\u0652\u0638\u064f\u0647\u064f\u0645\u064e\u0627\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u064f\u0651 \u0627\u0644\u0652\u0639\u064e\u0638\u06ea\u064a\u0645\u064f"}]},{id:"tesbihat_33",title:"Tesbihat",content:[{text:"Daha sonra"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650",instruction:"33 defa",count:33},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u064e\u0643\u0652\u0628\u064e\u0631\u064f",instruction:"33 defa tesbihleri \xe7ekilir.",count:33}]},{id:"tevhid",title:"Kelime-i Tevhid",content:[{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u062d\u0652\u062f\u064e\u0647\u064f \u0644\u0627\u064e \u0634\u064e\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0647\u064f \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u064a\u064f\u062d\u0652\u064a\u0650\u0649 \u0648\u064e\u064a\u064f\u0645\u0650\u064a\u062a\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0649\u064c\u0651 \u0644\u0627\u064e \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c \u0648\u064e\u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0627\u0644\u0652\u0645\u064e\u0635\u0650\u064a\u0631\u064f"},{text:"Denildikten sonra dua edilir. Duadan sonra bir defa"},{arabic:"\u0641\u064e\u0627\u0639\u0652\u0644\u064e\u0645\u0652 \u0627\u064e\u0646\u064e\u0651\u0647\u064f",instruction:"diyerek kelime-i tevhide ge\xe7ilir."},{arabic:"\u0644\u0627\u06e4 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f",instruction:"33 defa okunur.",count:33},{arabic:"\u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064c \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u064e",instruction:"diyerek tamamlan\u0131r."}]},{id:"salavat",title:"Sal\xe2vat-\u0131 \u015eerife",content:[{text:"Ve tesbihata \u015f\xf6ylece devam edilir:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0627\u0650\u0646\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0648\u064e \u0645\u064e\u0644\u064e\u0653\u0626\u0650\u0643\u064e\u062a\u064e\u0647\u064f \u064a\u064f\u0635\u064e\u0644\u064f\u0651\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0646\u064e\u0651\u0628\u0650\u0649\u0650\u0651 \u064a\u064e\u0653\u0627 \u0627\u064e\u064a\u064f\u0651\u0647\u064e\u0627 \u0627\u0644\u064e\u0651\u0630\u06ea\u064a\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0627 \u0635\u064e\u0644\u064f\u0651\u0648\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u064f\u0648\u0627 \u062a\u064e\u0633\u0652\u0644\u06ea\u064a\u0645\u064b\u0627 \u066d \u0644\u064e\u0628\u064e\u0651\u064a\u0652\u0643\u064e"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0643\u064f\u0644\u0650\u0651 \u062f\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u062f\u064e\u0648\u064e\u0653\u0627\u0621\u064d \u0648\u064e\u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0648\u064e\u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627 \u0643\u064e\u062b\u06ea\u064a\u0631\u064b\u0627"},{arabic:"\u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u064a\u064e\u0627 \u0631\u064e\u0628\u0650\u0651 \u0639\u064e\u0644\u0670\u0649 \u062d\u064e\u0628\u06ea\u064a\u0628\u0650\u0643\u064e \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d\n\n\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u062c\u064e\u0645\u06ea\u064a\u0639\u0650 \u0627\u0652\u0644\u0627\u064e\u0646\u0652\u0628\u0650\u064a\u064e\u0653\u0627\u0621\u0650 \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0631\u0652\u0633\u064e\u0644\u06ea\u064a\u0646\u064e \u0648\u064e \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650 \u0643\u064f\u0644\u064d\u0651 \u0648\u064e \u0635\u064e\u062d\u0652\u0628\u0650 \u0643\u064f\u0644\u064d\u0651 \u0627\u064e\u062c\u0652\u0645\u064e\u0639\u06ea\u064a\u0646\u064e\n\n\u0627\u0670\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0650\u0651 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u06ea\u064a\u0646\u064e"},{arabic:"\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0628\u06ea\u064a\u0628\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650\n\n\u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0648\u064e \u0627\u064e\u0644\u0652\u0641\u064f \u0627\u064e\u0644\u0652\u0641\u0650 \u0633\u064e\u0644\u0627\u064e\u0645\u064d \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u06ea\u064a\u0646\u064e \u0648\u064e\u062d\u0652\u0649\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650"},{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u064e\u0651 \u0635\u064e\u0644\u0650\u0651 \u0648\u064e \u0633\u064e\u0644\u0650\u0651\u0645\u0652 \u0648\u064e \u0628\u064e\u0627\u0631\u0650\u0643\u0652 \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0650\u0651\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064d \u0648\u064e\u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u0670\u0644\u0650\u0647\u06ea \u0648\u064e \u0623\u064e\u0635\u0652\u062d\u064e\u0627\u0628\u0650\u0647\u0650 \u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u0627\u064e\u0648\u0652\u0631\u064e\u0627\u0642\u0650 \u0627\u0652\u0644\u0627\u064e\u0634\u0652\u062c\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u064e\u0645\u0652\u0648\u064e\u0627\u062c\u0650 \u0627\u0644\u0652\u0628\u0650\u062d\u064e\u0627\u0631\u0650 \u0648\u064e \u0642\u064e\u0637\u064e\u0631\u064e\u0627\u062a\u0650 \u0627\u0652\u0644\u0627\u064e\u0645\u0652\u0637\u064e\u0627\u0631\u0650 \u0648\u064e \u0627\u063a\u0652\u0641\u0650\u0631\u0652\u0644\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u0631\u0652\u062d\u064e\u0645\u0652\u0646\u064e\u0627 \u0648\u064e \u0627\u0644\u0652\u0637\u064f\u0641\u0652 \u0628\u0650\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0627\u064f\u0633\u0652\u062a\u064e\u0627\u062f\u0650\u0646\u064e\u0627 \u0633\u064e\u0639\u06ea\u064a\u062f\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0652\u0633\u06ea\u0649 \u0631\u064e\u0636\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e \u0648\u064e\u0627\u0644\u0650\u062f\u064e\u064a\u0652\u0646\u064e\u0627 \u0648\u064e \u0628\u0650\u0637\u064e\u0644\u064e\u0628\u064e\u0629\u0650 \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u064f\u0651\u0648\u0631\u0650 \u0627\u0644\u0635\u064e\u0651\u062f\u0650\u0642\u06ea\u064a\u0646\u064e \u064a\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e\u0646\u064e\u0627 \u0628\u0650\u0643\u064f\u0644\u0650\u0651 \u0635\u064e\u0644\u0627\u064e\u0629\u064d \u0645\u0650\u0646\u0652\u0647\u064e\u0653\u0627 \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u0652 \u0644\u0622\u064e \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0627\u064e\u0651 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e \u0627\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0627\u064e\u0646\u064e\u0651 \u0645\u064f\u062d\u064e\u0645\u064e\u0651\u062f\u064b\u0627 \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0635\u064e\u0644\u064e\u0651\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u064e\u0651\u0645\u0652"}]},{id:"tercuman_ism_azam",title:"Terc\xfcman-\u0131 \u0130sm-i A'z\xe2m",content:[{text:"Terc\xfcman-\u0131 \u0130sm-i A'z\xe2m duas\u0131 okunur:"},{arabic:"\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u0652\u0645\u0670\u0646\u0650 \u0627\u0644\u0631\u064e\u0651\u062d\u06ea\u064a\u0645\u0650"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643 \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0643\u064e\u0631\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062d\u064e\u0645\u06ea\u064a\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062d\u064e\u0643\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064e\u062c\u06ea\u064a\u062f\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064e\u0644\u0650\u0643\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064f\u062f\u064f\u0651\u0648\u0633\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0633\u064e\u0644\u0627\u064e\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0647\u064e\u064a\u0652\u0645\u0650\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0639\u064e\u0632\u06ea\u064a\u0632\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062c\u064e\u0628\u064e\u0651\u0627\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062a\u064e\u0643\u064e\u0628\u0650\u0651\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u062e\u064e\u0627\u0644\u0650\u0642\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0648\u064e\u0651\u0644\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0653\u0627 \u0627\u0670\u062e\u0650\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0638\u064e\u0627\u0647\u0650\u0631\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0637\u0650\u0646\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0631\u0650\u0649\u0621\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0635\u064e\u0648\u0650\u0651\u0631\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u062a\u064e\u0648\u064e\u0651\u0627\u0628\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u064e\u0647\u064e\u0651\u0627\u0628\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0628\u064e\u0627\u0639\u0650\u062b\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0648\u064e\u0627\u0631\u0650\u062b\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u064e\u0651\u0627\u0631\u0650 \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f"},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0642\u064e\u062f\u06ea\u064a\u0645\u064f \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u064a\u0652\u062a\u064e \u064a\u064e\u0627 \u0645\u064f\u0642\u06ea\u064a\u0645\u064f \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u065