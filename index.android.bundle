2 hayy",meal:"Ey hi\xe7bir diriye muhta\xe7 olmayan ger\xe7ek hayat sahibi,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0649\u0651\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u0649 \u064a\u064f\u0645\u0650\u064a\u062a\u064f \u0643\u064f\u0644\u0651\u064e \u062d\u064e\u0649\u0651\u064d",latin:"Y\xe2 Hayy\xfc\u2019llez\xee y\xfcm\xeet\xfc k\xfclle hayy",meal:"Ey b\xfct\xfcn dirileri \xf6ld\xfcren ger\xe7ek hayat sahibi,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0649\u0651\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u0649 \u064a\u064e\u0631\u0652\u0632\u064f\u0642\u064f \u0643\u064f\u0644\u0651\u064e \u062d\u064e\u0649\u0651\u064d",latin:"Y\xe2 Hayy\xfc\u2019llez\xee yerz\xfcku k\xfclle hayy",meal:"Ey b\xfct\xfcn dirileri r\u0131z\u0131kland\u0131ran ger\xe7ek hayat sahibi,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0649\u0651\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u0649 \u064a\u064f\u062d\u0652\u064a\u0650\u0649 \u0627\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u0670\u0649",latin:"Y\xe2 Hayy\xfc\u2019llez\xee y\xfchyi\u2019l-mevt\xe2",meal:"Ey \xf6l\xfcleri dirilten ger\xe7ek hayat sahibi,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0649\u0651\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u0649 \u0644\u064e\u0627 \u064a\u064e\u0645\u064f\u0648\u062a\u064f",latin:"Y\xe2 Hayy\xfc\u2019llez\xee l\xe2 yem\xfbt",meal:"Ey hi\xe7 \xf6lmeyecek olan ger\xe7ek hayat sahibi,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r."