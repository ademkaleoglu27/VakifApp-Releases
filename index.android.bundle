4a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0636\u064e\u0645\u0650\u064a\u0631\u064e \u0627\u0644\u0635\u0651\u064e\u0627\u0645\u0650\u062a\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men ya\u2019lemu dam\xeera\u2019s-s\xe2mit\xeen",meal:"Ey suskunlar\u0131n i\xe7inden ge\xe7enleri bilen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0631\u0670\u0649 \u0646\u064e\u062f\u064e\u0645\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u062f\u0650\u0645\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men yer\xe2 nedeme\u2019n-n\xe2dim\xeen",meal:"Ey g\xfcnahlar\u0131ndan pi\u015fmanl\u0131k duyanlar\u0131n ned\xe2metini g\xf6ren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0642\u0652\u0628\u064e\u0644\u064f \u0639\u064f\u0630\u0652\u0631\u064e \u0627\u0644\u062a\u0651\u064e\u0653\u0627\u0626\u0650\u0628\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men yakbel\xfc \u2018uzre\u2019t-t\xe2ib\xeen",meal:"Ey t\xf6vbek\xe2rlar\u0131n \xf6zr\xfcn\xfc kabul eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0635\u0652\u0644\u0650\u062d\u064f \u0639\u064e\u0645\u064e\u0644\u064e \u0627\u0644\u0652\u0645\u064f\u0641\u0652\u0633\u0650\u062f\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men l\xe2 yuslihu \u2018amele\u2019l-m\xfcfsid\xeen",meal:"Ey fesat\xe7\u0131lar\u0131n i\u015fini d\xfczeltmeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0636\u0650\u064a\u0639\u064f \u0627\u064e\u062c\u0652\u0631\u064e \u0627\u0644\u0652\u0645\u064f\u062d\u0652\u0633\u0650\u0646\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men l\xe2 yud\xee\u2019u ecra\u2019l-muhsin\xeen",meal:"Ey iyilik yapanlar\u0131n m\xfck\xe2fat\u0131n\u0131 z\xe2yi etmeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0628\u0652\u0639\u064f\u062f\u064f \u0639\u064e\u0646\u0652 \u0642\u064f\u0644\u064f\u0648\u0628\u0650 \u0627\u0644\u0652\u0639\u06