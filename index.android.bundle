ve\u2019l-kameri\u2019l-m\xfcn\xeer",meal:"Ey g\xfcne\u015f ve nurlu ay\u0131n yarat\u0131c\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u063a\u0652\u0646\u0650\u0649\u064e \u0627\u0644\u0652\u0628\u064e\u0653\u0627\u0626\u0650\u0633\u0650 \u0627\u0644\u0652\u0641\u064e\u0642\u0650\u064a\u0631\u0650",latin:"Y\xe2 Mu\u011fniye\u2019l-b\xe2isi\u2019l-fak\xeer",meal:"Ey \u015fiddetli s\u0131k\u0131nt\u0131ya d\xfc\u015fm\xfc\u015f fakirleri zenginle\u015ftiren,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0627\u0632\u0650\u0642\u064e \u0627\u0644\u0637\u0651\u0650\u0641\u0652\u0644\u0650 \u0627\u0644\u0635\u0651\u064e\u063a\u0650\u064a\u0631\u0650",latin:"Y\xe2 R\xe2zika\u2019t-t\u0131fli\u2019s-sa\u011f\xeer",meal:"Ey k\xfc\xe7\xfck yavrulara r\u0131z\u0131k veren,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0627\u062d\u0650\u0645\u064e \u0627\u0644\u0634\u0651\u064e\u064a\u0652\u062e\u0650 \u0627\u0644\u0652\u0643\u064e\u0628\u0650\u064a\u0631\u0650",latin:"Y\xe2 R\xe2hime\u2019\u015f-\u015feyhi\u2019l-kebir",meal:"Ey d\xfc\u015fk\xfcn ihtiyarlara merhamet eden,"},{arabic:"\u064a\u064e\u0627 \u0639\u0650\u0635\u0652\u0645\u064e\u0629\u064e \u0627\u0644\u0652\u062e\u064e\u0653\u0627\u0626\u0650\u0641\u0650 \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u062a\u064e\u062c\u0650\u064a\u0631\u0650",latin:"Y\xe2 \u2018Ismete\u2019l-h\xe2ifi\u2019l-m\xfcstec\xeer",meal:"Ey korku i\xe7inde kurtulu\u015f isteyenlerin s\u0131\u011f\u0131na\u011f\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0628\u0650\u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0647\u0650 \u0628\u064e\u0635\u0650\u064a\u0631\u064c",latin:"Y\xe2 Men h\xfcve bi\u2019ib\xe2dih\xee bas\xeer",meal:"Ey kullar\u0131n\u0131n her halini g\xf6ren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0628\u0650\u062d\u064e\u0648\u064e\u0627\u064a\u0650\u062c\u0650 \u0627\u0644\u0652\u0639\u0650\u0628\u064e\u0627\u062f\u0650 \u062e\u064e\u0628\u