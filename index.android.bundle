7 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u062e\u064e\u064a\u0652\u0631\u064f \u0627\u0644\u0652\u0641\u064e\u0627\u0635\u0650\u0644\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve hayru\u2019l-fasil\xeen",meal:"Ey m\xfc\u015fk\xfcl meseleleri halledip h\xfckme ba\u011flayanlar\u0131n en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u062e\u064e\u064a\u0652\u0631\u064f \u0627\u0644\u0634\u0651\u064e\u0627\u0643\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve hayru\u2019\u015f-\u015f\xe2kir\xeen",meal:"Ey iyi amellere bol kar\u015f\u0131l\u0131k verenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0627\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0628\u0650\u0627\u0644\u0652\u0645\u064f\u0641\u0652\u0633\u0650\u062f\u0650\u064a\u0646\u064e",latin:"Y\xe2 Men h\xfcve a\u2019lem\xfc bi\u2019l-m\xfcfsid\xeen",meal:"Ey ifsat edenleri en iyi bilen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:72,title:"Mubdi ve Mu\u2019\xeed",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0628\u0652\u062f\u0650\u0649\u0654\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Mubdi",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum: Ey mahl\xfbkat\u0131 ilk defa yaratan M\xfcbdi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0639\u0650\u064a\u062f\u064f",latin:"Y\xe2 Mu\u2019\xeed",meal:"Ey mahl\xfbkat\u0131 \xf6ld\xfckten sonra yeniden dirilten Mu\xeed,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0641\u0650\u064a\u0638\u064f",latin:"Y\xe2 Haf\u0131z",meal:"Ey her \u015feyi muhafaza eden Haf\xeez,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u062d\u0650\u064a\u0637\u064f",latin:"Y\xe2 Muh\xeet",meal:"Ey her \u015feyi ilim ve kudretiyle ku\u015fatan Muh\xeet,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u062f\u064f",latin:"Y\xe2 Ham\xeed",meal:"Ey hamd ve sen\xe2ya en \xe7ok lay\u0131k olan ve \xe7ok \xf6v\xfclen Ham\xeed,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u062c\u0650\u064a\u062f\u064f",latin:"Y\xe2 Mec\xeed",meal:"Ey azamet, \u015feref ve h\xe2kimiyeti sonsuz Mec\xeed,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0642\u0650\u064a\u062a\u064f",latin:"Y\xe2 Muk\xeet",meal:"Ey her t\xfcrl\xfc mahl\xfbkata m\xfcnasip r\u0131z\u0131k veren Muk\xeet,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u063a\u0650\u064a\u062b\u064f",latin:"Y\xe2 Mu\u011f\xees",meal:"Ey darda kalan \xe7aresizlerin imdad\u0131na ko\u015fan Mug\xees,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0639\u0650\u0632\u0651\u064f",latin:"Y\xe2 Mu\u2019\xeezz",meal:"Ey istedi\u011fine izzet veren ve \u015fereflendiren Muizz,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0630\u0650\u0644\u0651\u064f",latin:"Y\xe2 Muzill",meal:"Ey istedi\u011fini zelil k\u0131lan M\xfczill,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u065