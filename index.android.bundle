e2 \u2018abdih\xee rah\xeem",meal:"Ey kullar\u0131na rahmet eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0628\u0650\u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u0649\u0652\u0621\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u064c",latin:"Y\xe2 men h\xfcve bik\xfclli \u015fey\u2019in \u2018al\xeem",meal:"Ey her \u015feyi bilen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u062c\u064e\u0641\u064e\u0627\u0647\u064f \u062d\u064e\u0644\u0650\u064a\u0645\u064c",latin:"Y\xe2 men h\xfcve limen cef\xe2hu hal\xeem",meal:"Ey emirlerine uymayana hal\xeem olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u062a\u064e\u0631\u064e\u062c\u064e\u0651\u0627\u0647\u064f \u0643\u064e\u0631\u0650\u064a\u0645\u064c",latin:"Y\xe2 men h\xfcve limen teracc\xe2h\xfc ker\xeem",meal:"Ey kendisine \xfcmit ba\u011flayana ker\xeem olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u0645\u064e\u0642\u064e\u0627\u062f\u0650\u064a\u0631\u0650\u0647\u0650 \u062d\u064e\u0643\u0650\u064a\u0645\u064c",latin:"Y\xe2 men h\xfcve f\xee mek\xe2d\xeerih\xee hakim",meal:"Ey \xf6l\xe7\xfclerinde hikmetli olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u062d\u064f\u0643\u0652\u0645\u0650\u0647\u0650 \u0644\u064e\u0637\u0650\u064a\u0641\u064c",latin:"Y\xe2 men h\xfcve fi h\xfckmih\xee lat\xeef",meal:"Ey h\xfckm\xfcnde l\xfctuf sahibi olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0647\u064f\u0648\u064e \u0641\u0650\u0649 \u0644\u064f\u0637\u0652\u0641\u0650\u0647\u0650 \u0642\u064e\u062f\u0650\u064a\u0631\u064c",latin:"Y\xe2 men h\xfcve f\u0131 l\xfctfih\xee kad\xeer",meal:"Ey l\xfctf\xfcnde kad\xeer olan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e