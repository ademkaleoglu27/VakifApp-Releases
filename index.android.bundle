 ihtiya\xe7lar\u0131na yeterli cevap veren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0642\u064e\u0648\u0651\u0650\u0649\u064e \u0645\u064e\u0646\u0650 \u0627\u0633\u0652\u062a\u064e\u0642\u0652\u0648\u064e\u0627\u0647\u064f",latin:"Y\xe2 Mukavviye meni\u2019stakv\xe2h",meal:"Ey kuvvet ve g\xfc\xe7 isteyenlere k\xe2fi kuvvet veren,"},{arabic:"\u064a\u064e\u0627 \u0648\u064e\u0644\u0650\u0649\u0651\u064e \u0645\u064e\u0646\u0650 \u0627\u0633\u0652\u062a\u064e\u0648\u0652\u0644\u064e\u0627\u0647\u064f",latin:"Y\xe2 Veliyye meni\u2019stevl\xe2h",meal:"Ey Kendisinden dostluk ve sahiplik isteyenlerin dost ve sahibi,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne ecirn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:60,title:"Evvel ve \xc2hir",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0648\u0651\u064e\u0644\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Evvel",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey her \u015feyden \xf6nce olan Evvel,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u0670\u062e\u0650\u0631\u064f",latin:"Y\xe2 \xc2hir",meal:"Ey her \u015feyden sonra olan \xc2hir,"},{arabic:"\u064a\u064e\u0627 \u0638\u064e\u0627\u0647\u0650\u0631\u064f",latin:"Y\xe2 Zahir",meal:"Ey varl\u0131\u011f\u0131 apa\xe7\u0131k g\xf6r\xfcnen Z\xe2hir,"},{arabic:"\u064a\u064e\u0627 \u0628\u064e\u0627\u0637\u0650\u0646\u064f",latin:"Y\xe2 B\xe2t\u0131n",meal:"Ey her \u015feyin i\xe7y\xfcz\xfcnden haberdar olan B\xe2t\u0131n,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u0627\u0644\u0650\u0642\u064f",latin:"Y\xe2 Halik",meal:"Ey her \u015feyi yoktan yaratan H\xe2l\u0131k,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0627\u0632\u0650\u0642\u064f",latin:"Y\xe2 R\xe2zik",meal:"Ey her \u015feyi m\xfcn\xe2sip bir \u015fekilde r\u0131z\u0131kland\u0131ran R\xe2z\u0131k,"},{arabic:"\u064a\u064e\u0627 \u0635\u064e\u0627\u062f\u0650\u0642\u064f",latin:"Y\xe2 S\xe2d\u0131k",meal:"Ey her i\u015fi do\u011fru olan ve s\xf6z\xfcn\xfc yerine getiren S\xe2d\u0131k,"},{arabic:"\u064a\u064e\u0627 \u0633\u064e\u0627\u0628\u0650\u0642\u064f",latin:"Y\xe2 Sab\u0131k",meal:"Ey varl\u0131\u011f\u0131 her \u015feyden \xf6nce olan S\xe2b\u0131k,"},{arabic:"\u064a\u064e\u0627 \u0633\u064e\u0653\u0627\u0626\u0650\u0642\u064f",latin:"Y\xe2 Saik",meal:"Ey her \u015feyi mukadder hedefine sevk eden S\xe2ik,"},{arabic:"\u064a\u064e\u0627 \u0641\u064e\u0627\u0644\u0650\u0642\u064f",latin:"Y\xe2 F\xe2lik",meal:"Ey tohum ve \xe7ekirdekleri yar\u0131p s\xfcmb\xfcllendiren F\xe2l\u0131k,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne ecirn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:61,title:"Y\xfckallib\xfc\u2019l-leyle ve\u2019n-neh\xe2r",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064f\u0642\u064e\u0644\u0651\u0650\u0628\u064f \u0627\u0644\u0651\u064e\u064a\u0652\u0644\u064e \u0648\u064e \u0627\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u064e",latin:"Y\xe2 Men y\xfckallib\xfc\u2019l-leyle ve\u2019n-neh\xe2r",meal:"Ey gece ve g\xfcnd\xfcz\xfc pe\u015f pe\u015fe de\u011fi\u015ftiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0638\u0651\u064f\u0644\u064f\u0645\u064e\u0627\u062a\u0650 \u0648\u064e \u0627\u0644\u0646\u0651\u064f\u0648\u0631\u064e",latin:"Y\xe2 Men Halaka\u2019z-zul\xfcm\xe2ti ve\u2019n-n\xfbr",meal:"Ey karanl\u0131klar\u0131 ve n\xfbru yaratan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0627\u0644\u0638\u0651\u0650\u0644\u0651\u064e \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0631\u064f\u0648\u0631\u064e",latin:"Y\xe2 Men ce\u2019ale\u2019z-z\u0131lle ve\u2019l-harur",meal:"Ey g\xf6lgeleri ve har\xe2reti meydana getiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0633\u064e\u062e\u0651\u064e\u0631\u064e \u0627\u0644\u0634\u0651\u064e\u0645\u0652\u0633\u064e \u0648\u064e \u0627\u0644\u0652\u0642\u064e\u0645\u064e\u0631\u064e",latin:"Y\xe2 Men sehhara\u2019s-semse ve\u2019l-kamer",meal:"Ey g\xfcne\u015f ve aya boyun e\u011fdiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u064e \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u064a\u0670\u0648\u0629\u064e",latin:"Y\xe2 Men haleka\u2019l-mevte ve\u2019l-hayah",meal:"Ey \xf6l\xfcm\xfc ve hayat\u0131 yaratan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064f \u0648\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u0652\u0631\u064f",latin:"Y\xe2 Men leh\xfc\u2019l-halku ve\u2019l-emr",meal:"Ey yaratmak ve emretmek Kendisine \xe2it olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u062a\u0651\u064e\u062e\u0650\u0630\u0652 \u0635\u064e\u0627\u062d\u0650\u0628\u064e\u0629\u064b \u0648\u064e \u0644\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064b\u0627",latin:"Y\xe2 Men lem yettehiz s\xe2hibeten vel\xe2 veled\xe2",meal:"Ey e\u015f ve evl\xe2t edinmeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u064e\u0647\u064f \u0634\u064e\u0631\u0650\u064a\u0643\u064c \u0641\u0650\u0649 \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u0650",latin:"Y\xe2 Men lem yek\xfbn leh\xfb \u015ferikim fi\u2019l-m\xfclk",meal:"Ey m\xfclk\xfcnde hi\xe7bir \u015fer\xeeki olmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u064e\u0647\u064f \u0648\u064e\u0644\u0650\u0649\u0651\u064c \u0645\u0650\u0646\u064e \u0627\u0644\u0630\u0651\u064f\u0644\u0651\u0650",latin:"Y\xe2 Men lem yek\xfbn leh\xfb veliyy\xfcn mine\u2019z-z\xfcll",meal:"Ey zilletten m\xfcnezzeh oldu\u011fu i\xe7in dosta ihtiyac\u0131 olmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0648\u0652\u0644\u064f \u0648\u064e \u0627\u0644\u0652\u0642\u064f\u0648\u0651\u064e\u0629\u064f",latin:"Y\xe2 men leh\xfc\u2019l-havl\xfc ve\u2019l-kuvveh",meal:"Ey havl ve kuvvet kendisine \xe2it olan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627