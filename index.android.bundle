xe2",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Rabbena",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey Rabbimiz"},{arabic:"\u064a\u064e\u0627 \u0627\u0650\u0644\u0670\u0647\u064e\u0646\u064e\u0627",latin:"Y\xe2 \u0130l\xe2hen\xe2",meal:"Ey \u0130l\xe2h\u0131m\u0131z"},{arabic:"\u064a\u064e\u0627 \u0633\u064e\u064a\u0651\u0650\u062f\u064e\u0646\u064e\u0627",latin:"Y\xe2 Seyyiden\xe2",meal:"Ey Seyyidimiz"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0648\u0652\u0644\u0670\u064a\u0646\u064e\u0627",latin:"Y\xe2 Mevl\xe2n\xe2",meal:"Ey Mevl\xe2m\u0131z"},{arabic:"\u064a\u064e\u0627 \u0646\u064e\u0627\u0635\u0650\u0631\u064e\u0646\u064e\u0627",latin:"Y\xe2 N\xe2s\u0131ran\xe2",meal:"Ey Yard\u0131mc\u0131m\u0131z"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0627\u0641\u0650\u0638\u064e\u0646\u064e\u0627",latin:"Y\xe2 Haf\u0131zana",meal:"Ey Koruyucumuz"},{arabic:"\u064a\u064e\u0627 \u0642\u064e\u0627\u062f\u0650\u0631\u064e\u0646\u064e\u0627",latin:"Y\xe2 K\xe2diran\xe2",meal:"Ey K\xe2dirimiz"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0627\u0632\u0650\u0642\u064e\u0646\u064e\u0627",latin:"Y\xe2 R\xe2zikan\xe2",meal:"Ey R\xe2z\u0131k\u0131m\u0131z"},{arabic:"\u064a\u064e\u0627 \u062f\u064e\u0644\u0650\u064a\u0644\u064e\u0646\u064e\u0627",latin:"Y\xe2 Del\xeelen\xe2",meal:"Ey Delilimiz"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u063a\u0650\u064a\u062b\u064e\u0646\u064e\u0627",latin:"Y\xe2 Mu\u011fisen\xe2",meal:"Ey Medetk\xe2r\u0131m\u0131z"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:101,title:"All\xe2humme Rabben\xe2",lines:[{arabic:"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f\u0645\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627 \u066d \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u066d \u0648\u064e \u0627\u064e\u062c\u0650\u0631\u0652\u0646\u064e\u0627 \u066d \u0648\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u066d",latin:"All\xe2humme Rabben\xe2, hallisn\xe2 ve ecirn\xe2 ve neccin\xe2 mine'n-n\xe2r.",meal:"Ey Allah\u2019\u0131m, ey Rabbimiz! Bizi Cehennem ate\u015finden hal\xe2s eyle, muhafaza et, necat ver!"},{arabic:"\u0648\u064e \u0639\u064e\u0627\u0641\u0650\u0646\u064e\u0627 \u0648\u064e \u0627\u0639\u0652\u0641\u064f \u0639\u064e\u0646\u0651\u064e\u0627 \u0648\u064e \u0627\u064e\u062f\u0652\u062e\u0650\u0644\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0646\u0651\u064e\u0629\u064e \u062f\u064e\u0627\u0631\u064e \u0642\u064f\u062f\u0652\u0633\u0650\u0643\u064e \u0645\u064e\u0639\u064e \u0627\u0644\u0652\u0627\u064e\u0628\u0652\u0631\u064e\u0627\u0631\u0650 \u066d \u0628\u0650\u0639\u064e\u0641\u0652\u0648\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u062c\u0650\u064a\u0631\u064f \u066d \u0628\u0650\u0641\u064e\u0636\u0652\u0644\u0650\u0643\u064e \u064a\u064e\u0627 \u063a\u064e\u0641\u0651\u064e\u0627\u0631\u064f",latin:"Ve '\xe2fin\xe2 ve'fu 'ann\xe2 ve edhilne'l-cennete d\xe2ra kudsike me'a'l-ebr\xe2r. Bi 'afvike y\xe2 Muc\xeer, bi fadlike y\xe2 Gaff\xe2r.",meal:"Allah\u2019\u0131m, bize \xe2fiyet ver, bizi affet, bizi iyilerle birlikte p\xe2k ve temiz diyar\u0131n olan Cennete koy. Bunu sadece aff\u0131nla yap, ey kullar\u0131n\u0131 azaptan koruyan M\xfcc\xeer! Faz\u0131l ve kereminle olsun, ey b\xfct\xfcn g\xfcnahlar\u0131 ba\u011f\u0131\u015flayan Gafur"},{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u062d\u064e\u0642\u0651\u0650 \u0647\u0670\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0621\u0650 \u0627\u0644\u0652\u0643\u064e\u0631\u06ea\u064a\u0645\u064e\u0629\u0650 \u0627\u0644\u0634\u0651\u064e\u0631\u06ea\u064a\u0641\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0635\u0651\u0650\u0641\u064e\u0627\u062a\u0650 \u0627\u0644\u0652\u062c\u064e\u0644\u0650\u064a\u0644\u064e\u0629\u0650 \u0627\u0644\u0651\u064e\u0644\u0637\u0650\u064a\u0641\u064e\u0629\u0650 \u0627\u064e\u0646\u0652 \u062a\u064f\u0635\u064e\u0644\u0651\u0650\u0649\u064e \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0651\u0650\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064d \u0648\u064e \u0639\u064e\u0644\u0670\u0653\u0649 \u0627\u0670\u0644\u0650\u0647\u0650 \u0648\u064e \u0635\u064e\u062d\u0652\u0628\u0650\u0647\u0650 \u0628\u0650\u0639\u064e\u062f\u064e\u062f\u0650 \u062d\u064e\u0633\u064e\u0646\u064e\u0627\u062a\u0650 \u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064d \u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u066d \u062d\u064e\u0633\u0652\u0628\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u0634\u064e\u0647\u0650\u062f\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u0642\u064f\u0644\u0652 \u0647\u064f\u0648\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u0645\u064e\u0627 \u0634\u064e\u0653\u0627\u0621\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u0631\u064e\u0628\u0651\u0650\u0649\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u0643\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u062a\u064e\u0639\u064e\u0627\u0644\u064e\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0652\u062a\u064f \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u066d \u0641\u064e\u0633\u064e\u064a\u064e\u0643\u0652\u0641\u06ea\u064a\u0643\u064e\u0647\u064f\u0645\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e \u0647\u064f\u0648\u064e \u0627\u0644\u0633\u0651\u064e\u0645\u0650\u064a\u0639\u064f \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0645\u064f",latin:"Ve es'el\xfcke bi hakk\u0131 h\xe2zihi'l-esm\xe2'i'l-ker\xeemeti'\u015f-\u015fer\xeefeti ve's-sif\xe2ti'l-cel\xeeleti'l-lat\xeefeti en tusalliye 'al\xe2 seyyidin\xe2 Muhammedin ve 'al\xe2 \xe2lih\xee ve sahbih\xee bi 'adedi hasen\xe2ti Muhammed. Bismill\xe2h. Hasbiyall\xe2h. L\xe2 il\xe2he ill\xe2ll\xe2h. \u015eehidall\xe2h. Kul huvall\xe2h. M\xe2 \u015f\xe2all\xe2h. Rabbiyall\xe2h. Teb\xe2rakall\xe2h. Te'\xe2lall\xe2h. Tevekkelt\xfc 'al\xe2ll\xe2h. Fe seyekf\xeekeh\xfcmull\xe2h ve h\xfcve's-sem\xee'u'l-'al\xeem.",meal:"Ben, \u015fu k\u0131ymetli ve \u015ferefli isimlerinin, \u015fu y\xfcce ve l\xe2tif s\u0131fatlar\u0131n\u0131n hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum ki, Efendimiz Muhammed Aleyhissel\xe2t\xfc Vessel\xe2ma, onun yapt\u0131\u011f\u0131 iyilikler say\u0131s\u0131nca sal\xe2t ve sel\xe2m eyle! Allah\u2019\u0131n ismiyle. Allah bana k\xe2fi. Allah\u2019tan ba\u015fka il\xe2h yok. Allah her \u015feye \u015fahit. De ki; O Allah\u2019t\u0131r. Allah\u2019\u0131n diledi\u011fi olur. Rabbim Allah\u2019t\u0131r. Allah\u2019\u0131n \u015f\xe2n\u0131 y\xfccedir. Allah \xe2l\xeedir. Allah\u2019a tevekk\xfcl edip g\xfcvendim. Allah onlara kar\u015f\u0131 sana k\xe2fidir. O her \u015feyi i\u015fiten ve bilendir."},{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0644\u064e\u0653\u0627 \u0627\u064f\u062d\u0652\u0635\u0650\u0649 \u062b\u064e\u0646\u064e\u0653\u0627\u0621\u064b \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u0627\u064e\u0646\u0652\u062a\u064e \u0643\u064e\u0645\u064e\u0653\u0627 \u0627\u064e\u062b\u0652\u0646\u064e\u064a\u0652\u062a\u064e \u0639\u064e\u0644\u0670\u0649 \u0646\u064e\u0641\u0652\u0633\u0650\u0643\u064e \u066d \u064a\u064e\u0653\u0627 \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u066d \u064a\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u0670\u0646\u064f \u066d \u064a\u064e\u0627 \u0631\u064e\u062d\u0650\u064a\u0645\u064f \u066d \u064a\u064e\u0627 \u063a\u064e\u0641\u064f\u0648\u0631\u064f \u066d \u064a\u064e\u0627 \u0634\u064e\u0643\u064f\u0648\u0631\u064f \u066d \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0645\u064e\u0653\u0627 \u0627\u064e\u062d\u0652\u0635\u064e\u064a\u0652\u062a\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u0645\u0650\u0646\u0652 \u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u0627\u0644\u0652\u062d\u064f\u0633\u0652\u0646\u0670\u0649 \u0648\u064e \u0635\u0650\u0641\u064e\u0627\u062a\u0650\u0643\u064e \u0627\u0644\u0652\u0639\u064f\u0644\u0652\u064a\u064e\u0627 \u0648\u064e \u0643\u064e\u0644\u0650\u0645\u064e\u0627\u062a\u0650\u0643\u064e \u0627\u0644\u062a\u0651\u064e\u0653\u0627\u0645\u0651\u064e\u0629\u0650 \u0627\u064e\u0646\u0652 \u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064e\u0644\u0650\u0649 \u0648\u064e \u0644\u0650\u0648\u064e\u0627\u0644\u0650\u062f\u064e\u0649\u0651\u064e \u0648\u064e \u0644\u0627\u064f\u0633\u0652\u062a\u064e\u0627\u0630\u0650\u0649 \u0633\u064e\u0639\u0650\u064a\u062f\u0650 \u0627\u0644\u0646\u0651\u064f\u0648\u0631\u0652\u0633\u0650\u0649 \u0648\u064e \u0644\u0650\u0637\u064e\u0644\u064e\u0628\u064e\u0629\u0650 \u0631\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0644\u0650 \u0627\u0644\u0646\u0651\u064f\u0648\u0631\u0650 \u0648\u064e \u0644\u0650\u062c\u064e\u0645\u0650\u064a\u0639\u0650 \u0627\u0644\u0652\u0645\u064f\u0648\u0654\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0648\u0654\u0652\u0645\u0650\u0646\u064e\u0627\u062a\u0650 \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0648\u064e \u0627\u0644\u0652\u0645\u064f\u0633\u0652\u0644\u0650\u0645\u064e\u0627\u062a\u0650 \u0627\u0644\u0652\u0627\u064e\u062d\u0652\u064a\u064e\u0653\u0627\u0621\u0650 \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0648\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u0652\u0648\u064e\u0627\u062a\u0650 \u0648\u064e \u062a\u064e\u0631\u0652\u062d\u064e\u0645\u064e\u0646\u064e\u0627 \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064b \u062a\u064f\u063a\u0652\u0646\u0650\u064a\u0646\u064e\u0627\u0628\u0650\u0647\u064e\u0627 \u0639\u064e\u0646\u0652 \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u0650 \u0645\u064e\u0646\u0652 \u0633\u0650\u0648\u064e\u0627\u0643\u064e \u0645\u0650\u0646\u0652 \u062e\u064e\u0644\u0652\u0642\u0650\u0643\u064e \u0648\u064e \u0627\u064e\u0646\u0652 \u062a\u064e\u0642\u0652\u0636\u0650\u0649\u064e \u062d\u064e\u0648\u064e\u0627\u064a\u0650\u062c\u064e\u0646\u064e\u0627 \u0648\u064e \u062a\u064f\u0639\u0652\u0637\u0650\u064a\u064e\u0646\u064e\u0627 \u0633\u064f\u0648\u0654\u064e\u0627\u0644\u064e\u0646\u064e\u0627 \u0641\u0650\u0649 \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627 \u0648\u064e \u0627\u0652\u0644\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0648\u064e \u062a\u064e\u062e\u0652\u062a\u0650\u0645\u064e \u0644\u064e\u0646\u064e\u0627 \u0628\u0650\u0627\u0644\u0633\u0651\u064e\u0639\u064e\u0627\u062f\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0634\u0651\u064e\u0647\u064e\u0627\u062f\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0652\u0643\u064e\u0631\u064e\u0627\u0645\u064e\u0629\u0650 \u0648\u064e \u0627\u0644\u0652\u0628\u064f\u0634\u0652\u0631\u0670\u0649 \u0639\u0650\u0646\u0652\u062f\u064e \u0641\u0650\u0631\u064e\u0627\u0642\u0650 \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627 \u0648\u064e \u062a\u064e\u062c\u0652\u0632\u0650\u0649\u064e \u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064b\u0627 \u0635\u064e\u0644\u0651\u064e\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e \u0633\u064e\u0644\u0651\u064e\u0645\u064e \u0639\u064e\u0646\u0651\u064e\u0627 \u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0627\u064e\u0647\u0652\u0644\u064f\u0647\u064f \u0648\u064e \u0645\u064f\u0633\u0652\u062a\u064e\u062d\u064e\u0642\u0651\u064f\u0647\u064f",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 il\xe2he ill\xe2 ente'l-em\xe2n el-em\xe2n l\xe2 uhs\xee sen\xe2en 'aleyke ente kem\xe2 esneyte 'al\xe2 nefsik. Y\xe2 Allah, y\xe2 Rahm\xe2n, y\xe2 Rah\xeem, y\xe2 Gaf\xfbr, y\xe2 \u015eek\xfbr. Es'el\xfcke bim\xe2 ahsayteh\xfb 'aleyke min esm\xe2ike'l-h\xfcsn\xe2 ve s\u0131f\xe2tike'l-'uly\xe2 ve kelim\xe2tike't-t\xe2mmeti en ta\u011ffire l\xee ve li v\xe2lideyye ve li \xfcst\xe2z\xee Sa\xeedi'n-N\xfbrs\xee ve li talebeti Res\xe2ili'n-N\xfbr ve li cem\xee'i'l-m\xfc'min\xeene ve'l-m\xfc'min\xe2t ve'l-m\xfcslim\xeene ve'l-m\xfcslim\xe2t el-ahy\xe2i minh\xfcm ve'l-emv\xe2t. Ve terhamen\xe2 rahmeten tu\u011fn\xeen\xe2 bih\xe2 'an rahmeti men siv\xe2ke min halkik. Ve en takd\u0131ye hav\xe2yicen\xe2 ve tu'tiyen\xe2 su\xe2len\xe2 fi'd-duny\xe2 ve'l-\xe2hireti ve tahtime len\xe2 bi's-sa'\xe2deti ve'\u015f-\u015feh\xe2deti ve'l-ker\xe2meti ve'l-bu\u015fr\xe2 'inde fir\xe2ki'd-duny\xe2 ve tecziye Muhammedin sallall\xe2hu 'aleyhi ve selleme 'ann\xe2 m\xe2 h\xfcve ehluh\xfb ve m\xfcstehakkuh.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin. Ey kendisinden ba\u015fka ilah olmayan Allah\u2019\u0131m! Eman ver bize, eman diliyorum. Sana olan medih ve sen\xe2lar\u0131 say\u0131p d\xf6kemiyorum. Sen, Z\xe2t\u0131n\u0131 \xf6vd\xfc\u011f\xfcn gibisin. Ey b\xfct\xfcn kem\xe2l s\u0131fatlar\u0131n\u0131 ta\u015f\u0131yan hakik\xee Ma\u2019bud olan Allah! Ey b\xfct\xfcn mahl\xfbkata r\u0131z\u0131k verip merhamet eden Rahman! Ey ahirette s\xe2lih kullar\u0131na l\xfctuflarda bulunacak olan Rah\xeem! Ey b\xfct\xfcn g\xfcnahlar\u0131 ba\u011f\u0131\u015flayan Gaf\xfbr! Ey kullar\u0131n\u0131n ib\xe2det ve \u015f\xfck\xfcrlerine bol m\xfck\xe2fatla kar\u015f\u0131l\u0131k veren \u015eek\xfbr! Z\xe2t\u0131n i\xe7in sayd\u0131\u011f\u0131n g\xfczel isimlerin, y\xfcce s\u0131fatlar\u0131n ve eksiksiz kelimelerin hakk\u0131 i\xe7in Senden istiyor ve yalvar\u0131yorum ki, beni, anne-babam\u0131, \xdcstad\u0131m Said Nurs\xee\u2019yi, Nur Talebelerini ve b\xfct\xfcn erkek ve kad\u0131n m\xfcmin ve M\xfcsl\xfcmanlardan hayatta olan ve \xf6lenleri ba\u011f\u0131\u015fla! D\xfcnyada ve ahirette ihtiya\xe7lar\u0131m\u0131z\u0131 yerine getir ve diledi\u011fimizi ihsan eyle! D\xfcnyadan ayr\u0131l\u0131rken son nefesimizi sa\xe2det, \u015feh\xe2det, ikram ve m\xfcjdeyle vermemizi nasip eyle! Bizim ad\u0131m\u0131za Hazret-i Muhammed Aleyhissal\xe2t\xfc Vessel\xe2m\u0131 l\xe2y\u0131k ve m\xfcstahak oldu\u011fu \u015feylerle m\xfck\xe2fatland\u0131r."},{arabic:"\u0648\u064e \u0627\u064e\u0646\u0652 \u0644\u064e\u0627 \u062a\u064e\u0643\u0650\u0644\u064e\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u0653\u0649 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u0650\u0646\u064e\u0627 \u0637\u064e\u0631\u0652\u0641\u064e\u0629\u064e \u0639\u064e\u064a\u0652\u0646\u064d \u0648\u064e \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u064e\u0653\u0649 \u0627\u064e\u062d\u064e\u062f\u064d \u0645\u0650\u0646\u0652 \u062e\u064e\u0644\u0652\u0642\u0650\u0643\u064e",latin:"Ve en l\xe2 tekilen\xe2 'al\xe2 enfusin\xe2 tarfete 'aynin ve l\xe2 il\xe2 ehadin min halkik.",meal:"G\xf6z\xfcm\xfcz\xfc a\xe7\u0131p kapay\u0131ncaya kadar bizi ne nefsimize, ne de yarat\u0131klar\u0131ndan hi\xe7 birine hav\xe2le etme!"},{arabic:"\u0648\u064e \u062a\u064f\u0635\u0652\u0644\u0650\u062d\u064e \u0644\u064e\u0646\u064e\u0627 \u0634\u064e\u0627\u0652\u0646\u064e\u0646\u064e\u0627 \u0648\u064e \u0627\u064e\u0646\u0652 \u062a\u064e\u062d\u0652\u0631\u064f\u0633\u064e\u0646\u064e\u0627 \u0628\u0650\u0639\u064e\u064a\u0652\u0646\u0650\u0643\u064e \u0627\u0644\u0651\u064e\u062a\u0650\u0649 \u0644\u064e\u0627 \u062a\u064e\u0646\u064e\u0627\u0645\u064f \u0648\u064e \u062a\u064e\u062d\u0652\u0641\u064e\u0638\u064e\u0646\u064e\u0627 \u0628\u0650\u0631\u064f\u0643\u0652\u0646\u0650\u0643\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u0649 \u0644\u064e\u0627 \u064a\u064f\u0631\u064e\u0627\u0645\u064f \u064a\u064e\u0627 \u0630\u064e\u0627 \u0627\u0644\u0652\u062c\u064e\u0644\u064e\u0627\u0644\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0643\u0652\u0631\u064e\u0627\u0645\u0650",latin:"Ve tusliha len\xe2 \u015f\xea'nen\xe2 ve en tahrusen\xe2 bi 'aynike'llet\xee l\xe2 ten\xe2m ve tahfezan\xe2 bi ruknike'llez\xee l\xe2 yur\xe2m y\xe2 ze'l-cel\xe2li ve'l-ikr\xe2m.",meal:"\u0130\u015flerimizi \u0131slah edip, yoluna koy! Bizi, hi\xe7 z\xe2il olmayan ilim ve s\u0131y\xe2netinle him\xe2ye eyle! Ayr\u0131 ya\u015fanamayan deste\u011finle bizleri muh\xe2faza eyle, ey Cel\xe2l ve \u0130kram Sahibi!"},{arabic:"\u0648\u064e \u0627\u064e\u0646\u0652 \u062a\u064e\u0635\u0652\u0631\u0650\u0641\u064e \u0639\u064e\u0646\u0651\u064e\u0627 \u0648\u064e \u0639\u064e\u0645\u0651\u064e\u0646\u0652 \u0639\u064f\u0644\u0651\u0650\u0642\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0647\u0670\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0621\u064f \u0627\u0670\u0641\u064e\u0629\u064e \u0627\u0644\u0652\u062c\u0650\u0646\u0651\u0650 \u0648\u064e \u0627\u0652\u0644\u0627\u0650\u0646\u0652\u0633\u0650 \u0648\u064e \u0627\u0644\u0634\u0651\u064e\u064a\u064e\u0627\u0637\u0650\u064a\u0646\u0650         \u0648\u064e \u0632\u064e\u0644\u0652\u0632\u064e\u0644\u064e\u0629\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e \u062f\u064e\u0643\u0652\u062f\u064e\u0643\u064e\u0629\u064e \u0627\u0644\u0652\u062c\u0650\u0628\u064e\u0627\u0644\u0650 \u0645\u0650\u0646\u0652 \u062e\u064e\u0634\u0652\u064a\u064e\u062a\u0650\u0647\u0650 \u0648\u064e \u0627\u0670\u0641\u064e\u0629\u064e \u0627\u0644\u0637\u064e\u0651\u0627\u0639\u064f\u0648\u0646\u0650 \u0648\u064e \u0627\u0644\u0652\u0648\u064e\u0628\u064e\u0653\u0627\u0621\u0650 \u0648\u064e \u0639\u064e\u064a\u0652\u0646\u064e \u0627\u0644\u0633\u0651\u064f\u0653\u0648\u0621\u0650 \u0648\u064e \u0648\u064e\u062c\u064e\u0639\u064e \u0627\u0644\u0652\u062c\u064e\u0648\u064e\u0627\u0631\u0650\u062d\u0650 \u0648\u064e\u0633\u064e\u0653\u0627\u0626\u0650\u0631\u064e \u0627\u0652\u0644\u0627\u0670\u0641\u064e\u0627\u062a\u0650 \u0648 \u062a\u064e\u062d\u064e\u0641\u0652\u0638\u064e\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0631\u0651\u064d \u0648\u064e \u0633\u064f\u0653\u0648\u0621\u064d \u0648\u064e \u062a\u064e\u0631\u0652\u0632\u064f\u0642\u064e\u0646\u064e\u0627 \u0627\u0644\u0633\u0651\u064e\u0644\u064e\u0627\u0645\u064e\u0629\u064e \u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0627\u0641\u0650\u064a\u064e\u0629\u064e \u0648\u064e \u0627\u0644\u0652\u062e\u064e\u064a\u0652\u0631\u064e \u0641\u0650\u0649 \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627 \u0648\u064e \u0627\u0652\u0644\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0627\u0650\u0646\u0651\u064e\u0643\u064e \u0639\u064e\u0644\u064e\u0649 \u0643\u064f\u0644\u0650\u0651 \u0634\u064e\u064a\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0631\u064c",latin:"Ve en tasrife 'ann\xe2 ve 'ammen 'ullika 'aleyhi h\xe2zihi'l-esm\xe2u \xe2fete'l-cinni ve'l-insi ve'\u015f-\u015fey\xe2t\xeen ve zelzelete'l-ard\u0131 ve dekdekete'l-cib\xe2li min ha\u015fyetih\xee ve \xe2fete't-t\xe2'\xfbni ve'l-vb\xe2i ve 'ayne's-s\xfbi ve vece'a'l-cev\xe2rihi ve s\xe2ira'l-\xe2f\xe2t ve tahfezan\xe2 min k\xfclli \u015ferrin ve s\xfbin ve terzukan\xe2's-sel\xe2mete ve'l-'\xe2fiyete ve'l-hayra fi'd-duny\xe2 ve'l-\xe2hireti inneke 'al\xe2 k\xfclli \u015fey'in kad\xeer.",meal:"Bizden ve bu isimleri \xfczerinde ta\u015f\u0131yan kimselerden cin, insan ve \u015feytanlardan gelecek \xe2fetleri, yer sars\u0131nt\u0131lar\u0131n\u0131 ve Allah korkusundan meydana gelen da\u011f par\xe7alan\u0131\u015flar\u0131n\u0131, t\xe2un ve veb\xe2 mus\xeebetlerini, kem g\xf6zleri, v\xfccut a\u011fr\u0131lar\u0131n\u0131 ve di\u011fer fel\xe2ketleri def eyle! Bizi b\xfct\xfcn \u015fer ve k\xf6t\xfcl\xfcklerden muh\xe2faza et."}],munacaat:{arabic:"\u0628\u0650\u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0643\u064e \u064a\u064e\u0653\u0627 \u0627\u064e\u0631\u0652\u062d\u064e\u0645\u064e \u0627\u0644\u0631\u0651\u064e\u0627\u062d\u0650\u0645\u0650\u064a\u0646\u064e \u0648\u064e \u0635\u064e\u0644\u0651\u064e\u0649 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0639\u064e\u0644\u0670\u0649 \u0633\u064e\u064a\u0651\u0650\u062f\u0650\u0646\u064e\u0627 \u0645\u064f\u062d\u064e\u0645\u0651\u064e\u062f\u064d \u0648\u064e \u0627\u0670\u0644\u0650\u0647\u0650 \u0648\u064e \u0635\u064e\u062d\u0652\u0628\u0650\u0647\u0650\u0653 \u0627\u064e\u062c\u0652\u0645\u064e\u0639\u0650\u064a\u0646\u064e \u0648\u064e \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0631\u064e\u0628\u0651\u0650 \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u064e\u0645\u0650\u064a\u0646\u064e",latin:"Bi rahmetike y\xe2 erhamerrahim\xeen ve sallall\xe2hu 'al\xe2 seyyidin\xe2 Muhammedin ve \xe2lih\xee ve sahbih\xee ecme'\xeen ve'l-hamd\xfclill\xe2hi rabbil-'\xe2lem\xeen.",meal:"Rahmetinle bize d\xfcnyada ve \xe2hirette sel\xe2met, \xe2fiyet ve hay\u0131r nasip eyle, ey merhametlilerin en merhametlisi! Allah, Efendimiz Hazret-i Muhammed\u2019e (a.s.m.), onun \xe2l ve Ash\xe2b\u0131na sall\xe2t ve sel\xe2m eylesin! Ezelden ebede her t\xfcrl\xfc hamd ve \xf6vg\xfc, \u015f\xfck\xfcr ve minnet \xc2lemlerin Rabbi olan Allah\u2019a mahsustur."}}]}},2459,[]);
