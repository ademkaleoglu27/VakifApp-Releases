 En\xeese\u2019l-evliy\xe2",meal:"Ey dostlar\u0131n can yolda\u015f\u0131,"},{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0628\u0650\u064a\u0628\u064e \u0627\u0644\u0652\u0627\u064e\u062a\u0652\u0642\u0650\u064a\u064e\u0653\u0627\u0621\u0650",latin:"Y\xe2 Hab\xeebe\u2019l-etk\u0131y\xe2",meal:"Ey takv\xe2 sahiplerinin sevgilisi,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0644\u0652\u0627\u064e\u063a\u0652\u0646\u0650\u064a\u064e\u0653\u0627\u0621\u0650",latin:"Y\xe2 \u0130l\xe2he\u2019l-a\u011fniy\xe2",meal:"Ey zenginlerin mabudu,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:93,title:"Evvele k\xfclli \u015fey\u2019in",lines:[{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0648\u0651\u064e\u0644\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0627\u0670\u062e\u0650\u0631\u064e\u0647\u064f",latin:"Y\xe2 Evvele k\xfclli \u015fey\u2019in ve \xe2hirah",meal:"Ey her \u015feyin evveli ve \xe2hiri,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0635\u064e\u0627\u0646\u0650\u0639\u064e\u0647\u064f",latin:"Y\xe2 \u0130lahe k\xfclli \u015fey\u2019in ve s\xe2ni\u2019ah",meal:"Ey her \u015feyin il\xe2h\u0131 ve sanatk\xe2r\u0131,"},{arabic:"\u064a\u064e\u0627 \u0631\u064e\u0627\u0632\u0650\u0642\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u062e\u064e\u0627\u0644\u0650\u0642\u064e\u0647\u064f",latin:"Y\xe2 R\xe2zika k\xfclli \u015fey\u2019in ve h\xe2likah",meal:"Ey her \u015feyin r\xe2z\u0131k\u0131 ve h\xe2l\u0131k\u0131,"},{arabic:"\u064a\u064e\u0627 \u0641\u064e\u0627\u0637\u0650\u0631\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064e\u0644\u0650\u064a\u0643\u064e\u0647\u064f",latin:"Y\xe2 F\xe2tira k\xfclli \u015fey\u2019in ve mel\xeekeh",meal:"Ey her \u015feyin yarat\u0131c\u0131s\u0131 ve sult\xe2n\u0131,"},{arabic:"\u064a\u064e\u0627 \u0642\u064e\u0627\u0628\u0650\u0636\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0628\u064e\u0627\u0633\u0650\u0637\u064e\u0647\u064f",latin:"Y\xe2 K\xe2bida k\xfclli \u015fey\u2019in ve b\xe2siteh",meal:"Ey her \u015feyi daraltan ve geni\u015fleten,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0628\u0652\u062f\u0650\u0649\u0654\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064f\u0639\u0650\u064a\u062f\u064e\u0647\u064f",latin:"Y\xe2 Mubdie k\xfclli \u015fey\u2019in ve n\u0131\xfc\u2019\xeedeh",meal:"Ey her \u015feyi ilk defa yaratan ve \xf6ld\xfckten sonra tekrar i\xe2de eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0633\u064e\u0628\u0651\u0650\u0628\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064f\u0642\u064e\u062f\u0651\u0650\u0631\u064e\u0647\u064f",latin:"Y\xe2 Musebbibe k\xfclli \u015fey\u2019in ve m\xfckaddirah",meal:"Ey her \u015feye gerekli sebepleri yaratan ve bir \xf6l\xe7\xfc takdir eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0631\u064e\u0628\u0651\u0650\u0649\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064f\u062f\u064e\u0628\u0651\u0650\u0631\u064e\u0647\u064f",latin:"Y\xe2 Murabbiye k\xfclli \u015fey\u2019in ve m\xfcdebbirah",meal:"Ey her \u015feyi terbiye ve id\xe2re eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0643\u064e\u0648\u0651\u0650\u0631\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064f\u062d\u064e\u0648\u0651\u0650\u0644\u064e\u0647\u064f",latin:"Y\xe2 Mukevvira k\xfclli \u015fey\u2019in ve muhavvileh",meal:"Ey her \u015feyi d\xf6nd\xfcren ve de\u011fi\u015ftiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u062d\u0652\u064a\u0650\u0649\u064e \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0648\u064e \u0645\u064f\u0645\u0650\u064a\u062a\u064e\u0647\u064f",latin:"Y\xe2 Muhyiye k\xfclli \u015fey\u2019in ve m\xfcm\xeeteh",meal:"Ey her \u015feyi dirilten ve \xf6ld\xfcren,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u062e\u064e\u0644\u0651\u0650\u0635\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne hallisn\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:94,title:"Hayra z\xe2kir\xeen",lines:[{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0630\u064e\u0627\u0643\u0650\u0631\u064d \u0648\u064e \u0645\u064e\u0630\u0652\u0643\u064f\u0648\u0631\u064d",latin:"Y\xe2 Hayra z\xe2kir\xeen ve mezk\xfbr",meal:"Ey y\xe2d edenlerin ve y\xe2d edilenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0634\u064e\u0627\u0643\u0650\u0631\u064d \u0648\u064e \u0645\u064e\u0634\u0652\u0643\u064f\u0648\u0631\u064d",latin:"Y\xe2 Hayra \u015f\xe2kir\xeen ve me\u015fk\xfbr",meal:"Ey \u015f\xfckr\xfc kabul edenlerin ve \u015f\xfckredilenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0634\u064e\u0627\u0647\u0650\u062f\u064d \u0648\u064e \u0645\u064e\u0634\u0652\u0647\u064f\u0648\u062f\u064d",latin:"Y\xe2 Hayra \u015fahidin ve me\u015fh\xfbd",meal:"Ey \xf6v\xfclenlerin ve \xf6venlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u062d\u064e\u0627\u0645\u0650\u062f\u064d \u0648\u064e \u0645\u064e\u062d\u0652\u0645\u064f\u0648\u062f\u064d",latin:"Y\xe2 Hayra h\xe2midin ve mahm\xfbd",meal:"Ey g\xf6renlerin ve g\xf6r\xfclenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u062f\u064e\u0627\u0639\u064d \u0648\u064e \u0645\u064e\u062f\u0652\u0639\u064f\u0648\u0651\u064d",latin:"Y\xe2 Hayra d\xe2\u2019in ve med\u2019uvv",meal:"Ey \xe7a\u011f\u0131ranlar\u0131n ve \xe7a\u011fr\u0131lanlar\u0131n en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0645\u064f\u062c\u0650\u064a\u0628\u064d \u0648\u064e \u0645\u064f\u062c\u064e\u0627\u0628\u064d",latin:"Y\xe2 Hayra m\xfcc\xeebin ve m\xfcc\xe2b",meal:"Ey cevap verenlerin ve cevap verilenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0645\u064f\u0648\u0646\u0650\u0633\u064d \u0648\u064e \u0627\u064e\u0646\u0650\u064a\u0633\u064d",latin:"Y\xe2 Hayra munisin ve en\xees",meal:"Ey \xfcnsiyet verenlerin ve Kendisiyle \xfcnsiyet edilenlerin en hay\u0131rl\u0131s\u0131,"},{arabic:"\u064a\u064e\u0627 \u062e\u064e\u064a\u0652\u0631\u064e \u0635\u064e\u0627\u062d\u0650\u0628\u064d \u0648\u064e \u062c\u064e\u0644\u0650\u064a\u0633\u064d",latin:"Y\xe2 Hayra sahibin ve cel\xees"