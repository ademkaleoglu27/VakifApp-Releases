0131c\u0131s\u0131 olan F\xe2il,"},{arabic:"\u064a\u064e\u0627 \u0643\u064e\u0627\u0641\u0650\u0644\u064f",latin:"Y\xe2 K\xe2fil",meal:"Ey yarat\u0131klar\u0131n her i\u015fini \xfczerine alan K\xe2fil,"},{arabic:"\u064a\u064e\u0627 \u062c\u064e\u0627\u0639\u0650\u0644\u064f",latin:"Y\xe2 C\xe2\u2019il",meal:"Ey her \u015feyi meydana getiren C\xe2il,"},{arabic:"\u064a\u064e\u0627 \u0643\u064e\u0627\u0645\u0650\u0644\u064f",latin:"Y\xe2 K\xe2mil",meal:"Ey her bak\u0131mdan eksiksiz olan K\xe2mil,"},{arabic:"\u064a\u064e\u0627 \u0641\u064e\u0627\u0637\u0650\u0631\u064f",latin:"Y\xe2 F\xe2t\u0131r",meal:"Ey mahl\xfbkat\u0131 yokluk karanl\u0131klar\u0131ndan varl\u0131k n\xfbruna \xe7\u0131karan F\xe2t\u0131r,"},{arabic:"\u064a\u064e\u0627 \u0637\u064e\u0627\u0644\u0650\u0628\u064f",latin:"Y\xe2 T\xe2lib",meal:"Ey kullar\u0131 i\xe7in hay\u0131r murat eden ve onlar\u0131 derg\xe2h\u0131na \xe7a\u011f\u0131ran T\xe2lib,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0637\u0652\u0644\u064f\u0648\u0628\u064f",latin:"Y\xe2 Matl\xfbb",meal:"Ey kullar\u0131n\u0131n, r\u0131zas\u0131na ermek ve cemalini g\xf6rmek i\xe7in can att\u0131\u011f\u0131 Matl\xfbb,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:81,title:"Men en\u2019ame bihavlih",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0627\u064e\u0646\u0652\u0639\u064e\u0645\u064e \u0628\u0650\u062d\u064e\u0648\u0652\u0644\u0650\u0647\u0650",latin:"Y\xe2 Men en\u2019ame bihavlih",meal:"Ey g\xfc\xe7 ve havliyle nimet veren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0627\u064e\u0643\u0652\u0631\u064e\u0645\u064e \u0628\u0650\u0637\u064e\u0648\u0652\u0644\u0650\u0647\u0650",latin:"Y\xe2 Men ekrame bitavlih",meal:"Ey geni\u015f ve bol imk\xe2nlar\u0131yla ikram eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0639\u064e\u0627\u062f\u064e \u0628\u0650\u0644\u064f\u0637\u0652\u0641\u0650\u0647\u0650",latin:"Y\xe2 Men \u2018\xe2de bil\xfctf\u0131h",meal:"Ey tekrar tekrar l\xfctufta bulunan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u0639\u064e\u0632\u0651\u064e\u0632\u064e \u0628\u0650\u0642\u064f\u062f\u0652\u0631\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men te\u2019azzeze bikudratih",meal:"Ey kudretiyle her yerde izzetini g\xf6steren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0642\u064e\u062f\u0651\u064e\u0631\u064e \u0628\u0650\u062d\u0650\u0643\u0652\u0645\u064e\u062a\u0650\u0647\u0650",latin:"Y\xe2 Men kaddera bihikmetih",meal:"Ey her \u015feyi hikmetiyle \xf6l\xe7\xfcp bi\xe7en,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062d\u064e\u0643\u064e\u0645\u064e \u0628\u0650\u062a\u064e\u062f\u0652\u0628\u0650\u064a\u0631\u0650\u0647\u0650",latin:"Y\xe2 Men hakeme bitedb\xeerih",meal:"Ey tedb\xeeriyle h\xfckmeden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062f\u064e\u0628\u0651\u064e\u0631\u064e \u0628\u0650\u0639\u0650\u0644\u0652\u0645\u0650\u0647\u0650",latin:"Y\xe2 Men debbera bi\u2019ilmih",meal:"Ey ilmiyle her \u015feyi idare eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062a\u064e\u062c\u064e\u0627\u0648\u064e\u0632\u064e \u0628\u0650\u062d\u0650\u0644\u0652\u0645\u0650\u0647\u0650",latin:"Y\xe2 Men tec\xe2veze bih\u0131lmih",meal:"Ey hilim ve yumu\u015fakl\u0131\u011f\u0131yla kullar\u0131n\u0131 cezaland\u0131rmaktan vazge\xe7en,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062f\u064e\u0646\u064e\u0627 \u0641\u0650\u0649 \u0639\u064f\u0644\u064f\u0648\u0651\u0650\u0647\u0650",latin:"Y\xe2 Men den\xe2 f\xee \u2018ul\xfcvvih",meal:"Ey y\xfcceli\u011fiyle beraber kullar\u0131na yak\u0131n olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0639\u064e\u0644\u0627\u0670 \u0641\u0650\u0649 \u062f\u064f\u0646\u064f\u0648\u0651\u0650\u0647\u0650",latin:"Y\xe2 Men \u2018al\xe2 f\xee d\xfcn\xfcvvih",meal:"Ey yak\u0131nl\u0131\u011f\u0131nda y\xfcceli\u011fi tez\xe2h\xfcr eden,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:82,title:"Meb yahl\xfcku ma ye\u015f\xe2",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u062e\u0652\u0644\u064f\u0642\u064f \u0645\u064e\u0627 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yahl\xfcku ma ye\u015f\xe2",meal:"Ey diledi\u011fini yaratan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0641\u0652\u0639\u064e\u0644\u064f \u0645\u064e\u0627 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yef\u2019al\xfc ma ye\u015f\xe2",meal:"Ey diledi\u011fini yapan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0647\u0652\u062f\u0650\u0649 \u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yehdi men ye\u015f\xe2",meal:"Ey diledi\u011fine hidayet eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yudill\xfc men ye\u015f\xe2",meal:"Ey diledi\u011fini sapt\u0131ran,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u063a\u0652\u0641\u0650\u0631\u064f \u0644\u0650\u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men ya\u011ffiru limen ye\u015f\xe2",meal:"Ey diledi\u011fini ba\u011f\u0131\u015flayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f \u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men y\xfc\u2019azzib\xfc men ye\u015f\xe2",meal:"Ey diledi\u011fine azap eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u062a\u064f\u0648\u0628\u064f \u0639\u064e\u0644\u0670\u0649 \u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Ya Men yet\xfbb\xfc al\xe2 men ye\u015f\xe2",meal:"Ey diledi\u011finin t\xf6vbesini kabul eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064f\u0635\u064e\u0648\u0651\u0650\u0631\u064f \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u062d\u064e\u0627\u0645\u0650 \u0643\u064e\u064a\u0652\u0641\u064e \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men y\xfcsavviru f\u0131\u2019l-erh\xe2mi keyfe ye\u015f\xe2",meal:"Ey anne rahimlerindeki yavrular\u0131 diledi\u011fi gibi \u015fekillendiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u0632\u0650\u064a\u062f\u064f \u0641\u0650\u0649 \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u0650 \u0645\u064e\u0627 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yez\xeed\xfc fi\u2019l-halki m\xe2 ye\u015f\xe2",meal:"Ey yarat\u0131klar\u0131nda diledi\u011fi \u015feyi ziyade k\u0131lan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u064e\u062e\u0652\u062a\u064e\u0635\u0651\u064f \u0628\u0650\u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0647\u0650 \u0645\u064e\u0646\u0652 \u064a\u064e\u0634\u064e\u0653\u0627\u0621\u064f",latin:"Y\xe2 Men yahtassu bi rahmetih\xee men ye\u015f\xe2",meal:"Ey rahmetini diledi\u011fine tahsis eden,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:83,title:"Lem yettehiz sahibeten vel\xe2 veled\xe2",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u062a\u0651\u064e\u062e\u0650\u0630\u0652 \u0635\u064e\u0627\u062d\u0650\u0628\u064e\u0629\u064b \u0648\u064e \u0644\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064b\u0627",latin:"Y\xe2 Men lem yettehiz sahibeten vel\xe2 veled\xe2",meal:"Ey hi\xe7bir e\u015f ve evlat edinmeyen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u0634\u0652\u0631\u0650\u0643\u064f \u0641\u0650\u0649 \u062d\u064f\u0643\u0652\u0645\u0650\u0647\u0653\u0650 \u0627\u064e\u062d\u064e\u062f\u064b\u0627",latin:"Y\xe2 Men la y\xfc\u015frik\xfc f\xee hukmih\xee ehad\xe2",meal:"Ey kimseyi h\xfckm\xfcne ortak k\u0131lmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0642\u064e\u062f\u0652\u0631\u064b\u0627",latin:"Y\xe2 Men ce\u2019ale li k\xfclli \u015fey\u2019in kadr\xe2",meal:"Ey her \u015feye bir plan ve miktar tayin eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u0632\u064e\u0644\u0652 \u0631\u064e\u062d\u0650\u064a\u0645\u064b\u0627",latin:"Y\xe2 Men lem yezel rah\xeem\xe2",meal:"Ey \u015fefkat ve merhameti zeval bulmay\u0131p devam eden,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0627\u0639\u0650\u0644\u064e \u0627\u0644\u0652\u0645\u064e\u0644\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0650 \u0631\u064f\u0633\u064f\u0644\u0627\u064b",latin:"Y\xe2 C\xe2\u2019ile\u2019l-mel\xe2iketi rus\xfcl\xe2",meal:"Ey melekleri el\xe7i k\u0131lan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0653\u0627\u0621\u0650 \u0628\u064f\u0631\u064f\u0648\u062c\u064b\u0627",latin:"Y\xe2 Men ce\u2019ale f\u0131\u2019s-sem\xe2i b\xfcr\xfbc\xe2",meal:"Ey sem\xe2da bur\xe7lar meydana getiren,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0642\u064e\u0631\u064e\u0627\u0631\u064b\u0627",latin:"Y\xe2 Men ce\u2019ale\u2019l-arda kar\xe2ra",meal:"Ey yery\xfcz\xfcn\xfc kararl\u0131 ve bar\u0131nmaya m\xfcsait k\u0131lan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0645\u064e\u0653\u0627\u0621\u0650 \u0628\u064e\u0634\u064e\u0631\u064b\u0627",latin:"Y\xe2 Men ce\u2019ale mine\u2019l-m\xe2i be\u015fer\xe2",meal:"Ey insan\u0131 bir damla sudan yaratan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0627\u064e\u062d\u0652\u0635\u0670\u0649 \u0643\u064f\u0644\u0651\u064e \u0634\u064e\u0649\u0652\u0621\u064d \u0639\u064e\u062f\u064e\u062f\u064b\u0627",latin:"Y\xe2 Men ahsa k\xfclle \u015fey\u2019in \u2018aded\xe2",meal:"Ey her \u015feyi sayarak hesab\u0131n\u0131 yapan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0627\u064e\u062d\u064e\u0627\u0637\u064e \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0639\u0650\u0644\u0652\u0645\u064b\u0627",latin:"Y\xe2 Men eh\xe2ta bi k\xfclli \u015fey\u2019in \u2018ilm\xe2",meal:"Ey her \u015feyi ilmiyle ku\u015fatan,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:84,title:"Ferd ve Vitr",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0641\u064e\u0631\u0652\u062f\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Ferd",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey e\u015fi ve benzeri olmayan Ferd,"},{arabic:"\u064a\u064e\u0627 \u0648\u0650\u062a\u0652\u0631\u064f",latin:"Y\xe2 Vitr",meal:"Ey z\xe2t, s\u0131fat ve fiillerinde \xe7ifti olmayan Vitr,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u062d\u064e\u062f\u064f",latin:"Y\xe2 Ehad",meal:"Ey her bir \u015feyde birli\u011fini g\xf6steren Ehad,"},{arabic:"\u064a\u064e\u0627 \u0635\u064e\u0645\u064e\u062f\u064f",latin:"Y\xe2 Samed",meal:"Ey hi\xe7bir \u015feye muhta\xe7 olmayan ve her \u015feyin kendisine muhta\xe7 oldu\u011fu Samed,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0645\u0652\u062c\u064e\u062f\u064f",latin:"Y\xe2 Emced",meal:"Ey \u015fan, \u015feref ve y\xfcceli\u011fi en b\xfcy\xfck olan Emced,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0639\u064e\u0632\u0651\u064f",latin:"Y\xe2 E\u2019azz",meal:"Ey izzet ve galibiyeti mukayeseye gelmeyen Eazz,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u062c\u064e\u0644\u0651\u064f",latin:"Y\xe2 Eceli",meal:"Ey sonsuz azamet ve cel\xe2l sahibi Ecell,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u062d\u064e\u0642\u0651\u064f",latin:"Y\xe2 Ehakk",meal:"Ey b\xfct\xfcn ger\xe7eklerden daha ger\xe7ek ve ib\xe2dete en \xe7ok l\xe2y\u0131k olan Ehakk,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0628\u064e\u0631\u0651\u064f",latin:"Y\xe2 Eberr",meal:"Ey herkesten fazla iyilik yapan Eberr,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0628\u064e\u062f\u064f",latin:"Y\xe2 Ebed",meal:"Ey varl\u0131\u011f\u0131n\u0131n sonu olmayan Ebed,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-nel-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:85,title:"Ma\u2019r\xfbfe men \u2018arafeh",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0639\u0652\u0631\u064f\u0648\u0641\u064e \u0645\u064e\u0646\u0652 \u0639\u064e\u0631\u064e\u0641\u064e\u0647\u064f",latin:"Y\xe2 Ma\u2019r\xfbfe men \u2018arafeh",meal:"Ey Kendisini tan\u0131mak isteyenlerin m\xe2rufu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0639\u0652\u0628\u064f\u0648\u062f\u064e \u0645\u064e\u0646\u0652 \u0639\u064e\u0628\u064e\u062f\u064e\u0647\u064f",latin:"Y\xe2 Ma\u2019b\xfbde men \u2018abedeh",meal:"Ey Kendisine ib\xe2det edenlerin m\xe2budu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0634\u0652\u0643\u064f\u0648\u0631\u064e \u0645\u064e\u0646\u0652 \u0634\u064e\u0643\u064e\u0631\u064e\u0647\u064f",latin:"Y\xe2 Me\u015fk\xfbre men \u015fekerah",meal:"Ey Kendisine \u015f\xfckredenlerin me\u015fk\xfbru,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0630\u0652\u0643\u064f\u0648\u0631\u064e \u0645\u064e\u0646\u0652 \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f",latin:"Y\xe2 Mezk\xfbre men zekerah",meal:"Ey Kendisini zikredenlerin mezk\xfbru,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u062d\u0652\u0645\u064f\u0648\u062f\u064e \u0645\u064e\u0646\u0652 \u062d\u064e\u0645\u0650\u062f\u064e\u0647\u064f",latin:"Y\xe2 Mahmude men hamideh",meal:"Ey Kendisini \xf6venlerin mahm\xfbdu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0648\u0652\u062c\u064f\u0648\u062f\u064e \u0645\u064e\u0646\u0652 \u0637\u064e\u0644\u064e\u0628\u064e\u0647\u064f",latin:"Y\xe2 Mevc\xfbde men talebeh",meal:"Ey Kendisini arayanlar i\xe7in mevcut olan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0648\u0652\u0635\u064f\u0648\u0641\u064e \u0645\u064e\u0646\u0652 \u0648\u064e\u062d\u0651\u064e\u062f\u064e\u0647\u064f",latin:"Y\xe2 Mevs\xfbfe men vahhadeh",meal:"Ey Kendisini bir tan\u0131yanlar\u0131n mevs\xfbfu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u062d\u0652\u0628\u064f\u0648\u0628\u064e \u0645\u064e\u0646\u0652 \u0627\u064e\u062d\u064e\u0628\u0651\u064e\u0647\u064f",latin:"Y\xe2 Mahb\xfbbe men ehabbeh",meal:"Ey Kendisini sevenlerin sevgilisi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0631\u0652\u063a\u064f\u0648\u0628\u064e \u0645\u064e\u0646\u0652 \u0627\u064e\u0631\u064e\u0627\u062f\u064e\u0647\u064f",latin:"Y\xe2 Mer\u011f\xfbbe men er\xe2deh",meal:"Ey Kendisini arzulayanlar\u0131n mer\u011fubu,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0642\u0652\u0635\u064f\u0648\u062f\u064e \u0645\u064e\u0646\u0652 \u0627\u064e\u0646\u064e\u0627\u0628\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650",latin:"Y\xe2 Maks\xfbde men en\xe2be ileyh",meal:"Ey derg\xe2h\u0131na d\xf6nenlerin maksudu,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:86,title:"Men l\xe2 m\xfclke ill\xe2 m\xfclk\xfch",lines:[{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u0645\u064f\u0644\u0652\u0643\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0645\u064f\u0644\u0652\u0643\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 m\xfclke ill\xe2 m\xfclk\xfch",meal:"Ey saltanat\u0131ndan ba\u015fka ger\xe7ek saltanat olmayan,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062d\u0652\u0635\u0650\u0649 \u0627\u0644\u0652\u0639\u0650\u0628\u064e\u0627\u062f\u064f \u062b\u064e\u0646\u064e\u0653\u0627\u0626\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yuhsi\u2019l-\u2018ibad\xfc senaeh",meal:"Ey kullar\u0131n sen\xe2s\u0131n\u0131 saymakla bitiremedi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u062a\u064e\u0635\u0650\u0641\u064f \u0627\u0644\u0652\u062e\u064e\u0644\u064e\u0653\u0627\u0626\u0650\u0642\u064f \u062c\u064e\u0644\u064e\u0627\u0644\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 tes\u0131f\xfc\u2019l-hal\xe2iku cel\xe2leh",meal:"Ey mahl\xfbkat\u0131n cel\xe2lini vasfedemedi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062f\u0652\u0631\u0650\u0643\u064f \u0627\u0644\u0652\u0627\u064e\u0628\u0652\u0635\u064e\u0627\u0631\u064f \u0643\u064e\u0645\u064e\u0627\u0644\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yudrik\xfc\u2019l-ebs\xe2ru kem\xe2leh",meal:"Ey g\xf6zlerin kem\xe2lini idrak ve ih\xe2ta edemedi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0628\u0652\u0644\u064f\u063a\u064f \u0627\u0644\u0652\u0627\u064e\u0641\u0652\u0647\u064e\u0627\u0645\u064f \u0635\u0650\u0641\u064e\u0627\u062a\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yebl\xfc\u011fu\u2019l-efh\xe2m\xfc s\u0131f\xe2tih",meal:"Ey zek\xe2lar\u0131n s\u0131fatlar\u0131na ula\u015fmakta acze d\xfc\u015ft\xfc\u011f\xfc,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0646\u064e\u0627\u0644\u064f \u0627\u0644\u0652\u0627\u064e\u0641\u0652\u0643\u064e\u0627\u0631\u064f \u0643\u0650\u0628\u0652\u0631\u0650\u064a\u064e\u0653\u0627\u0626\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yen\xe2l\xfc\u2019l-efk\xe2ru kibriy\xe2eh",meal:"Ey fikirlerin, kibriyas\u0131n\u0131n hakikatine ula\u015famad\u0131\u011f\u0131,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064f\u062d\u0652\u0633\u0650\u0646\u064f \u0627\u0652\u0644\u0627\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u064f \u0646\u064f\u0639\u064f\u0648\u062a\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yuhsin\xfc\u2019l-ins\xe2n\xfc n\xfc\u2019\xfbteh",meal:"Ey insanlar\u0131n, s\u0131fatlar\u0131n\u0131 g\xfczelce tavsif edemedi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u064f\u062f\u0651\u064f \u0627\u0644\u0652\u0639\u0650\u0628\u064e\u0627\u062f\u064f \u0642\u064e\u0636\u064e\u0653\u0627\u0626\u064e\u0647\u064f",latin:"Y\xe2 Men l\xe2 yerudd\xfc\u2019l-\u2018ib\xe2d\xfc kad\xe2eh",meal:"Ey kullar\u0131n, h\xfckm\xfcn\xfc geri \xe7eviremedi\u011fi,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0638\u064e\u0647\u064e\u0631\u064e \u0641\u0650\u0649 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u0649\u0652\u0621\u064d \u0627\u0670\u064a\u064e\u0627\u062a\u064f\u0647\u064f",latin:"Y\xe2 Men zahera f\xee k\xfclli \u015fey\u2019in \xe2y\xe2t\xfch",meal:"Ey her \u015feyde Kendisini tan\u0131tan deliller a\xe7\u0131k\xe7a g\xf6r\xfclen,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0646\u0652 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0627\u0644\u0652\u063a\u064e\u064a\u0652\u0628\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e",latin:"Y\xe2 Men l\xe2 ya\u2019lem\xfc\u2019l-\u011faybe ill\xe2 h\xfb",meal:"Ey gayb\u0131 Kendisinden ba\u015fka kimse bilemeyen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r.",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:87,title:"Hab\xeebe\u2019l-bekk\xe2\xeen",lines:[{arabic:"\u064a\u064e\u0627 \u062d\u064e\u0628\u0650\u064a\u0628\u064e \u0627\u0644\u0652\u0628\u064e\u0643\u0651\u064e\u0653\u0627\u0626\u0650\u064a\u0646\u064e",latin:"Y\xe2 Hab\xeebe\u2019l-bekk\xe2\xeen",meal:"Ey g\xfcnahlar\u0131 i\xe7in ve kendisine olan a\u015fk ve muhabbetten dolay\u0131 a\u011flayanlar\u0131n sevgilisi,"},{arabic:"\u064a\u064e\u0627 \u0633\u064e\u0646\u064e\u062f\u064e \u0627\u0644\u0652\u0645\u064f\u062a\u064e\u0648\u064e\u0643\u0651\u0650\u0644\u0650\u064a\u0646\u064e",latin:"Y\xe2 Senede\u2019l-m\xfctevekkil\xeen",meal:"Ey kendisine tevekk\xfcl edenlerin dayana\u011f\u0131,"},{arabic:"\u064a\u064e\u0627 \u0647\u064e\u0627\u062f\u0650\u0649\u064e \u0627\u0644\u0652\u0645\u064f\u0636\u0650\u0644\u0651\u0650\u064a\u0646\u064e",latin:"Y\xe2 H\xe2diye\u2019l-mudill\xeen",meal:"Ey hak yoldan sapanlar\u0131 hidayete erdiren,"},{arabic:"\u064a\u064e\u0627 \u0648\u064e\u0644\u0650\u0649\u0651\u064e \u0627\u0644\u0652\u0645\u064f\u0648\u0654\u0652\u0645\u0650\u0646\u0650\u064a\u0646\u064e",latin:"Y\xe2 Veliyye\u2019l-m\xfc\u2019min\xeen",meal:"Ey m\xfcminlerin dost ve sahibi,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0646\u0650\u064a\u0633\u064e \u0627\u0644\u0630\u0651\u064e\u0627\u0643\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 En\xeese\u2019z-z\xe2kir\xeen",meal:"Ey kendisini zikredenlerin can yolda\u015f\u0131,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0642\u0652\u062f\u064e\u0631\u064e \u0627\u0644\u0652\u0642\u064e\u0627\u062f\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Akdera\u2019l-k\xe2dir\xeen",meal:"Ey b\xfct\xfcn g\xfc\xe7l\xfclerden daha g\xfc\xe7l\xfc,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0628\u0652\u0635\u064e\u0631\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0638\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Ebsara\u2019n-n\xe2z\u0131r\xeen",meal:"Ey b\xfct\xfcn bakanlardan daha iyi g\xf6ren,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0639\u0652\u0644\u064e\u0645\u064e \u0627\u0644\u0652\u0639\u064e\u0627\u0644\u0650\u0645\u0650\u064a\u0646\u064e",latin:"Y\xe2 Aleme\u2019l-\u2018\xe2lim\xeen",meal:"Ey b\xfct\xfcn ilim sahiplerinden daha \xe2lim,"},{arabic:"\u064a\u064e\u0627 \u0645\u064e\u0641\u0652\u0632\u064e\u0639\u064e \u0627\u0644\u0652\u0645\u064e\u0644\u0652\u0647\u064f\u0648\u0641\u0650\u064a\u0646\u064e",latin:"Y\xe2 Mefze\u2019a\u2019l-melh\xfbf\xeen",meal:"Ey kederli b\xee\xe7arelerin ka\xe7\u0131p s\u0131\u011f\u0131nd\u0131\u011f\u0131,"},{arabic:"\u064a\u064e\u0653\u0627 \u0627\u064e\u0646\u0652\u0635\u064e\u0631\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0635\u0650\u0631\u0650\u064a\u0646\u064e",latin:"Y\xe2 Ensara\u2019n-n\xe2sir\xeen",meal:"Ey b\xfct\xfcn yard\u0131m edenlerden daha \xe7ok yard\u0131m eden,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0645\u064e\u0627\u0646\u064e \u0646\u064e\u062c\u0651\u0650\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650",latin:"S\xfcbh\xe2neke y\xe2 l\xe2 ilahe ill\xe2 ente\u2019l-em\xe2-ne\u2019l-em\xe2ne neccin\xe2 mine\u2019n-n\xe2r",meal:"B\xfct\xfcn kusurlardan m\xfcnezzehsin, Senden ba\u015fka il\xe2h yok! Em\xe2n ver bize. Bizi Cehennemden kurtar."}},{id:88,title:"M\xfckrim ve Muazz\u0131m",lines:[{arabic:"\u0648\u064e \u0627\u064e\u0633\u0652\u0626\u064e\u0644\u064f\u0643\u064e \u0628\u0650\u0627\u064e\u0633\u0652\u0645\u064e\u0653\u0627\u0626\u0650\u0643\u064e \u064a\u064e\u0627 \u0645\u064f\u0643\u0652\u0631\u0650\u0645\u064f",latin:"Ve es\u2019el\xfcke biesm\xe2ike Y\xe2 Mukrim",meal:"Allah\u2019\u0131m! Senden \u015fu isimlerinin hakk\u0131 i\xe7in istiyor ve yalvar\u0131yorum:Ey ger\xe7ek ikram sahibi M\xfckrim,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0639\u064e\u0638\u0651\u0650\u0645\u064f",latin:"Y\xe2 Mu\u2019azzim",meal:"Ey diledi\u011fini b\xfcy\xfcten ve eserleriyle b\xfcy\xfckl\xfc\u011f\xfcn\xfc g\xf6steren Muazz\u0131m,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0646\u064e\u0639\u0650\u0651\u0645\u064f",latin:"Y\xe2 Muna\u2019im",meal:"Ey mahl\xfbkat\u0131n\u0131 \xe7e\u015fit \xe7e\u015fit nimetlere gark eden M\xfcna\u2019\u0131m,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0639\u0652\u0637\u0650\u0649",latin:"Y\xe2 M\xfc\u2019t\xee",meal:"Ey mahl\xfbkat\u0131na l\xe2z\u0131m olan her \u015feyi veren Mu\u2019ti,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u063a\u0652\u0646\u0650\u0649",latin:"Y\xe2 Mu\u011fn\xee",meal:"Ey mahl\xfbkat\u0131n\u0131n ihtiyac\u0131n\u0131 giderip zengin k\u0131lan Mu\u011fn\xee,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u062d\u0652\u064a\u0650\u0649",latin:"Y\xe2 Muhy\xee",meal:"Ey canl\u0131lara hayat veren Muhy\xee,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0628\u0652\u062f\u0650\u0649\u0654\u064f",latin:"Y\xe2 Mubd\xee",meal:"Ey mahl\xfbkat\u0131 maddesiz ve \xf6rneksiz ilk defa yaratan M\xfcbd\xee,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0631\u0652\u0636\u0650\u0649",latin:"Y\xe2 Murd\xee",meal:"Ey mahl\xfbkat\u0131n\u0131 nimetleriyle ho\u015fnut k\u0131lan Murz\xee,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u0646\u0652\u062c\u0650\u0649",latin:"Y\xe2 Munc\xee",meal:"Ey mahl\xfbkat\u0131 her t\xfcrl\xfc tehlikeden kurtaran M\xfcnc\xee,"},{arabic:"\u064a\u064e\u0627 \u0645\u064f\u062d\u0652\u0633\u0650\u0646\u064f",latin:"Y\xe2 Muhsin",meal:"Ey bol bol iyilikte bulunan Muhs\xeen,"}],munacaat:{arabic:"\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e\u0643\u064e \u064a\u064e\u0627 \u0644\u064e\u0653\u0627 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0653 \u0627\u064e\u